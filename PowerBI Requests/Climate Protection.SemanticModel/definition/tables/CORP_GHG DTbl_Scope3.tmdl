			            RANKX(ALL('Unique scope3 EV PRO Segment'[PRO_Segment]), [Actual Emission], , ASC)
			            ),                                                                                                                          IF( IsPROSubcategory,
			        IF(TopBottomValue = "Top",
			            RANKX(ALL('Unique scope3 EV PRO PRO Subcategory'[PRO_Subcategory]), [Actual Emission], , DESC),
