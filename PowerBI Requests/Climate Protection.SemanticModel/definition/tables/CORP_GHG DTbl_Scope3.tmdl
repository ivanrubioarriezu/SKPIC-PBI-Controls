	measure 'color ACT Vs PY Color' = ```
			
			/*IF(
			    [ACT Vs PY  %] <= 0,
			    "#008000",   -- Green
			    "#FF0000"    -- Red
			)*/
			
			
			VAR _Pct = ROUND([ACT Vs PY  %], 4)
			
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(_Pct), BLANK(),
			    _Pct <= 0, "#008000",   -- Green (Negative or Zero)
			    "#FF0000"               -- Red (Positive)
			)
			
			```
		lineageTag: a5bd0556-cb14-4f57-9f36-7f3d54050ce9

