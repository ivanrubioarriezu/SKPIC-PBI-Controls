	measure 'Ranking by Actual Emission PRO' =
			
			VAR _topCategory =SWITCH(TRUE(),SELECTEDVALUE('ViewBy Pro'[ViewBy Pro Fields])= "'CORP_GHG DTbl_Scope3'[Country]",RANKX(ALLSELECTED('CORP_GHG DTbl_Scope3'[Country]),[Actual Emission],,DESC),
			SELECTEDVALUE('ViewBy Pro'[ViewBy Pro Fields])= "'CORP_GHG DTbl_Scope3'[Business_unit]",RANKX(ALLSELECTED('CORP_GHG DTbl_Scope3'[Business_unit]),[Actual Emission],,DESC),
			SELECTEDVALUE('ViewBy Pro'[ViewBy Pro Fields])= "'CORP_GHG DTbl_Scope3'[PRO_Area]",RANKX(ALLSELECTED('CORP_GHG DTbl_Scope3'[PRO_Area]),[Actual Emission],,DESC),
			SELECTEDVALUE('ViewBy Pro'[ViewBy Pro Fields])= "'CORP_GHG DTbl_Scope3'[PRO_Segment]",RANKX(ALLSELECTED('CORP_GHG DTbl_Scope3'[PRO_Segment]),[Actual Emission],,DESC),
			SELECTEDVALUE('ViewBy Pro'[ViewBy Pro Fields])= "'CORP_GHG DTbl_Scope3'[PRO_Category]",RANKX(ALLSELECTED('CORP_GHG DTbl_Scope3'[PRO_Category]),[Actual Emission],,DESC),
			SELECTEDVALUE('ViewBy Pro'[ViewBy Pro Fields])= "'CORP_GHG DTbl_Scope3'[PRO_Subcategory]",RANKX(ALLSELECTED('CORP_GHG DTbl_Scope3'[PRO_Subcategory]),[Actual Emission],,DESC))
			VAR _bottomCategory=SWITCH(TRUE(),SELECTEDVALUE('ViewBy Pro'[ViewBy Pro Fields])= "'CORP_GHG DTbl_Scope3'[Country]",RANKX(ALLSELECTED('CORP_GHG DTbl_Scope3'[Country]),[Actual Emission],,ASC),
			SELECTEDVALUE('ViewBy Pro'[ViewBy Pro Fields])= "'CORP_GHG DTbl_Scope3'[Business_unit]",RANKX(ALLSELECTED('CORP_GHG DTbl_Scope3'[Business_unit]),[Actual Emission],,ASC),
