	measure 'ACT Vs Baseline %' = ```
			
			 
			 --DIVIDE([Actual Emission] - [Actual BY Emission],[Actual BY Emission])
			
			
			SWITCH(
			    TRUE(),
			
			    -- Country level
			    ISINSCOPE('CORP_GHG DTbl_Scope3'[Country]),
			        DIVIDE(
			            [Actual Emission] - [Actual BY Emission],
			            [Actual BY Emission]
			        ),
			
			    -- Business Unit level
			    ISINSCOPE('CORP_GHG DTbl_Scope3'[Business_unit]),
			        DIVIDE(
			            [Actual Emission] - [Actual BY Emission],
			            [Actual BY Emission]
			        ),
			
			    -- Category level (default)
			        DIVIDE(
			            [Actual Emission] - [Actual BY Emission],
			            [Actual BY Emission]
			        )
			)
			
			
			
			
			```
		formatString: 0%;-0%;0%
		lineageTag: 7d29359f-3fe7-4431-80f6-3f5a2c2c90e8

