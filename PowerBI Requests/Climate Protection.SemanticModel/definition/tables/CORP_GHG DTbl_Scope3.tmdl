			        IF(IsPROSegment, COUNTROWS(ALL('Unique scope3 EV PRO Segment'[PRO_Segment])),
			        IF(IsPROSubcategory, COUNTROWS(ALL('Unique scope3 EV PRO PRO Subcategory'[PRO_Subcategory])))
			    )))))
			
			
			
			
			
			
			
			
			//Calculate Others total dynamically
			VAR OthersEmission =
			    IF(
			        IsCategory,
