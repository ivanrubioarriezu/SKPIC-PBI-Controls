			SELECTEDVALUE('ViewBy Pro'[ViewBy Pro Fields])= "'CORP_GHG DTbl_Scope3'[PRO_Segment]",RANKX(ALLSELECTED('CORP_GHG DTbl_Scope3'[PRO_Segment]),[Actual Emission],,ASC),
			SELECTEDVALUE('ViewBy Pro'[ViewBy Pro Fields])= "'CORP_GHG DTbl_Scope3'[PRO_Category]",RANKX(ALLSELECTED('CORP_GHG DTbl_Scope3'[PRO_Category]),[Actual Emission],,ASC),
			SELECTEDVALUE('ViewBy Pro'[ViewBy Pro Fields])= "'CORP_GHG DTbl_Scope3'[PRO_Subcategory]",RANKX(ALLSELECTED('CORP_GHG DTbl_Scope3'[PRO_Subcategory]),[Actual Emission],,ASC))
