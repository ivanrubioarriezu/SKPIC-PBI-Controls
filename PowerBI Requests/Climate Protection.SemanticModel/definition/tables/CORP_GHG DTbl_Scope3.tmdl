			                        RANKX(ALLSELECTED('Unique scope3 EV PRO PRO Subcategory'[PRO_Subcategory]), [Actual Emission], ,ASC)
			                        )
			
			
			
			            )
			        )
			    ))))
			
			--------------------------------------------------
			-- ✅ OTHERS CALCULATION
			--------------------------------------------------
			VAR OthersEmission =
			    IF(
			        IsCategory,
			        CALCULATE(
