		lineageTag: 063fcec7-4326-47cb-9de4-fd728e77722a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ranking by Actual PY Emission PRO' = ```
			
			VAR TopBottomValue = SELECTEDVALUE('Top/Bottom'[Value])
			VAR RankingLimit = SELECTEDVALUE('Ranking Option'[Ranking Option])
			VAR ViewBySelection = SELECTEDVALUE('ViewBy Pro'[ViewBy Pro Fields])
			
			
			VAR IsCategory = CONTAINSSTRING(ViewBySelection, "PRO Category")
			VAR IsCountry = CONTAINSSTRING(ViewBySelection, "Country")
			VAR IsBusinessUnit = CONTAINSSTRING(ViewBySelection, "Business unit")
			VAR IsPROArea = CONTAINSSTRING(ViewBySelection, "PRO Area")
			VAR IsPROSegment = CONTAINSSTRING(ViewBySelection, "PRO Segment")
			VAR IsPROSubcategory = CONTAINSSTRING(ViewBySelection, "PRO Subcategory")
			
			VAR IsOthers =
			    (IsCategory && SELECTEDVALUE('Unique scope3 EV PRO Category'[PRO_Category]) = "Others") ||
			    (IsCountry && SELECTEDVALUE('Unique Country scope3'[Country]) = "Others") ||
			    (IsBusinessUnit && SELECTEDVALUE('Unique Business unit scope3'[Business_unit]) = "Others")||
			    (IsPROArea && SELECTEDVALUE('Unique scope3 EV PRO Area'[PRO_Area])= "Others")||
			    (IsPROSegment && SELECTEDVALUE('Unique scope3 EV PRO Segment'[PRO_Segment])="Others")||
			    (IsPROSubcategory && SELECTEDVALUE('Unique scope3 EV PRO PRO Subcategory'[PRO_Subcategory])="Others")
			
			--------------------------------------------------
			-- ✅ CURRENT RANK (Others always last)
			--------------------------------------------------
			VAR CurrentRank =
			    IF(
			        IsOthers,
			        999999999999999999999999999,
			        IF(
			            IsCategory,
			            IF(
			                TopBottomValue = "Top",
			                RANKX(ALLSELECTED('Unique scope3 EV PRO Category'[PRO_Category]), [Actual PY Emission], , DESC),
			                RANKX(ALLSELECTED('Unique scope3 EV PRO Category'[PRO_Category]), [Actual PY Emission], , ASC)
			            ),
			            IF(
			                IsCountry,
			                IF(
			                    TopBottomValue = "Top",
			                    RANKX(ALLSELECTED('Unique Country scope3'[Country]), [Actual PY Emission], , DESC),
			                    RANKX(ALLSELECTED('Unique Country scope3'[Country]), [Actual PY Emission], , ASC)
			                ),
			                IF(
			                IsBusinessUnit,
			                IF(
			                    TopBottomValue = "Top",
			                    RANKX(ALLSELECTED('Unique Business unit scope3'[Business_unit]), [Actual PY Emission], , DESC),
			                    RANKX(ALLSELECTED('Unique Business unit scope3'[Business_unit]), [Actual PY Emission], , ASC)
			                ),
			            
			
			                IF(
			                    IsPROArea,
			                    IF(
			                        TopBottomValue="Top",
			                        RANKX(ALLSELECTED('Unique scope3 EV PRO Area'[PRO_Area]), [Actual PY Emission], ,DESC),
			                        RANKX(ALLSELECTED('Unique scope3 EV PRO Area'[PRO_Area]), [Actual PY Emission], ,ASC)
			                        ),
			                IF(
			                    IsPROSegment,
			                            IF(
			                               TopBottomValue="Top",
			                        RANKX(ALLSELECTED('Unique scope3 EV PRO Segment'[PRO_Segment]), [Actual PY Emission], ,DESC),
			                        RANKX(ALLSELECTED('Unique scope3 EV PRO Segment'[PRO_Segment]), [Actual PY Emission], ,ASC)
			                        ), 
			             
			                                IF(
			                               TopBottomValue="Top",
			                        RANKX(ALLSELECTED('Unique scope3 EV PRO PRO Subcategory'[PRO_Subcategory]), [Actual PY Emission], ,DESC),
			                        RANKX(ALLSELECTED('Unique scope3 EV PRO PRO Subcategory'[PRO_Subcategory]), [Actual PY Emission], ,ASC)
			                        )
			
			
			
			            )
			        )
			    ))))
			
			--------------------------------------------------
			-- ✅ OTHERS CALCULATION
			--------------------------------------------------
			VAR OthersEmission =
			    IF(
			        IsCategory,
			        CALCULATE(
			            [Actual PY Emission],
			            FILTER(
			                ALL('Unique scope3 EV PRO Category'),
			                IF(
			                    TopBottomValue = "Top",
			                    RANKX(ALLSELECTED('Unique scope3 EV PRO Category'[PRO_Category]), [Actual PY Emission], , DESC) > RankingLimit,
			                    RANKX(ALLSELECTED('Unique scope3 EV PRO Category'[PRO_Category]), [Actual PY Emission], , ASC) > RankingLimit
			                )
			            )
			        ),
			        IF(
			            IsCountry,
			            CALCULATE(
			                [Actual PY Emission],
			                FILTER(
			                    ALL('Unique Country scope3'),
			                    IF(
			                        TopBottomValue = "Top",
			                        RANKX(ALL('Unique Country scope3'[Country]), [Actual PY Emission], , DESC) > RankingLimit,
			                        RANKX(ALL('Unique Country scope3'[Country]), [Actual PY Emission], , ASC) > RankingLimit
			                    )
			                )
			            ),
			             IF(
			            IsBusinessUnit,
			            CALCULATE(
			                [Actual PY Emission],
			                FILTER(
			                    ALL('Unique Business unit scope3'),
			                    IF(
			                        TopBottomValue = "Top",
			                        RANKX(ALL('Unique Business unit scope3'[Business_unit]), [Actual PY Emission], , DESC) > RankingLimit,
			                        RANKX(ALL('Unique Business unit scope3'[Business_unit]), [Actual PY Emission], , ASC) > RankingLimit
			                    )
			                )
			            ),
			              IF(
			        IsPROArea,
			        CALCULATE(
			            [Actual PY Emission],
			            FILTER(
			                ALL('Unique scope3 EV PRO Area'),
			                IF(
			                    TopBottomValue = "Top",
			                    RANKX(ALLSELECTED('Unique scope3 EV PRO Area'[PRO_Area]), [Actual PY Emission], , DESC) > RankingLimit,
			                    RANKX(ALLSELECTED('Unique scope3 EV PRO Area'[PRO_Area]), [Actual PY Emission], , ASC) > RankingLimit
			                )
			            )
			        ),
			         IF(
			        IsPROSegment,
			        CALCULATE(
			            [Actual PY Emission],
			            FILTER(
			                ALL('Unique scope3 EV PRO Segment'),
			                IF(
			                    TopBottomValue = "Top",
			                    RANKX(ALLSELECTED('Unique scope3 EV PRO Segment'[PRO_Segment]), [Actual PY Emission], , DESC) > RankingLimit,
			                    RANKX(ALLSELECTED('Unique scope3 EV PRO Segment'[PRO_Segment]), [Actual PY Emission], , ASC) > RankingLimit
			                )
			            )
			        ),
			        CALCULATE(
			            [Actual PY Emission],
			            FILTER(
			                ALL('Unique scope3 EV PRO PRO Subcategory'),
			                IF(
			                    TopBottomValue = "Top",
			                    RANKX(ALLSELECTED('Unique scope3 EV PRO PRO Subcategory'[PRO_Subcategory]), [Actual PY Emission], , DESC) > RankingLimit,
			                    RANKX(ALLSELECTED('Unique scope3 EV PRO PRO Subcategory'[PRO_Subcategory]), [Actual PY Emission], , ASC) > RankingLimit
			                )
			            )
			        )
			
			                )
			            )
			        )
			    )
			    )
			--------------------------------------------------
			-- ✅ FINAL OUTPUT
			--------------------------------------------------
			RETURN
			IF(
			    IsOthers,
			    OthersEmission,
			    IF(
			        TopBottomValue = "Top",
			        IF(CurrentRank <= RankingLimit, [Actual PY Emission], BLANK()),
			        IF(CurrentRank <= RankingLimit, [Actual PY Emission], BLANK())
			    )
			)
			```
		lineageTag: a5cff32b-a3df-408b-97a8-2840f1be7e3d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ranking by Actual BY Emission PRO' = ```
			
			VAR TopBottomValue = SELECTEDVALUE('Top/Bottom'[Value])
			VAR RankingLimit = SELECTEDVALUE('Ranking Option'[Ranking Option])
			VAR ViewBySelection = SELECTEDVALUE('ViewBy Pro'[ViewBy Pro Fields])
			
			
			VAR IsCategory = CONTAINSSTRING(ViewBySelection, "PRO Category")
			VAR IsCountry = CONTAINSSTRING(ViewBySelection, "Country")
			VAR IsBusinessUnit = CONTAINSSTRING(ViewBySelection, "Business unit")
			VAR IsPROArea = CONTAINSSTRING(ViewBySelection, "PRO Area")
			VAR IsPROSegment = CONTAINSSTRING(ViewBySelection, "PRO Segment")
			VAR IsPROSubcategory = CONTAINSSTRING(ViewBySelection, "PRO Subcategory")
			
			VAR IsOthers =
			    (IsCategory && SELECTEDVALUE('Unique scope3 EV PRO Category'[PRO_Category]) = "Others") ||
			    (IsCountry && SELECTEDVALUE('Unique Country scope3'[Country]) = "Others") ||
			    (IsBusinessUnit && SELECTEDVALUE('Unique Business unit scope3'[Business_unit]) = "Others")||
			    (IsPROArea && SELECTEDVALUE('Unique scope3 EV PRO Area'[PRO_Area])= "Others")||
			    (IsPROSegment && SELECTEDVALUE('Unique scope3 EV PRO Segment'[PRO_Segment])="Others")||
			    (IsPROSubcategory && SELECTEDVALUE('Unique scope3 EV PRO PRO Subcategory'[PRO_Subcategory])="Others")
			
			--------------------------------------------------
			-- ✅ CURRENT RANK (Others always last)
			--------------------------------------------------
			VAR CurrentRank =
			    IF(
			        IsOthers,
			        999999999999999999999999999,
			        IF(
			            IsCategory,
			            IF(
			                TopBottomValue = "Top",
			                RANKX(ALLSELECTED('Unique scope3 EV PRO Category'[PRO_Category]), [Actual BY Emission], , DESC),
			                RANKX(ALLSELECTED('Unique scope3 EV PRO Category'[PRO_Category]), [Actual BY Emission], , ASC)
			            ),
			            IF(
			                IsCountry,
			                IF(
			                    TopBottomValue = "Top",
			                    RANKX(ALLSELECTED('Unique Country scope3'[Country]), [Actual BY Emission], , DESC),
			                    RANKX(ALLSELECTED('Unique Country scope3'[Country]), [Actual BY Emission], , ASC)
			                ),
			                IF(
			                IsBusinessUnit,
			                IF(
			                    TopBottomValue = "Top",
			                    RANKX(ALLSELECTED('Unique Business unit scope3'[Business_unit]), [Actual BY Emission], , DESC),
			                    RANKX(ALLSELECTED('Unique Business unit scope3'[Business_unit]), [Actual BY Emission], , ASC)
			                ),
			            
			
			                IF(
			                    IsPROArea,
			                    IF(
			                        TopBottomValue="Top",
			                        RANKX(ALLSELECTED('Unique scope3 EV PRO Area'[PRO_Area]), [Actual BY Emission], ,DESC),
			                        RANKX(ALLSELECTED('Unique scope3 EV PRO Area'[PRO_Area]), [Actual BY Emission], ,ASC)
			                        ),
			                IF(
			                    IsPROSegment,
			                            IF(
			                               TopBottomValue="Top",
			                        RANKX(ALLSELECTED('Unique scope3 EV PRO Segment'[PRO_Segment]), [Actual BY Emission], ,DESC),
			                        RANKX(ALLSELECTED('Unique scope3 EV PRO Segment'[PRO_Segment]), [Actual BY Emission], ,ASC)
			                        ), 
			             
			                                IF(
			                               TopBottomValue="Top",
			                        RANKX(ALLSELECTED('Unique scope3 EV PRO PRO Subcategory'[PRO_Subcategory]), [Actual BY Emission], ,DESC),
			                        RANKX(ALLSELECTED('Unique scope3 EV PRO PRO Subcategory'[PRO_Subcategory]), [Actual BY Emission], ,ASC)
			                        )
			
			
			
			            )
			        )
			    ))))
			
			--------------------------------------------------
			-- ✅ OTHERS CALCULATION
			--------------------------------------------------
			VAR OthersEmission =
			    IF(
			        IsCategory,
			        CALCULATE(
			            [Actual BY Emission],
			            FILTER(
			                ALL('Unique scope3 EV PRO Category'),
			                IF(
			                    TopBottomValue = "Top",
			                    RANKX(ALLSELECTED('Unique scope3 EV PRO Category'[PRO_Category]), [Actual BY Emission], , DESC) > RankingLimit,
			                    RANKX(ALLSELECTED('Unique scope3 EV PRO Category'[PRO_Category]), [Actual BY Emission], , ASC) > RankingLimit
			                )
			            )
			        ),
			        IF(
			            IsCountry,
			            CALCULATE(
			                [Actual BY Emission],
			                FILTER(
			                    ALL('Unique Country scope3'),
			                    IF(
			                        TopBottomValue = "Top",
			                        RANKX(ALL('Unique Country scope3'[Country]), [Actual BY Emission], , DESC) > RankingLimit,
			                        RANKX(ALL('Unique Country scope3'[Country]), [Actual BY Emission], , ASC) > RankingLimit
			                    )
			                )
			            ),
			             IF(
			            IsBusinessUnit,
			            CALCULATE(
			                [Actual BY Emission],
			                FILTER(
			                    ALL('Unique Business unit scope3'),
			                    IF(
			                        TopBottomValue = "Top",
			                        RANKX(ALL('Unique Business unit scope3'[Business_unit]), [Actual BY Emission], , DESC) > RankingLimit,
			                        RANKX(ALL('Unique Business unit scope3'[Business_unit]), [Actual BY Emission], , ASC) > RankingLimit
			                    )
			                )
			            ),
			              IF(
			        IsPROArea,
			        CALCULATE(
			            [Actual BY Emission],
			            FILTER(
			                ALL('Unique scope3 EV PRO Area'),
			                IF(
			                    TopBottomValue = "Top",
			                    RANKX(ALLSELECTED('Unique scope3 EV PRO Area'[PRO_Area]), [Actual BY Emission], , DESC) > RankingLimit,
			                    RANKX(ALLSELECTED('Unique scope3 EV PRO Area'[PRO_Area]), [Actual BY Emission], , ASC) > RankingLimit
			                )
			            )
			        ),
			         IF(
			        IsPROSegment,
			        CALCULATE(
			            [Actual BY Emission],
			            FILTER(
			                ALL('Unique scope3 EV PRO Segment'),
			                IF(
			                    TopBottomValue = "Top",
			                    RANKX(ALLSELECTED('Unique scope3 EV PRO Segment'[PRO_Segment]), [Actual BY Emission], , DESC) > RankingLimit,
			                    RANKX(ALLSELECTED('Unique scope3 EV PRO Segment'[PRO_Segment]), [Actual BY Emission], , ASC) > RankingLimit
			                )
			            )
			        ),
			        CALCULATE(
			            [Actual BY Emission],
			            FILTER(
			                ALL('Unique scope3 EV PRO PRO Subcategory'),
			                IF(
			                    TopBottomValue = "Top",
			                    RANKX(ALLSELECTED('Unique scope3 EV PRO PRO Subcategory'[PRO_Subcategory]), [Actual BY Emission], , DESC) > RankingLimit,
			                    RANKX(ALLSELECTED('Unique scope3 EV PRO PRO Subcategory'[PRO_Subcategory]), [Actual BY Emission], , ASC) > RankingLimit
			                )
			            )
			        )
			
			                )
			            )
			        )
			    )
			    )
			--------------------------------------------------
			-- ✅ FINAL OUTPUT
			--------------------------------------------------
			RETURN
			IF(
			    IsOthers,
			    OthersEmission,
			    IF(
			        TopBottomValue = "Top",
			        IF(CurrentRank <= RankingLimit, [Actual BY Emission], BLANK()),
			        IF(CurrentRank <= RankingLimit, [Actual BY Emission], BLANK())
			    )
			)
			```
		lineageTag: 2ee95112-100f-40d5-adca-e5ec1399887b

