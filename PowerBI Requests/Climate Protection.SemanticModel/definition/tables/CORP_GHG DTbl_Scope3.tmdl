	measure 'Emissions CY' = ```
			
			VAR TopBottomValue = SELECTEDVALUE('Top/Bottom'[Value])        // "Top" or "Bottom"
			VAR RankingLimit = SELECTEDVALUE('Ranking Option'[Ranking Option])
			VAR ViewBySelection = SELECTEDVALUE(ViewBy[ViewBy Fields])
			
			VAR IsCategory = CONTAINSSTRING(ViewBySelection, "Scope 3 Category")
			VAR IsCountry = CONTAINSSTRING(ViewBySelection, "Country")
			VAR IsBusinessUnit = CONTAINSSTRING(ViewBySelection, "Business unit")
			
			// Compute rank for the current item
			VAR CurrentRank =
			    IF(
			        IsCategory,
			        IF(TopBottomValue = "Top",
			            RANKX(ALL('Unique Categories scope3'[CO2 Scope 3 Category]), [Actual Emission], , DESC),
			            RANKX(ALL('Unique Categories scope3'[CO2 Scope 3 Category]), [Actual Emission], , ASC)
			        ),
			        IF(IsCountry,
			            IF(TopBottomValue = "Top",
			                RANKX(ALL('Unique Country scope3'[Country]), [Actual Emission], , DESC),
			                RANKX(ALL('Unique Country scope3'[Country]), [Actual Emission], , ASC)
			            ),
			            IF(IsBusinessUnit,
			                IF(TopBottomValue = "Top",
			                    RANKX(ALL('Unique Business unit scope3'[Business_unit]), [Actual Emission], , DESC),
			                    RANKX(ALL('Unique Business unit scope3'[Business_unit]), [Actual Emission], , ASC)
			                ),
			                BLANK()
			            )
			        )
			    )
			
			VAR TotalRows =
			    IF(
			        IsCategory,
			        COUNTROWS(ALL('Unique Categories scope3'[CO2 Scope 3 Category])),
			        IF(
			            IsCountry,
			            COUNTROWS(ALL('Unique Country scope3'[Country])),
			            IF(
			                IsBusinessUnit,
			                COUNTROWS(ALL('Unique Business unit scope3'[Business_unit])),
			                BLANK()
			            )
			        )
			    )
			
			// Calculate Others total dynamically
			VAR OthersEmission =
			    IF(
			        IsCategory,
			        CALCULATE(
			            [Actual Emission],
			            FILTER(
			                ALL('Unique Categories scope3'),
			                IF(TopBottomValue = "Top",
			                    RANKX(ALL('Unique Categories scope3'[CO2 Scope 3 Category]), [Actual Emission], , DESC) > RankingLimit,
			                    RANKX(ALL('Unique Categories scope3'[CO2 Scope 3 Category]), [Actual Emission], , ASC) > RankingLimit
			                )
			            )
			        ),
			        IF(
			            IsCountry,
			            CALCULATE(
			                [Actual Emission],
			                FILTER(
			                    ALL('Unique Country scope3'),
			                    IF(TopBottomValue = "Top",
			                        RANKX(ALL('Unique Country scope3'[Country]), [Actual Emission], , DESC) > RankingLimit,
			                        RANKX(ALL('Unique Country scope3'[Country]), [Actual Emission], , ASC) > RankingLimit
			                    )
			                )
			            ),
			            IF(
			                IsBusinessUnit,
			                CALCULATE(
			                    [Actual Emission],
			                    FILTER(
			                        ALL('Unique Business unit scope3'),
			                        IF(TopBottomValue = "Top",
			                            RANKX(ALL('Unique Business unit scope3'[Business_unit]), [Actual Emission], , DESC) > RankingLimit,
			                            RANKX(ALL('Unique Business unit scope3'[Business_unit]), [Actual Emission], , ASC) > RankingLimit
			                        )
			                    )
			                )
			                
			            )
			        )
			    )
			
			RETURN
			IF(
			    (IsCategory && SELECTEDVALUE('Unique Categories scope3'[CO2 Scope 3 Category]) = "Others") ||
			    (IsCountry && SELECTEDVALUE('Unique Country scope3'[Country]) = "Others") ||
			    (IsBusinessUnit && SELECTEDVALUE('Unique Business unit scope3'[Business_unit]) = "Others"),
			    OthersEmission,
			    IF(
			        TopBottomValue = "Top",
			        IF(CurrentRank <= RankingLimit, [Actual Emission], BLANK()),
			        IF(CurrentRank <= RankingLimit + 1, [Actual Emission], BLANK())
			    )
			)
			```
		formatString: 0
		lineageTag: 66f0cba1-551f-458a-bb1f-e515bacc1cdc

	measure 'Actual Emission (Act vs Trg)' =
			
			IF(
			    'CORP_GHG DTbl_Scope3'[_Actual Year Filter] = SELECTEDVALUE('CORP_GHG DTbl_Scope3'[Fiscal_Date]),
			    [Actual Emission],
			    BLANK()
			)
		formatString: 0
		lineageTag: 300cba96-7998-411d-b020-a38451a51d5e

	measure '_Actual Year Filter' =
			
			VAR CurrentDay = DAY(TODAY())
			VAR CurrentMonth = MONTH(TODAY())
			VAR CurrentYear = YEAR(TODAY())
			
			VAR IsDayMonthCondition = (CurrentDay >= 29 && CurrentMonth = 1) || CurrentMonth > 1
			
			VAR YearValue = SELECTEDVALUE('CORP_GHG DTbl_Scope3'[Year])
			VAR IsTargetValue = SELECTEDVALUE('CORP_GHG DTbl_Scope3'[Is_Target])
			VAR FiscalDate = SELECTEDVALUE('CORP_GHG DTbl_Scope3'[Fiscal_Date])
			
			VAR IsYearCondition = YearValue + 1 = CurrentYear
			VAR IsTargetCondition = IsTargetValue = 0
			VAR IsYearLessCondition = YearValue < CurrentYear - 1
			
			RETURN
			IF(
			    (IsDayMonthCondition && IsYearCondition && IsTargetCondition) || IsYearLessCondition,
			    FiscalDate,
			    BLANK()
			)
		formatString: General Date
		lineageTag: 66026ec8-d6e4-428d-8338-0af425290f03

	measure '_Actual Emission Reduction %' =
			
			VAR ActualEmission = COALESCE([Actual Emission (Act vs Trg)], 0)
			VAR BaseYearEmission = COALESCE([Actual BY Emission], 0)
			
			RETURN
			DIVIDE(ActualEmission - BaseYearEmission, BaseYearEmission)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 1868875e-deee-4b8f-b01f-b80e5e672ae4

