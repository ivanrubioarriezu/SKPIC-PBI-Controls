	column 'Actual Year Filter' =
			
			VAR IsDayMonthCondition = (DAY(TODAY()) >= 29 && MONTH(TODAY()) = 1) || MONTH(TODAY()) > 1
			VAR IsYearCondition = [Year] + 1 = YEAR(TODAY())
			VAR IsTargetCondition = [Is_Target]= 0
			VAR IsYearLessCondition = [Year] < YEAR(TODAY()) - 1
			RETURN
			IF(IsDayMonthCondition && IsYearCondition && IsTargetCondition || IsYearLessCondition,[Fiscal_Date],BLANK())
		formatString: General Date
		lineageTag: 75eeab92-53ca-4892-bc89-3a3a731e66a7
		summarizeBy: none

		variation Variation
			isDefault
