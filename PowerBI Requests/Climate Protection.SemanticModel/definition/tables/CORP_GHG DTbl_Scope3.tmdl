			                    RANKX(ALLSELECTED('Unique Business unit scope3'[Business_unit]), [Actual Emission], , DESC),
			                    RANKX(ALLSELECTED('Unique Business unit scope3'[Business_unit]), [Actual Emission], , ASC)
			                )
			            )
			        )
			    )
			
			--------------------------------------------------
			-- ✅ OTHERS CALCULATION
			--------------------------------------------------
			VAR OthersEmission =
			    IF(
			        IsCategory,
			        CALCULATE(
			            [Actual Emission],
			            FILTER(
			                ALL('Unique Categories scope3'),
			                IF(
			                    TopBottomValue = "Top",
			                    RANKX(ALLSELECTED('Unique Categories scope3'[CO2 Scope 3 Category]), [Actual Emission], , DESC) > RankingLimit,
			                    RANKX(ALLSELECTED('Unique Categories scope3'[CO2 Scope 3 Category]), [Actual Emission], , ASC) > RankingLimit
			                )
			            )
			        ),
			        IF(
			            IsCountry,
			            CALCULATE(
			                [Actual Emission],
			                FILTER(
			                    ALL('Unique Country scope3'),
			                    IF(
			                        TopBottomValue = "Top",
			                        RANKX(ALL('Unique Country scope3'[Country]), [Actual Emission], , DESC) > RankingLimit,
			                        RANKX(ALL('Unique Country scope3'[Country]), [Actual Emission], , ASC) > RankingLimit
