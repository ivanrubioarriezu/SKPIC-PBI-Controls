			                    // For Top N: exclude top N
			                    RANKX(ALL('Unique Categories scope3'[CO2 Scope 3 Category]), [Actual Emission], , DESC) > RankingLimit,
			                    // ✅ For Bottom N: exclude bottom N
			                    RANKX(ALL('Unique Categories scope3'[CO2 Scope 3 Category]), [Actual Emission], , ASC) > RankingLimit
			                )
			            )
			        ),
			        CALCULATE(
			            [Actual Emission],
