		lineageTag: 7d1dee99-e25f-4136-9bb0-0ab3fbb64e7b

	measure 'TopN Filter scope3 PRO' = ```
			
			
			VAR TopBottomValue = SELECTEDVALUE('Top/Bottom'[Value])
			VAR RankingLimit = SELECTEDVALUE('Ranking Option'[Ranking Option])
			VAR ViewBySelection = SELECTEDVALUE('ViewBy Pro'[ViewBy Pro Fields])
			
			
			VAR IsCategory = CONTAINSSTRING(ViewBySelection, "PRO Category")
			VAR IsCountry = CONTAINSSTRING(ViewBySelection, "Country")
			VAR IsBusinessUnit = CONTAINSSTRING(ViewBySelection, "Business unit")
			VAR IsPROArea = CONTAINSSTRING(ViewBySelection, "PRO Area")
			VAR IsPROSegment = CONTAINSSTRING(ViewBySelection, "PRO Segment")
			VAR IsPROSubcategory = CONTAINSSTRING(ViewBySelection, "PRO Subcategory")
			
			VAR IsOthers =
			    (IsCategory && SELECTEDVALUE('Unique scope3 EV PRO Category'[PRO_Category]) = "Others") ||
			    (IsCountry && SELECTEDVALUE('Unique Country scope3'[Country]) = "Others") ||
			    (IsBusinessUnit && SELECTEDVALUE('Unique Business unit scope3'[Business_unit]) = "Others")||
			    (IsPROArea && SELECTEDVALUE('Unique scope3 EV PRO Area'[PRO_Area])= "Others")||
			    (IsPROSegment && SELECTEDVALUE('Unique scope3 EV PRO Segment'[PRO_Segment])="Others")||
			    (IsPROSubcategory && SELECTEDVALUE('Unique scope3 EV PRO PRO Subcategory'[PRO_Subcategory])="Others")
			
			
			
			
			
			--------------------------------------------------
			-- ✅ CORRECT RANK LOGIC (no error)
			--------------------------------------------------
			VAR RankValue =
			IF(
			            IsCategory,
			            IF(
			                TopBottomValue = "Top",
			                RANKX(ALLSELECTED('Unique scope3 EV PRO Category'[PRO_Category]), [Actual Emission], , DESC),
			                RANKX(ALLSELECTED('Unique scope3 EV PRO Category'[PRO_Category]), [Actual Emission], , ASC)
			            ),
			            IF(
			                IsCountry,
			                IF(
			                    TopBottomValue = "Top",
			                    RANKX(ALLSELECTED('Unique Country scope3'[Country]), [Actual Emission], , DESC),
			                    RANKX(ALLSELECTED('Unique Country scope3'[Country]), [Actual Emission], , ASC)
			                ),
			                IF(
			                IsBusinessUnit,
			                IF(
			                    TopBottomValue = "Top",
			                    RANKX(ALLSELECTED('Unique Business unit scope3'[Business_unit]), [Actual Emission], , DESC),
			                    RANKX(ALLSELECTED('Unique Business unit scope3'[Business_unit]), [Actual Emission], , ASC)
			                ),
			            
			
			                IF(
			                    IsPROArea,
			                    IF(
			                        TopBottomValue="Top",
			                        RANKX(ALLSELECTED('Unique scope3 EV PRO Area'[PRO_Area]), [Actual Emission], ,DESC),
			                        RANKX(ALLSELECTED('Unique scope3 EV PRO Area'[PRO_Area]), [Actual Emission], ,ASC)
			                        ),
			                IF(
			                    IsPROSegment,
			                            IF(
			                               TopBottomValue="Top",
			                        RANKX(ALLSELECTED('Unique scope3 EV PRO Segment'[PRO_Segment]), [Actual Emission], ,DESC),
			                        RANKX(ALLSELECTED('Unique scope3 EV PRO Segment'[PRO_Segment]), [Actual Emission], ,ASC)
			                        ), 
			             
			                                IF(
			                               TopBottomValue="Top",
			                        RANKX(ALLSELECTED('Unique scope3 EV PRO PRO Subcategory'[PRO_Subcategory]), [Actual Emission], ,DESC),
			                        RANKX(ALLSELECTED('Unique scope3 EV PRO PRO Subcategory'[PRO_Subcategory]), [Actual Emission], ,ASC)
			                        )
			
			
			
			            )
			        )
			    )))
			
			--------------------------------------------------
			/*VAR RankValue =
			    IF(
			        IsCategory,
			        IF(
			            TopBottomValue = "Top",
			            RANKX(ALL('Unique Categories scope3'[CO2_Scope_3_Category]), [Actual Emission], , DESC),
			            RANKX(ALL('Unique Categories scope3'[CO2_Scope_3_Category]), [Actual Emission], , ASC)
			        ),
			        IF(
			            IsCountry,
			            IF(
			                TopBottomValue = "Top",
			                RANKX(ALL('Unique Country scope3'[Country]), [Actual Emission], , DESC),
			                RANKX(ALL('Unique Country scope3'[Country]), [Actual Emission], , ASC)
			            ),
			            IF(
			                TopBottomValue = "Top",
			                RANKX(ALL('Unique Business unit scope3'[Business_unit]), [Actual Emission], , DESC),
			                RANKX(ALL('Unique Business unit scope3'[Business_unit]), [Actual Emission], , ASC)
			            )
			        )
			    )*/
			
			RETURN
			IF(
			    IsOthers,
			    1,   -- ✅ always include Others
			    IF(RankValue <= RankingLimit, 1, 0)
			)
			```
		formatString: 0
		lineageTag: 52ed5cce-651f-4387-af63-1c415b78023d

	measure '_Emissions CY PRO Sort' = ```
			
			
			VAR ViewBySelection = SELECTEDVALUE('ViewBy Pro'[ViewBy Pro Fields])
			
			VAR IsCategory = CONTAINSSTRING(ViewBySelection, "PRO Category")
			VAR IsCountry = CONTAINSSTRING(ViewBySelection, "Country")
			VAR IsBusinessUnit = CONTAINSSTRING(ViewBySelection, "Business unit")
			VAR IsPROArea = CONTAINSSTRING(ViewBySelection, "PRO Area")
			VAR IsPROSegment = CONTAINSSTRING(ViewBySelection, "PRO Segment")
			VAR IsPROSubcategory = CONTAINSSTRING(ViewBySelection, "PRO Subcategory")
			
			VAR IsOthers =
			    (IsCategory && SELECTEDVALUE('Unique scope3 EV PRO Category'[PRO_Category]) = "Others") ||
			    (IsCountry && SELECTEDVALUE('Unique Country scope3'[Country]) = "Others") ||
			    (IsBusinessUnit && SELECTEDVALUE('Unique Business unit scope3'[Business_unit]) = "Others")||
			    (IsPROArea && SELECTEDVALUE('Unique scope3 EV PRO Area'[PRO_Area])= "Others")||
			    (IsPROSegment && SELECTEDVALUE('Unique scope3 EV PRO Segment'[PRO_Segment])="Others")||
			    (IsPROSubcategory && SELECTEDVALUE('Unique scope3 EV PRO PRO Subcategory'[PRO_Subcategory])="Others")
			
			
			
			RETURN
			IF(
			    IsOthers,
			    999999999999,     -- ✅ FORCE LAST (independent of value)
			    -[Actual Emission]        -- ✅ keep your dynamic sorting
			)
			
			
			
			
			
			```
