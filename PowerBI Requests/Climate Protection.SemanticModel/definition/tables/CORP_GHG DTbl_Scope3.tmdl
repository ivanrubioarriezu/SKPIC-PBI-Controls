	measure 'TopN Filter scope3 CY' =
			
			
			VAR RankingLimit =
			    SELECTEDVALUE('Ranking Option'[Ranking Option])
			
			VAR TopBottomValue =
			    SELECTEDVALUE('Top/Bottom'[Value])
			
			VAR ViewBySelection =
			    SELECTEDVALUE(ViewBy[ViewBy Fields])
			
			VAR IsCategory =
			    CONTAINSSTRING(ViewBySelection, "Scope 3 Category")
			
			VAR IsCountry =
			    CONTAINSSTRING(ViewBySelection, "Country")
			
			VAR IsBusinessUnit =
			    CONTAINSSTRING(ViewBySelection, "Business_unit")
			
			VAR IsOthers =
			    ( IsCategory
			        && SELECTEDVALUE('Unique Categories scope3'[CO2 Scope 3 Category]) = "Others"
			    )
			        || ( IsCountry
			            && SELECTEDVALUE('Unique Country scope3'[Country]) = "Others"
			        )
			        || ( IsBusinessUnit
			            && SELECTEDVALUE('Unique Business unit scope3'[Business_unit]) = "Others"
			        )
			
			VAR CurrentValue =
			    [Actual Emission]
			
			VAR RankValue =
			    IF (
			        IsCategory,
			        IF (
			            TopBottomValue = "Top",
			            RANKX (
			                ALL ( 'Unique Categories scope3'[CO2 Scope 3 Category] ),
			                COALESCE ( [Actual Emission], 0 ),
			                ,
			                DESC,
			                DENSE
			            ),
			            RANKX (
			                ALL ( 'Unique Categories scope3'[CO2 Scope 3 Category] ),
			                COALESCE ( [Actual Emission], 0 ),
			                ,
			                ASC,
			                DENSE
			            )
			        ),
			        IF (
			            IsCountry,
			            IF (
			                TopBottomValue = "Top",
			                RANKX (
			                    ALL ( 'Unique Country scope3'[Country] ),
			                    COALESCE ( [Actual Emission], 0 ),
			                    ,
			                    DESC,
			                    DENSE
			                ),
			                RANKX (
			                    ALL ( 'Unique Country scope3'[Country] ),
			                    COALESCE ( [Actual Emission], 0 ),
			                    ,
			                    ASC,
			                    DENSE
			                )
			            ),
			            IF (
			                TopBottomValue = "Top",
			                RANKX (
			                    ALL ( 'Unique Business unit scope3'[Business_unit] ),
			                    COALESCE ( [Actual Emission], 0 ),
			                    ,
			                    DESC,
			                    DENSE
			                ),
			                RANKX (
			                    ALL ( 'Unique Business unit scope3'[Business_unit] ),
			                    COALESCE ( [Actual Emission], 0 ),
			                    ,
			                    ASC,
			                    DENSE
			                )
			            )
			        )
			    )
			
			RETURN
			IF (
			    IsOthers,
			    1,
			    IF (
			        ISBLANK ( CurrentValue ),
			        1,
			        IF ( RankValue <= RankingLimit, 1, 0 )
			    )
			)
			
			
			
			
