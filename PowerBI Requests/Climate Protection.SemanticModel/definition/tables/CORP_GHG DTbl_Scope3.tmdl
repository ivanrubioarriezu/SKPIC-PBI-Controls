			                ),
			                IF(
			                IsBusinessUnit,
			                IF(
			                    TopBottomValue = "Top",
			                    RANKX(ALLSELECTED('Unique Business unit scope3'[Business_unit]), [Actual Emission], , DESC),
			                    RANKX(ALLSELECTED('Unique Business unit scope3'[Business_unit]), [Actual Emission], , ASC)
			                ),
			            
			
			                IF(
			                    IsPROArea,
			                    IF(
			                        TopBottomValue="Top",
			                        RANKX(ALLSELECTED('Unique scope3 EV PRO Area'[PRO_Area]), [Actual Emission], ,DESC),
			                        RANKX(ALLSELECTED('Unique scope3 EV PRO Area'[PRO_Area]), [Actual Emission], ,ASC)
			                        ),
			                IF(
			                    IsPROSegment,
