	measure 'TopN Filter scope3 PY' =
			
			
			VAR RankingLimit = SELECTEDVALUE('Ranking Option'[Ranking Option])
			VAR TopBottomValue = SELECTEDVALUE('Top/Bottom'[Value])
			VAR ViewBySelection = SELECTEDVALUE(ViewBy[ViewBy Fields])
			
			--------------------------------------------------
			-- ✅ Dynamic Sort Measure (CRITICAL FIX)
			--------------------------------------------------
			VAR SortMeasure =
			    SWITCH(
			        SELECTEDVALUE('scope 3 Sorting Table'[Sort By]),
			        "Reporting Year Value", [Actual Emission],
			        "Previous Year Value", [Actual PY Emission],
			        "Baseline Year Value", [Actual BY Emission]
			    )
			
			--------------------------------------------------
			-- ✅ Detect dimension
			--------------------------------------------------
			VAR IsCategory = CONTAINSSTRING(ViewBySelection, "CO2_Scope_3_Category")
			VAR IsCountry = CONTAINSSTRING(ViewBySelection, "Country")
			VAR IsBusinessUnit = CONTAINSSTRING(ViewBySelection, "Business_unit")
			
			--------------------------------------------------
			-- ✅ Detect Others
			--------------------------------------------------
			VAR IsOthers =
			    (IsCategory && SELECTEDVALUE('Unique Categories scope3'[CO2 Scope 3 Category]) = "Others") ||
			    (IsCountry && SELECTEDVALUE('Unique Country scope3'[Country]) = "Others") ||
			    (IsBusinessUnit && SELECTEDVALUE('Unique Business unit scope3'[Business_unit]) = "Others")
			
			--------------------------------------------------
			-- ✅ Ranking (NOW based on SortMeasure ✅)
			--------------------------------------------------
			VAR RankValue =
			    IF(
			        IsCategory,
			        IF(
			            TopBottomValue = "Top",
			            RANKX(
			                ALLSELECTED('Unique Categories scope3'[CO2 Scope 3 Category]),
			                COALESCE(SortMeasure, 0),
			                ,
			                DESC,
			                DENSE
			            ),
			            RANKX(
			                ALLSELECTED('Unique Categories scope3'[CO2 Scope 3 Category]),
			                COALESCE(SortMeasure, 0),
			                ,
			                ASC,
			                DENSE
			            )
			        ),
			        IF(
			            IsCountry,
			            IF(
			                TopBottomValue = "Top",
			                RANKX(
			                    ALLSELECTED('Unique Country scope3'[Country]),
			                    COALESCE(SortMeasure, 0),
			                    ,
			                    DESC,
			                    DENSE
			                ),
			                RANKX(
			                    ALLSELECTED('Unique Country scope3'[Country]),
			                    COALESCE(SortMeasure, 0),
			                    ,
			                    ASC,
			                    DENSE
			                )
			            ),
			            IF(
			                TopBottomValue = "Top",
			                RANKX(
			                    ALLSELECTED('Unique Business unit scope3'[Business_unit]),
			                    COALESCE(SortMeasure, 0),
			                    ,
			                    DESC,
			                    DENSE
			                ),
			                RANKX(
			                    ALLSELECTED('Unique Business unit scope3'[Business_unit]),
			                    COALESCE(SortMeasure, 0),
			                    ,
			                    ASC,
			                    DENSE
			                )
			            )
			        )
			    )
			
			--------------------------------------------------
			-- ✅ FINAL OUTPUT
			--------------------------------------------------
			RETURN
			IF(
			    IsOthers,
			    1,
			    IF(RankValue <= RankingLimit, 1, 0)
			)
		formatString: 0
		lineageTag: d984982b-7291-4920-a983-ed175372fdb4

