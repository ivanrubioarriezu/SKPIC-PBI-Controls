			                        TopBottomValue = "Top",
			                        RANKX(ALL('Unique Business unit scope3'[Business_unit]), [Actual Emission], , DESC) > RankingLimit,
			                        RANKX(ALL('Unique Business unit scope3'[Business_unit]), [Actual Emission], , ASC) > RankingLimit
			                    )
			                )
			            ),
			              IF(
			        IsPROArea,
			        CALCULATE(
			            [Actual Emission],
			            FILTER(
			                ALL('Unique scope3 EV PRO Area'),
			                IF(
			                    TopBottomValue = "Top",
			                    RANKX(ALLSELECTED('Unique scope3 EV PRO Area'[PRO_Area]), [Actual Emission], , DESC) > RankingLimit,
			                    RANKX(ALLSELECTED('Unique scope3 EV PRO Area'[PRO_Area]), [Actual Emission], , ASC) > RankingLimit
			                )
			            )
			        ),
			         IF(
			        IsPROSegment,
			        CALCULATE(
			            [Actual Emission],
			            FILTER(
			                ALL('Unique scope3 EV PRO Segment'),
			                IF(
			                    TopBottomValue = "Top",
			                    RANKX(ALLSELECTED('Unique scope3 EV PRO Segment'[PRO_Segment]), [Actual Emission], , DESC) > RankingLimit,
			                    RANKX(ALLSELECTED('Unique scope3 EV PRO Segment'[PRO_Segment]), [Actual Emission], , ASC) > RankingLimit
