	column 'Actual Year Filter' = ```
			
			IF (
			    (
			        (
			            (DAY(TODAY()) >= 29 && MONTH(TODAY()) = 1) 
			            || MONTH(TODAY()) > 1
			        ) 
			        && [Year] + 1 = YEAR(TODAY()) 
			        && [Is_Target] = FALSE
			    ) 
			    || [Year] < YEAR(TODAY()),
			    [Fiscal_Date],
			    BLANK()
			)
			
			/*VAR _TodayYear  = YEAR ( TODAY() )
			VAR _TodayMonth = MONTH ( TODAY() )
			VAR _TodayDay   = DAY ( TODAY() )
			
			VAR _CutoffReached =
			    ( _TodayMonth > 1 )
			        || ( _TodayMonth = 1 && _TodayDay >= 29 )
			
			VAR _ShowPrevYearActual =
			    _CutoffReached
			        && [Year] + 1 = _TodayYear
			        && [Is_Target] = FALSE
			
			VAR _ShowOlderYears =
			    [Year] < _TodayYear - 1
			
			RETURN
			IF (
			    _ShowPrevYearActual || _ShowOlderYears,
			    [Fiscal_Date],
			    BLANK()
			)*/
			
			```
