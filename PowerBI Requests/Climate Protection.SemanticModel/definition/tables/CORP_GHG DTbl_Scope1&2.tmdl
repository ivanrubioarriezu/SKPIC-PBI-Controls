	measure Scope1&2Reduction% =
			
			VAR CurrentEmission = COALESCE(('CORP_GHG DTbl_Scope1&2'[Scope 1&2 Emission]), 0)
			VAR BaselineEmission = COALESCE(SUM('CORP_GHG DTbl_Scope1&2'[Scope1&2 Emission BY]), 0)
			RETURN
			DIVIDE(CurrentEmission - BaselineEmission, BaselineEmission, 0)
