			VAR TopX =
			    SELECTEDVALUE ( 'Ranking Option'[Ranking Option], 0 )
			
			VAR ViewBySelection =
			    SELECTEDVALUE ( 'ViewBy'[ViewBy Fields] )
			
			/* ===================== RANKS ===================== */
			
			
			VAR Rank_Country =
			    RANKX (
			        FILTER ( ALL ( 'Unique Country'[Country] ), 'Unique Country'[Country] <> "Others" ),
			        [GMV_BY_Selection (HY/FY)],
			        ,
			        DESC,
			        DENSE
			    )
			
			VAR Rank_Brand =
			    RANKX (
			        FILTER (
			            ALL ( 'Unique Brand'[Brand] ),
			            'Unique Brand'[Brand] <> "Others"
			        ),
			        [GMV_BY_Selection (HY/FY)],
			        ,
			        DESC,
			        DENSE
			    )
			
			/* ===================== CURRENT RANK ===================== */
			
			VAR CurrentRank =
			    SWITCH (
			        TRUE (),
			       
			        ViewBySelection = NAMEOF ( 'Unique Country'[Country] ), Rank_Country,
			      
			        ViewBySelection = NAMEOF ( 'Unique Brand'[Brand] ), Rank_Brand
			    )
			
			/* ===================== IS OTHERS ===================== */
			
			VAR IsOthers =
			    SWITCH (
			        TRUE (),
			    
			        ViewBySelection = NAMEOF ( 'Unique Country'[Country] ),
			            SELECTEDVALUE ( 'Unique Country'[Country] ) = "Others",
			     
			        ViewBySelection = NAMEOF ( 'Unique Brand'[Brand]),
			            SELECTEDVALUE ( 'Unique Brand'[Brand] ) = "Others",
			        FALSE
			    )
			
			/* ===================== FINAL RETURN (FILTER FLAG) ===================== */
			
			RETURN
			SWITCH (
			    TRUE (),
			
			    -- ✅ Always show Others
			    IsOthers, 1,
			
			    -- ✅ Show Top‑X rows
			    TopX = 0 || CurrentRank <= TopX, 1,
			
			    -- ❌ Hide everything else
			    0
			)
			```
		formatString: 0
		lineageTag: 2c3f2048-3ea0-45e3-a520-a23ae93e8664

	measure '_Dynamic ACT CY 100% bar' =
			
			
			VAR TopX =
			    SELECTEDVALUE('Ranking Option'[Ranking Option], 0)
			
			VAR ViewBySelection =
			    SELECTEDVALUE('ViewBy'[ViewBy Fields])
			
			
			/* ===================== RANKS (IGNORE LEGEND) ===================== */
			
			VAR Rank_Country =
			    RANKX (
			        FILTER (
			            ALL ('Unique Country'[Country]),
			            'Unique Country'[Country] <> "Others"
			        ),
			        CALCULATE (
			            [GMV_CY_Selection (HY/FY)],
			            REMOVEFILTERS('CH_UP DMT_KPI'[Pillar_SKU_Class])   -- ✅ KEY FIX
			        ),
			        ,
			        DESC,
			        DENSE
			    )
			
			VAR Rank_Brand =
			    RANKX (
			        FILTER (
			            ALL ('Unique Brand'[Brand]),
			            'Unique Brand'[Brand] <> "Others"
			        ),
			        CALCULATE (
			            [GMV_CY_Selection (HY/FY)],
			            REMOVEFILTERS('CH_UP DMT_KPI'[Pillar_SKU_Class])   -- ✅ KEY FIX
			        ),
			        ,
			        DESC,
			        DENSE
			    )
			
			
			/* ===================== OTHERS VALUES ===================== */
			
			VAR Others_Country =
			    CALCULATE (
			        [GMV_CY_Selection (HY/FY)],
			        FILTER (
			            ALL ('Unique Country'[Country]),
			            RANKX (
			                ALL ('Unique Country'[Country]),
			                CALCULATE (
			                    [GMV_CY_Selection (HY/FY)],
			                    REMOVEFILTERS('CH_UP DMT_KPI'[Pillar_SKU_Class])
			                ),
			                ,
			                DESC
			            ) > TopX
			        )
			    )
			
			VAR Others_Brand =
			    CALCULATE (
			        [GMV_CY_Selection (HY/FY)],
			        FILTER (
			            ALL ('Unique Brand'[Brand]),
			            RANKX (
			                ALL ('Unique Brand'[Brand]),
			                CALCULATE (
			                    [GMV_CY_Selection (HY/FY)],
			                    REMOVEFILTERS('CH_UP DMT_KPI'[Pillar_SKU_Class])
			                ),
			                ,
			                DESC
			            ) > TopX
			        )
			    )
			
			
			/* ===================== CURRENT RANK ===================== */
			
			VAR CurrentRank =
			    SWITCH (
			        TRUE(),
			
			        ViewBySelection = NAMEOF('Unique Country'[Country]), Rank_Country,
			        ViewBySelection = NAMEOF('Unique Brand'[Brand]), Rank_Brand,
			
			        BLANK()
			    )
			
			
			/* ===================== IS OTHERS ===================== */
			
			VAR IsOthers =
			    SWITCH (
			        TRUE(),
			
			        ViewBySelection = NAMEOF('Unique Country'[Country]),
			            SELECTEDVALUE('Unique Country'[Country]) = "Others",
			
			        ViewBySelection = NAMEOF('Unique Brand'[Brand]),
			            SELECTEDVALUE('Unique Brand'[Brand]) = "Others",
			
			        FALSE
			    )
			
			
			/* ===================== FINAL ===================== */
			
			RETURN
			SWITCH (
			    TRUE(),
			
			    /* ✅ Others row */
			    IsOthers,
			        SWITCH (
			            TRUE(),
			            ViewBySelection = NAMEOF('Unique Country'[Country]), Others_Country,
			            ViewBySelection = NAMEOF('Unique Brand'[Brand]), Others_Brand,
			            BLANK()
			        ),
			
			    /* ✅ TopX selection */
			    TopX = 0 || CurrentRank <= TopX,
			        [GMV_CY_Selection (HY/FY)],   -- ✅ DO NOT REMOVE FILTERS HERE
			
			    BLANK()
			)
		lineageTag: 2aa12dc5-85aa-4c34-aef2-9bc98ddcdb22

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CY Filter for Others 100%' =
			
			
			VAR TopX =
			    SELECTEDVALUE('Ranking Option'[Ranking Option], 0)
			
			VAR ViewBySelection =
			    SELECTEDVALUE('ViewBy'[ViewBy Fields])
			
			/* ===================== RANKS (IGNORE LEGEND) ===================== */
			
			VAR Rank_Country =
			    RANKX (
			        FILTER (
			            ALL('Unique Country'[Country]),
			            'Unique Country'[Country] <> "Others"
			        ),
			        CALCULATE(
			            [GMV_CY_Selection (HY/FY)],
			            REMOVEFILTERS('CH_UP DMT_KPI'[Pillar_SKU_Class])   -- ✅ IMPORTANT FIX
			        ),
			        ,
			        DESC,
			        DENSE
			    )
			
			VAR Rank_Brand =
			    RANKX (
			        FILTER (
			            ALL('Unique Brand'[Brand]),
			            'Unique Brand'[Brand] <> "Others"
			        ),
			        CALCULATE(
			            [GMV_CY_Selection (HY/FY)],
			            REMOVEFILTERS('CH_UP DMT_KPI'[Pillar_SKU_Class])   -- ✅ IMPORTANT FIX
			        ),
			        ,
			        DESC,
			        DENSE
			    )
			
			/* ===================== CURRENT RANK ===================== */
			
			VAR CurrentRank =
			    SWITCH(
			        TRUE(),
			        ViewBySelection = NAMEOF('Unique Country'[Country]), Rank_Country,
			        ViewBySelection = NAMEOF('Unique Brand'[Brand]), Rank_Brand,
			        BLANK()
			    )
			
			/* ===================== IS OTHERS ===================== */
			
			VAR IsOthers =
			    SWITCH(
			        TRUE(),
			        ViewBySelection = NAMEOF('Unique Country'[Country]),
			            SELECTEDVALUE('Unique Country'[Country]) = "Others",
			        ViewBySelection = NAMEOF('Unique Brand'[Brand]),
			            SELECTEDVALUE('Unique Brand'[Brand]) = "Others",
			        FALSE
			    )
			
			/* ===================== FINAL FILTER ===================== */
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    -- ✅ Always keep Others
			    IsOthers, 1,
			
			    -- ✅ Show TopX
			    TopX = 0 || CurrentRank <= TopX, 1,
			
			    -- ❌ Hide rest
			    0
			)
		formatString: 0
		lineageTag: aec876da-8741-4aec-956b-45001564f1e1

	measure 'GMV CY With Total' =
			
			VAR _AxisValue =
			    SELECTEDVALUE (
			        'Pillar SKU Axis'[Pillar_SKU_Class]
			    )
			
			RETURN
			IF (
			    _AxisValue = "Total",
			
			    -- Total
			    [GMV_CY_Selection (HY/FY)],
			
			    -- Normal Pillar/SKU bars
			    CALCULATE (
			        [GMV_CY_Selection (HY/FY)],
			        TREATAS (
