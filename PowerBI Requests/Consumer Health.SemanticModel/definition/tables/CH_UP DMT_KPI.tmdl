		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_CY Emissions' =
			
			
			
			VAR TopBottomValue = SELECTEDVALUE('Top/Bottom'[Value])
			VAR TopX = SELECTEDVALUE('Ranking Option'[Ranking Option], 0)
			VAR ViewBySelection = SELECTEDVALUE(ViewBy[ViewBy Fields])
			
			VAR IsCountry = CONTAINSSTRING(ViewBySelection, "Country")
			VAR IsBrand   = CONTAINSSTRING(ViewBySelection, "Brand")
			
			/* ===================== BASE ===================== */
			VAR BaseMeasureForRank =
			    CALCULATE(
			        [GMV_CY_Selection (HY/FY)],
			        REMOVEFILTERS('CH_UP DMT_KPI'[Pillar_SKU_Class])
			    )
			
			/* ===================== RANK ===================== */
			VAR RankValue =
			    SWITCH(
			        TRUE(),
			
			        IsCountry,
			            IF(
			                TopBottomValue = "Top",
			                RANKX(
			                    FILTER(ALL('Unique Country'), 'Unique Country'[Country] <> "Others"),
			                    BaseMeasureForRank,
			                    ,
			                    DESC,
			                    DENSE
			                ),
			                RANKX(
			                    FILTER(ALL('Unique Country'), 'Unique Country'[Country] <> "Others"),
			                    BaseMeasureForRank,
			                    ,
			                    ASC,
			                    DENSE
			                )
			            ),
			
			        IsBrand,
			            IF(
			                TopBottomValue = "Top",
			                RANKX(
			                    FILTER(ALL('Unique Brand'), 'Unique Brand'[Brand] <> "Others"),
			                    BaseMeasureForRank,
			                    ,
			                    DESC,
			                    DENSE
			                ),
			                RANKX(
			                    FILTER(ALL('Unique Brand'), 'Unique Brand'[Brand] <> "Others"),
			                    BaseMeasureForRank,
			                    ,
			                    ASC,
			                    DENSE
			                )
			            )
			    )
			
			/* ===================== OTHERS (FIXED) ===================== */
			VAR OthersValue =
			    SWITCH(
			        TRUE(),
			
			        IsCountry,
			            CALCULATE(
			                [GMV_CY_Selection (HY/FY)],
			                FILTER(
			                    ALL('Unique Country'),
			                    'Unique Country'[Country] <> "Others"
			                        && RankValue > TopX
			                )
			            ),
			
			        IsBrand,
			            CALCULATE(
			                [GMV_CY_Selection (HY/FY)],
			                FILTER(
			                    ALL('Unique Brand'),
			                    'Unique Brand'[Brand] <> "Others"
			                        && RankValue > TopX
			                )
			            )
			    )
			
			/* ===================== FLAGS ===================== */
			VAR IsOthers =
			    SWITCH(
			        TRUE(),
			        IsCountry, SELECTEDVALUE('Unique Country'[Country]) = "Others",
			        IsBrand,   SELECTEDVALUE('Unique Brand'[Brand]) = "Others",
			        FALSE
			    )
			
			/* ===================== FINAL ===================== */
			RETURN
			IF(
			    IsOthers,
			    OthersValue,
			    IF(
			        TopX = 0 || RankValue <= TopX,
			        [GMV_CY_Selection (HY/FY)],   -- ✅ keeps correct % split
			        BLANK()
			    )
			)
		lineageTag: 151730a0-1e8e-4ea6-a1f9-fe950971f097

