	measure Sort_TopX_Others_Last =
			
			VAR ViewBySelection = SELECTEDVALUE(ViewBy[ViewBy Fields])
			
			VAR IsCountry = CONTAINSSTRING(ViewBySelection, "Country")
			VAR IsBrand   = CONTAINSSTRING(ViewBySelection, "Brand")
			
			VAR IsOthers =
			    SWITCH(
			        TRUE(),
			        IsCountry, SELECTEDVALUE('Unique Country'[Country]) = "Others",
			        IsBrand,   SELECTEDVALUE('Unique Brand'[Brand]) = "Others"
			    )
			
			RETURN
			IF(IsOthers, 999999, [_CY Emissions])
