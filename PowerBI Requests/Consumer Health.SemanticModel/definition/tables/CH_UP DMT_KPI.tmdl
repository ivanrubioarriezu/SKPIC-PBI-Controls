	column 'E_FY (Year Filter)_Plan' =
			
			VAR FiscalYearPlus1 = YEAR('CH_UP DMT_KPI'[Fiscal_Date]) + 1
			VAR CurrentYear = YEAR(TODAY())
			VAR CurrentMonth = MONTH(TODAY())
			VAR CurrentDay = DAY(TODAY())
			
			RETURN
			FiscalYearPlus1 < CurrentYear ||
			(
			    ((CurrentDay >= 20 && CurrentMonth = 1) || CurrentMonth > 1) &&
			    FiscalYearPlus1 = CurrentYear
			)
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 54920b20-bae5-48a0-b3a3-75696a956bf3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'E_FY (Year Filter) column' =
			
			VAR FiscalYearPlus1 = YEAR('CH_UP DMT_KPI'[Fiscal_Date]) + 1
			VAR CurrentYear = YEAR(TODAY())
			VAR CurrentMonth = MONTH(TODAY())
			VAR CurrentDay = DAY(TODAY())
			
			RETURN
			IF(
			    FiscalYearPlus1 < CurrentYear ||
			    (
			        ((CurrentDay >= 29 && CurrentMonth = 1) || CurrentMonth > 1) &&
			        FiscalYearPlus1 = CurrentYear
			    ),
			    'CH_UP DMT_KPI'[Fiscal_Date],
			    BLANK()
			)
		formatString: General Date
		lineageTag: d2d0af68-9aa7-4997-9d94-1d579fe3ec51
