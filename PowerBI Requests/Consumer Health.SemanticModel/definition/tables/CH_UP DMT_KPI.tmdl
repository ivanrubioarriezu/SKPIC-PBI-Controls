		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_01CY Emissions Final' =
			
			
			
			VAR TopX = SELECTEDVALUE('Ranking Option'[Ranking Option], 0)
			VAR ViewBySelection = SELECTEDVALUE(ViewBy[ViewBy Fields])
			
			VAR IsCountry = CONTAINSSTRING(ViewBySelection, "Country")
			VAR IsBrand   = CONTAINSSTRING(ViewBySelection, "Brand")
			
			/* ✅ Base measure (REMOVE legend only for ranking) */
			VAR BaseMeasure =
			    CALCULATE(
			        [GMV_CY_Selection (HY/FY)],
			        REMOVEFILTERS('CH_UP DMT_KPI'[Pillar_SKU_Class])
			    )
			
			/* ✅ IMPORTANT: Use VALUES to make ranking work per row */
			VAR RankValue =
			    SWITCH(
			        TRUE(),
			        IsCountry,
			            RANKX(
			                VALUES('Unique Country'[Country]),
			                BaseMeasure,
			                ,
			                DESC,
			                DENSE
			            ),
			        IsBrand,
			            RANKX(
			                VALUES('Unique Brand'[Brand]),
			                BaseMeasure,
			                ,
			                DESC,
			                DENSE
			            )
			    )
			
			/* ✅ Current category */
			VAR CurrentCategory =
			    SWITCH(
			        TRUE(),
			        IsCountry, SELECTEDVALUE('Unique Country'[Country]),
			        IsBrand,   SELECTEDVALUE('Unique Brand'[Brand])
			    )
			
			VAR IsOthers = CurrentCategory = "Others"
			
			/* ✅ Others calculation (correct ranking set) */
			VAR OthersValue =
			    SWITCH(
			        TRUE(),
			
			        IsCountry,
			            CALCULATE(
			                [GMV_CY_Selection (HY/FY)],
			                FILTER(
			                    ALL('Unique Country'),
			                    RANKX(
			                        ALL('Unique Country'),
			                        BaseMeasure,
			                        ,
			                        DESC
			                    ) > TopX
			                )
			            ),
			
			        IsBrand,
			            CALCULATE(
			                [GMV_CY_Selection (HY/FY)],
			                FILTER(
			                    ALL('Unique Brand'),
			                    RANKX(
			                        ALL('Unique Brand'),
			                        BaseMeasure,
			                        ,
			                        DESC
			                    ) > TopX
			                )
			            )
			    )
			
			/* ✅ FINAL */
			RETURN
			SWITCH(
			    TRUE(),
			
			    /* ✅ Others row */
			    IsOthers && TopX > 0,
			        OthersValue,
			
			    /* ✅ TopX rows */
			    TopX = 0,
			        [GMV_CY_Selection (HY/FY)],
			
			    RankValue <= TopX,
			        [GMV_CY_Selection (HY/FY)],
			
			    BLANK()
			)
		lineageTag: cfb3aba6-fd3c-436c-88a9-4e962547ca62

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Dynamic ACT CY' = ```
			
			
			
			VAR TopX =
			    SELECTEDVALUE ( 'Ranking Option'[Ranking Option], 0 )
			
