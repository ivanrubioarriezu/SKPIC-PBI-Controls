			            Rank_Brand > TopX
			        )
			    )
			
			/* ===================== CURRENT RANK ===================== */
			
			VAR CurrentRank =
			    SWITCH (
			        TRUE (),
			        ViewBySelection = NAMEOF ( 'Unique Country'[Country] ), Rank_Country,
			        ViewBySelection = NAMEOF ( 'Unique Brand'[Brand] ), Rank_Brand,
			        BLANK()    -- ✅ default required
			    )
			
			/* ===================== IS OTHERS ===================== */
			
			VAR IsOthers =
			    SWITCH (
			        TRUE (),
			        ViewBySelection = NAMEOF ( 'Unique Country'[Country] ),
			            SELECTEDVALUE ( 'Unique Country'[Country] ) = "Others",
			        ViewBySelection = NAMEOF ( 'Unique Brand'[Brand] ),
			            SELECTEDVALUE ( 'Unique Brand'[Brand] ) = "Others",
			        FALSE
