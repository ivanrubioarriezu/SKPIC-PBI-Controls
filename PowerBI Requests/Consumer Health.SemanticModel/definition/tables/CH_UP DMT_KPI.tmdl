	measure '_GMV Selection (CY / PY / BY – HY / FY)' =
			
			VAR PeriodSelected =
			    SELECTEDVALUE (GMV_Selection_Table[Selection])  -- CY / PY / BY
			VAR HYFYSelected =
			    SELECTEDVALUE ( GMV_Selection_Table[Selection] )   -- Half Year / Full Year
			RETURN
			    SWITCH (
			        TRUE(),
			
			        PeriodSelected = "CY" && HYFYSelected = "Half Year", [CY_HY],
			        PeriodSelected = "CY" && HYFYSelected = "Full Year", [CY_FY],
			
			        PeriodSelected = "PY" && HYFYSelected = "Half Year", [PY_HY],
			        PeriodSelected = "PY" && HYFYSelected = "Full Year", [PY_FY],
			
			        PeriodSelected = "BY" && HYFYSelected = "Half Year", [BY_HY],
			        PeriodSelected = "BY" && HYFYSelected = "Full Year", [BY_FY],
			
			        BLANK ()
			    )
		lineageTag: f40f113c-29c0-4818-a037-d309f17dec14

