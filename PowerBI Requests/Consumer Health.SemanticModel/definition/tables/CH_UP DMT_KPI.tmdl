	measure 'E_FY (Year Filter)' =
			
			VAR Selection = SELECTEDVALUE('GMV_Selection_Table'[Selection])
			VAR FiscalDate = MAX('CH_UP DMT_KPI'[Fiscal_Date])
			VAR FiscalYearPlus1 = YEAR(FiscalDate) + 1
			VAR CurrentYear = YEAR(TODAY())
			VAR CurrentMonth = MONTH(TODAY())
			VAR CurrentDay = DAY(TODAY())
			
			RETURN
			IF(
			    Selection = "Full Year" &&
			    (
			        FiscalYearPlus1 < CurrentYear ||
			        (
			            ((CurrentDay >= 29 && CurrentMonth = 1) || CurrentMonth > 1) &&
			            FiscalYearPlus1 = CurrentYear
			        )
			    ),
			    FiscalDate,
			    BLANK()
			)
		formatString: General Date
		lineageTag: fce2336e-a876-4ee1-a838-587cb8e15998

	measure 'E_HY  (Year Filter)' =
			
			
			VAR Selection = SELECTEDVALUE('GMV_Selection_Table'[Selection])
			VAR FiscalDate = MAX('CH_UP DMT_KPI'[Fiscal_Date])
			VAR FiscalYear = YEAR(FiscalDate)
			VAR CurrentYear = YEAR(TODAY())
			VAR CurrentMonth = MONTH(TODAY())
			VAR CurrentDay = DAY(TODAY())
			
			RETURN
			IF(
			    Selection = "HY1" &&
			    (
			        (
			            (CurrentDay >= 25 && CurrentMonth = 7) || CurrentMonth > 7
			        ) && FiscalYear = CurrentYear
			    ) || FiscalYear < CurrentYear,
			    FiscalDate,
			    BLANK()
			)
		formatString: General Date
		lineageTag: e6033690-9230-4501-b7a7-5d6ee9104a75

