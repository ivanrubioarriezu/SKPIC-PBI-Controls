	measure 'Dynamic ACT CY' = ```
			
			VAR TopBottomValue = SELECTEDVALUE('Top/Bottom'[Value])        // "Top" or "Bottom"
			VAR RankingLimit = SELECTEDVALUE('Ranking Option'[Ranking Option])
			VAR ViewBySelection = SELECTEDVALUE('ViewBy'[ViewBy Fields])
			
			VAR IsCountry = CONTAINSSTRING(ViewBySelection, "Country")
			VAR IsBrand = CONTAINSSTRING(ViewBySelection, "Brand")
			
			// Compute rank for current item
			VAR CurrentRank =
			    IF(
			        IsCountry,
			        IF(TopBottomValue = "Top",
			            RANKX(ALL('Unique Country'[Country]), [GMV_CY_Selection (HY/FY)], , DESC),
			            RANKX(ALL('Unique Country'[Country]), [GMV_CY_Selection (HY/FY)], , ASC)
			        ),
			        
			            IF(TopBottomValue = "Top",
			                RANKX(ALL('Unique Brand'[Brand]), [GMV_CY_Selection (HY/FY)], , DESC),
			                RANKX(ALL('Unique Brand'[Brand]), [GMV_CY_Selection (HY/FY)], , ASC)
			            )
			        )
			    
			VAR TotalRows =
			    IF(IsCountry,
			        COUNTROWS(ALL('Unique Country'[Country])),
			        IF(IsCountry,
			            COUNTROWS(ALL('Unique Brand'[Brand])), BLANK()
			           
			    ))
			// Calculate Others dynamically
			VAR OthersValue =
			    IF(
			        IsCountry,
			        CALCULATE(
			            [GMV_CY_Selection (HY/FY)],
			            FILTER(
			                ALL('Unique Country'[Country]),
			                IF(TopBottomValue = "Top",
			                    RANKX(ALL('Unique Country'[Country]), [GMV_CY_Selection (HY/FY)], , DESC) > RankingLimit,
			                    RANKX(ALL('Unique Country'[Country]), [GMV_CY_Selection (HY/FY)], , ASC) > RankingLimit
			                )
			            )
			        ),
			        
			            CALCULATE(
			                [GMV_CY_Selection (HY/FY)],
			                FILTER(
			                    ALL('Unique Brand'[Brand]),
			                    IF(TopBottomValue = "Top",
			                        RANKX(ALL('Unique Brand'[Brand]), [GMV_CY_Selection (HY/FY)], , DESC) > RankingLimit,
			                        RANKX(ALL('Unique Brand'[Brand]), [GMV_CY_Selection (HY/FY)], , ASC) > RankingLimit
			                    )
			                )
			            )
			        )
			    
			
			RETURN
			IF(
			    (IsCountry && SELECTEDVALUE('Unique Country'[Country]) = "Others") ||
			    (IsBrand && SELECTEDVALUE('Unique Brand'[Brand]) = "Others"),
			    OthersValue,
			    IF(
			        TopBottomValue = "Top",
			        IF(CurrentRank <= RankingLimit, [GMV_CY_Selection (HY/FY)], BLANK()),
			        IF(CurrentRank <= RankingLimit + 1, [GMV_CY_Selection (HY/FY)], BLANK())
			    )
			)
			
			```
		lineageTag: a260c36e-5f7a-43dc-9e85-353574254ed3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ViewBy param text' = MAX('ViewBy'[ViewBy])
		lineageTag: efbfb9bc-41f8-444f-9301-2832c6c4254a

	measure 'BAR chart Dynamic Measure' =
			
			VAR TopBottomValue = SELECTEDVALUE('Top/Bottom'[Value])        // "Top" or "Bottom"
			VAR RankingLimit = SELECTEDVALUE('Ranking Option'[Ranking Option])
			VAR ViewBySelection = SELECTEDVALUE('ViewBy'[ViewBy Fields])
			VAR SortBySelection = SELECTEDVALUE('Sort by:'[Sort by:])
			VAR HYFYSelection = SELECTEDVALUE('GMV_Selection_Table'[Selection])
			
			// Determine sort measure
			VAR SortMeasure =
			    SWITCH(
			        TRUE(),
			        SortBySelection = "ACT CY", [GMV_CY_Selection (HY/FY)],
			        SortBySelection = "ACT PY", [GMV_PY_Selection (HY/FY)],
			        SortBySelection = "ACT BY 2019", [GMV_BY_Selection (HY/FY)],
			        BLANK()
			    )
			
			// COUNTRY TABLE
			VAR CountryTable =
			    ADDCOLUMNS(
			        VALUES('CH_UP DMT_KPI'[Country]),
			        "SortValue", CALCULATE(SortMeasure),
			        "Rank",
			            SWITCH(
			                TRUE(),
			                TopBottomValue = "Top", RANKX(ALL('CH_UP DMT_KPI'[Country]), CALCULATE(SortMeasure), , DESC),
			                TopBottomValue = "Bottom", RANKX(ALL('CH_UP DMT_KPI'[Country]), CALCULATE(SortMeasure), , ASC)
			            )
			    )
			
			// BRAND TABLE
			VAR BrandTable =
			    ADDCOLUMNS(
			        VALUES('CH_UP DMT_KPI'[Brand]),
			        "SortValue", CALCULATE(SortMeasure),
			        "Rank",
			            SWITCH(
			                TRUE(),
			                TopBottomValue = "Top", RANKX(ALL('CH_UP DMT_KPI'[Brand]), CALCULATE(SortMeasure), , DESC),
			                TopBottomValue = "Bottom", RANKX(ALL('CH_UP DMT_KPI'[Brand]), CALCULATE(SortMeasure), , ASC)
			            )
			    )
			
			// Apply ranking filter
			VAR IsInTopBottom =
			    SWITCH(
			        TRUE(),
			        ViewBySelection = "Country",
			            MAXX(FILTER(CountryTable, [Rank] <= RankingLimit), 1),
			        ViewBySelection = "Brand",
			            MAXX(FILTER(BrandTable, [Rank] <= RankingLimit), 1)
			    )
			
			RETURN
			IF(IsInTopBottom = 1, SortMeasure, BLANK())
		lineageTag: e4ffdb0f-80d2-4f3d-891b-43ff295a02cd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Dynamic ACT CY (SKU Legend Safe)' =
			
			VAR TopBottomValue = SELECTEDVALUE('Top/Bottom'[Value])        // "Top" or "Bottom"
			VAR RankingLimit = COALESCE(SELECTEDVALUE('Ranking Option'[Ranking Option]), 10)
			VAR ViewBySelection = SELECTEDVALUE('ViewBy'[ViewBy Fields])
			
			VAR IsCountry = CONTAINSSTRING(ViewBySelection, "Country")
			VAR IsBrand = CONTAINSSTRING(ViewBySelection, "Brand")
			
			VAR CurrentCountry = SELECTEDVALUE('Unique Country'[Country])
			VAR CurrentBrand = SELECTEDVALUE('Unique Brand'[Brand])
			VAR CurrentSKU = SELECTEDVALUE('CH_UP DMT_KPI'[Pillar_SKU_Class]) // SKU granularity
			
			// Rank Country or Brand
			VAR CountryRank =
			    IF(
			        IsCountry,
			        IF(
			            TopBottomValue = "Top",
			            RANKX(
			                ALL('Unique Country'[Country]),
			                CALCULATE([GMV_CY_Selection (HY/FY)]),
			                ,
			                DESC
			            ),
			            RANKX(
			                ALL('Unique Country'[Country]),
			                CALCULATE([GMV_CY_Selection (HY/FY)]),
			                ,
			                ASC
			            )
			        ),
			        BLANK()
			    )
			
			VAR BrandRank =
			    IF(
			        IsBrand,
			        IF(
			            TopBottomValue = "Top",
			            RANKX(
			                ALL('Unique Brand'[Brand]),
			                CALCULATE([GMV_CY_Selection (HY/FY)]),
			                ,
			                DESC
			            ),
			            RANKX(
			                ALL('Unique Brand'[Brand]),
			                CALCULATE([GMV_CY_Selection (HY/FY)]),
			                ,
			                ASC
			            )
			        ),
			        BLANK()
			    )
			
			// Determine if current SKU belongs to a ranked Country/Brand
			VAR IsRanked =
			    IF(
			        IsCountry,
			        CountryRank <= RankingLimit,
			        IF(IsBrand,
			            BrandRank <= RankingLimit,
			            FALSE
			        )
			    )
			
			// Final Output
			RETURN
			IF(
			    IsRanked,
			    [GMV_CY_Selection (HY/FY)],
			    BLANK()
			)
		lineageTag: 359d4016-0e92-49e3-afb0-434c72ad18cb

