			        [GMV_CY_Selection (HY/FY)],
			        ,
			        DESC,
			        DENSE
			    )
			
			VAR Rank_Brand =
			    RANKX (
			        FILTER (
			            ALL ( 'Unique Brand'[Brand] ),
			            'Unique Brand'[Brand] <> "Others"
			        ),
			        [GMV_CY_Selection (HY/FY)],
			        ,
			        DESC,
			        DENSE
			    )
			
			/* ===================== OTHERS ===================== */
			
			VAR Others_Country =
			    CALCULATE (
			        [GMV_CY_Selection (HY/FY)],
			        FILTER ( ALL ( 'Unique Country'[Country] ), Rank_Country > TopX )
