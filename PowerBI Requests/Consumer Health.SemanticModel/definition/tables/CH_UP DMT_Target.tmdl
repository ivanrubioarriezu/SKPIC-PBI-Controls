	partition 'CH_UP DMT_Target' = m
		mode: import
		source = ```
				let
				    Source = Value.NativeQuery(Databricks.Catalogs(hostname, httpPath, [Catalog=Catalogue, Database=null, EnableAutomaticProxyDiscovery="enabled"]){[Name=Catalogue,Kind="Database"]}[Data], 
				    "SELECT
				    division AS Division,
				    year AS Year,
				    geographical_location AS GeographicalLocation,
				    target AS Target,
				    target_ytd AS TargetYtd,
				    actual_year AS ActualYear,
				    is_preliminary AS IsPreliminary,
				    valid_from AS ValidFrom,
				    valid_to AS ValidTo
				FROM generaldiscovery_intfc_sustainability_r.sus_skpic_ch_up_dmt_target_intfc_view
				WHERE is_preliminary = FALSE"
				    , null, [EnableFolding=true])
				in
				    Source
				```

