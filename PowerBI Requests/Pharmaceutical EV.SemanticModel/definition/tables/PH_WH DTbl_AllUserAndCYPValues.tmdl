	column 'M_FY (Year Filter)_Plan' =
			
			VAR FiscalYearPlusOne = YEAR('PH_WH DTbl_AllUserAndCYPValues'[Fiscal_Date]) + 1
			VAR CurrentYear = YEAR(TODAY())
			VAR CurrentMonth = MONTH(TODAY())
			VAR CurrentDay = DAY(TODAY())
			
			RETURN
			    FiscalYearPlusOne < CurrentYear
			    ||
			    (
			        (
			            (CurrentDay >= 25 && CurrentMonth = 2)
			            || CurrentMonth > 2
			        )
			        && FiscalYearPlusOne = CurrentYear
			    )
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 9d0a8cea-5471-482c-a7c8-cb99122fd57c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

