		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ACT_CY_Label = ```
			
			
			VAR Selection =
			    SELECTEDVALUE('HY / FY selection'[Selection], "Full Year")  // Default to Full Year
			VAR YearText =
			    FORMAT(('PH_WH DTbl_AllUserAndCYPValues'[Year Label]), "####") // Ensure numeric year
			RETURN
			    SWITCH(
			        TRUE(),
			        Selection = "Full Year", YearText,
			        Selection = "Half Year", YearText & " HY1",
			      
			        YearText // Fallback
			    )
			
			```
