	partition 'PH_WH DTbl_AllUserAndCYPValues' = m
		mode: import
		source = ```
				let
				    Source = Value.NativeQuery(Databricks.Catalogs(hostname, httpPath, [Catalog=Catalogue, Database=null, EnableAutomaticProxyDiscovery="enabled"]){[Name=Catalogue,Kind="Database"]}[Data], 
				    "SELECT
				    fiscal_year AS Fiscal_Year,
				    fiscal_month AS Fiscal_Month,
				    fiscal_period AS Fiscal_Period,
				    geographical_location AS Geographical_Location,
				    income_group AS Income_Group,
				    product_description AS Product_Description,
				    product_category_description AS Product_Category_Description,
				    sector AS Sector,
				    user_value_actual AS User_Value_Actual,
				    user_value_actual_ytd AS User_Value_Actual_Ytd,
				    user_value_order_quantity AS User_Value_Order_Quantity,
				    user_value_order_quantity_ytd AS User_Value_Order_Quantity_Ytd,
				    cyp_value_actual AS Cyp_Value_Actual,
				    cyp_value_actual_ytd AS Cyp_Value_Actual_Ytd,
				    cyp_value_order_quantity AS Cyp_Value_Order_Quantity,
				    cyp_value_order_quantity_ytd AS Cyp_Value_Order_Quantity_Ytd,
				    user_value_plan_year_total AS User_Value_Plan_Year_Total,
				    cyp_value_plan_year_total AS Cyp_Value_Plan_Year_Total,
				    user_value_forecast_year_total AS User_Value_Forecast_Year_Total,
				    cyp_value_forecast_year_total AS Cyp_Value_Forecast_Year_Total,
				    user_value_actual_pytd AS User_Value_Actual_Pytd,
				    cyp_value_actual_pytd AS Cyp_Value_Actual_Pytd,
				    cyp_value_actual_bfy_not_used AS Cyp_Value_Actual_Bfy_Not_Used,
				    cyp_value_actual_bhy_not_used AS Cyp_Value_Actual_Bhy_Not_Used,
				    cyp_value_actual_bytd_not_used AS Cyp_Value_Actual_Bytd_Not_Used,
				    cyp_value_actual_pfy_not_used AS Cyp_Value_Actual_Pfy_Not_Used,
				    cyp_value_actual_phy_not_used AS Cyp_Value_Actual_Phy_Not_Used,
				    user_value_actual_bfy AS User_Value_Actual_Bfy,
				    user_value_actual_bhy AS User_Value_Actual_Bhy,
				    user_value_actual_bytd_not_used AS User_Value_Actual_Bytd_Not_Used,
				    user_value_actual_pfy AS User_Value_Actual_Pfy,
				    user_value_actual_phy AS User_Value_Actual_Phy,
				    region AS Region,
				    fiscal_date AS Fiscal_Date,
				    is_preliminary AS Is_Preliminary,
				    valid_from AS Valid_From,
				    valid_to AS Valid_To,
				    user_value_forecast1_ytd AS User_Value_Forecast1_Ytd,
				    cyp_value_forecast1_ytd AS Cyp_Value_Forecast1_Ytd,
				    user_value_forecast2_ytd AS User_Value_Forecast2_Ytd,
				    cyp_value_forecast2_ytd AS Cyp_Value_Forecast2_Ytd,
				    user_value_forecast3_ytd AS User_Value_Forecast3_Ytd,
				    cyp_value_forecast3_ytd AS Cyp_Value_Forecast3_Ytd,
				    user_value_forecast1_year_total AS User_Value_Forecast1_Year_Total,
				    cyp_value_forecast1_year_total AS Cyp_Value_Forecast1_Year_Total,
				    user_value_forecast2_year_total AS User_Value_Forecast2_Year_Total,
