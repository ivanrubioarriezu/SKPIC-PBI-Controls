	measure 'E_Latest FY  Forecast Selection' = ```
			
			VAR FiscalYear = YEAR(MAX('PH_WH DTbl_AllUserAndCYPValues'[Fiscal_Date]))
			VAR CurrentYear = YEAR(TODAY())
			VAR CurrentMonth = MONTH(TODAY())
			VAR CurrentDay = DAY(TODAY())
			
			RETURN
			    SWITCH(
			        TRUE(),
			        
			        // Condition 1: Fiscal year < current year
			        FiscalYear < CurrentYear, [FC3],
			        
			        // Condition 2: Complex FC3 logic
			        (
			            ((CurrentDay >= 15 && CurrentMonth = 11) || CurrentMonth > 11)
			            ||
			            (
			                ((CurrentDay <= 14 && CurrentMonth = 5) || CurrentMonth < 5)
			                && FiscalYear + 1 = CurrentYear
			            )
			        ), [FC3],
			        
			        // Condition 3: FC2 logic
			        (
			            ((CurrentDay >= 15 && CurrentMonth = 8) || CurrentMonth > 8)
			            ||
			            ((CurrentDay <= 14 && CurrentMonth = 11) || CurrentMonth > 11)
			        ), [FC2],
			        
			        // Condition 4: FC1 logic
			        (
			            ((CurrentDay >= 15 && CurrentMonth = 5) || CurrentMonth > 5)
			            ||
			            ((CurrentDay <= 14 && CurrentMonth = 8) || CurrentMonth > 8)
			        ), [FC1],
			        
			        BLANK()
			    )
			```
		lineageTag: bef33c8d-7ee4-4548-93be-c0e154828344

		annotation PBI_FormatHint = {"isGeneralNumber":true}

