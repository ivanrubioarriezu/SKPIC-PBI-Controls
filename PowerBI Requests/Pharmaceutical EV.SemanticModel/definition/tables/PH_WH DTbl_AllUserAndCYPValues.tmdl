	measure _M_Plan_Full_Year = ```
			
			
			
			-- Returns values for Jan or Jun, ignoring year gate
			
			SUMX(
			    FILTER(
			        'PH_WH DTbl_AllUserAndCYPValues',
			        'PH_WH DTbl_AllUserAndCYPValues'[Fiscal_Month] IN { 1, 6 }
