	column 'Year Label' = YEAR('PH_WH DTbl_AllUserAndCYPValues'[Fiscal_Date])
		formatString: 0
		lineageTag: 4264eaa7-1263-4458-a6d2-e20b1183d882
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'E_FY (Year Filter)_Plan' =
			
			VAR FiscalYear = YEAR('PH_WH DTbl_AllUserAndCYPValues'[Fiscal_Date])
			VAR CurrentYear = YEAR(TODAY())
			VAR CurrentMonth = MONTH(TODAY())
			VAR CurrentDay = DAY(TODAY())
			
			RETURN
			    FiscalYear + 1 <= CurrentYear
			    ||
			    (
			        (
			            (CurrentDay >= 10 && CurrentMonth = 2)
			            || CurrentMonth > 2
			        )
			        && FiscalYear = CurrentYear
			    )
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: ee862338-ae31-4eee-96df-b5da45530481
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Region/Product Category' =
			
			SWITCH(
			    SELECTEDVALUE('View by'[View by Fields]),
			    "Region", 'PH_WH DTbl_AllUserAndCYPValues'[Region],
			    "Product Category", 'PH_WH DTbl_AllUserAndCYPValues'[Product Category],
			    BLANK()
			)
		lineageTag: f31f3dcb-247f-40e1-b442-a33d5669de46
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column M_Latest_Forecast_Label = ```
			
			VAR TodayDay = DAY(TODAY())
			VAR TodayMonth = MONTH(TODAY())
			VAR TodayYear = YEAR(TODAY())
			VAR FiscalYear = YEAR('PH_WH DTbl_AllUserAndCYPValues'[Fiscal_Date])
			RETURN
			IF (
			    FiscalYear <> TodayYear,
			    "FC3",
			    IF (
			        (
			            ((TodayDay >= 30 && TodayMonth = 11) || TodayMonth > 11)
			            ||
			            (((TodayDay <= 19 && TodayMonth = 2) || TodayMonth < 2) && FiscalYear + 1 = TodayYear)
			        ),
			        "FC3",
			        IF (
			            (
			                ((TodayDay >= 30 && TodayMonth = 8) || TodayMonth > 8)
			                ||
			                ((TodayDay <= 29 && TodayMonth = 11) || TodayMonth > 11)
			            ),
			            "FC2",
			            IF (
			                (
			                    ((TodayDay >= 30 && TodayMonth = 5) || TodayMonth > 5)
			                    ||
			                    ((TodayDay <= 29 && TodayMonth = 8) || TodayMonth > 8)
			                ),
			                "FC1",
			                BLANK()
			            )
			        )
			    )
			)
			
			```
		lineageTag: 9e5eb8a2-03a6-4c27-9883-e3dcdc884b33
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column M_Forecast_Label = ```
			
			"FY " &
			[M_Latest_Forecast_Label] &
			" " &
			FORMAT([Year Label], "0")
			
			```
		lineageTag: 250c1ad7-0911-46ce-8984-5d1a827b18d2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column M_Latest_Forecast_Selection_Column = ```
			
			VAR TodayDay = DAY(TODAY())
			VAR TodayMonth = MONTH(TODAY())
			VAR TodayYear = YEAR(TODAY())
			VAR FiscalYear = YEAR('PH_WH DTbl_AllUserAndCYPValues'[Fiscal_Date])
			RETURN
			SWITCH (
			    TRUE(),
			    FiscalYear < TodayYear, "FC3",
			    (
			        ((TodayDay >= 30 && TodayMonth = 11) || TodayMonth > 11)
			        ||
			        (((TodayDay <= 29 && TodayMonth = 5) || TodayMonth < 5) && FiscalYear + 1 = TodayYear)
			    ), "FC3",
			    (
			        ((TodayDay >= 30 && TodayMonth = 8) || TodayMonth > 8)
			        ||
			        ((TodayDay <= 29 && TodayMonth = 11) || TodayMonth > 11)
			    ), "FC2",
			    (
			        ((TodayDay >= 30 && TodayMonth = 5) || TodayMonth > 5)
			        ||
			        ((TodayDay <= 29 && TodayMonth = 8) || TodayMonth > 8)
			    ), "FC1",
			    "FC3"   // Default fallback (Tableau never returns blank)
			)
			
			```
		lineageTag: 1e071b78-f42e-45db-b988-d1437d5f187c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Channel sort' =
			
			
			SWITCH (
			    TRUE(),
			
			    'PH_WH DTbl_AllUserAndCYPValues'[Sector] = "Commercial",
			        1,   -- Local Country Contribution (1st)
			
			    'PH_WH DTbl_AllUserAndCYPValues'[Sector] = "GHCP",
			        2,   -- Global HQ Contribution through Supply (2nd)
			
			    'PH_WH DTbl_AllUserAndCYPValues'[Sector] = "Partnership",
			        3,   -- Partnership (3rd)
			
			    BLANK()
			)
		formatString: 0
		lineageTag: 69032d26-eb92-467a-808e-5f4753b98a05
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

