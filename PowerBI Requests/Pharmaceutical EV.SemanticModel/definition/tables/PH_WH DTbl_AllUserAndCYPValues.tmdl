	measure '_M_FY(Year Filter)_Plan' = ```
			
			
			-- Measure: Year gate (optional – for display/debug)
			
			VAR CurrentYear  = YEAR ( TODAY () )
			VAR CurrentMonth = MONTH( TODAY() )
			VAR CurrentDay   = DAY  ( TODAY() )
			VAR FiscalYearPlusOne =
			    YEAR( SELECTEDVALUE( 'PH_WH DTbl_AllUserAndCYPValues'[Fiscal_Date] ) ) + 1
			RETURN
			    FiscalYearPlusOne < CurrentYear
			    ||
			    (
			        ( ( CurrentDay >= 25 && CurrentMonth = 2 ) || CurrentMonth > 2 )
			        && FiscalYearPlusOne = CurrentYear
			    )
			
			```
		formatString: """TRUE"";""TRUE"";""FALSE"""
