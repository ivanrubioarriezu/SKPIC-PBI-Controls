	measure 'Viewby channel label' = "Reach " &  MAX('View by channel'[View by channel]) & " - new user per month"
		lineageTag: f8246a41-7c20-4ff2-ae5a-2518aefb5331

	measure 'Dynamic ACTUAL' = ```
			
			VAR Result=
			VAR TopBottomValue = SELECTEDVALUE('Top/Bottom'[Value])        // "Top" or "Bottom"
			VAR RankingLimit = SELECTEDVALUE('Ranking Option'[Ranking Option])
			VAR ViewBySelection = SELECTEDVALUE('View by channel'[View by channel Fields])
			
			VAR IsCountry = CONTAINSSTRING(ViewBySelection, "Country")
			VAR IsProductCategory = CONTAINSSTRING(ViewBySelection, "Product Category")
			VAR IsProduct = CONTAINSSTRING(ViewBySelection, "Product")
			// Compute rank for current item
			VAR CurrentRank =
			    IF(
			        IsCountry,
			        IF(TopBottomValue = "Top",
			            RANKX(ALL('Unique Country'[Geographical_Location]), [Actual], , DESC),
			            RANKX(ALL('Unique Country'[Geographical_Location]), [Actual], , ASC)
			        ),
			        IF(
			        IsProductCategory,
			        IF(TopBottomValue = "Top",
			            RANKX(ALL('Unique Product Category'[Product Category]), [Actual], , DESC),
			            RANKX(ALL('Unique Product Category'[Product Category]), [Actual], , ASC)
			        ),
			            IF(TopBottomValue = "Top",
			                RANKX(ALL('Unique Product'[Product_Description]), [Actual], , DESC),
			                RANKX(ALL('Unique Product'[Product_Description]), [Actual], , ASC)
			            )
			        ))
			    
				
				
				
				
				
				
				
			VAR TotalRows =
			    IF(IsCountry,
			        COUNTROWS(ALL('Unique Country'[Geographical_Location])),
			        IF(IsProductCategory,
			            COUNTROWS(ALL('Unique Product Category'[Product Category])),
			      IF(IsProduct,
			            COUNTROWS(ALL('Unique Product'[Product_Description])), BLANK()     
			    )))
				
				
				
			// Calculate Others dynamically
			VAR OthersValue =
			    IF(
			        IsCountry,
			        CALCULATE(
			            [Actual],
			            FILTER(
			                ALL('Unique Country'[Geographical_Location]),
			                IF(TopBottomValue = "Top",
			                    RANKX(ALL('Unique Country'[Geographical_Location]), [Actual], , DESC) > RankingLimit,
			                    RANKX(ALL('Unique Country'[Geographical_Location]), [Actual], , ASC) > RankingLimit
			                )
			            )
			        ),
			        IF(
			        IsProductCategory,
			        CALCULATE(
			            [Actual],
			            FILTER(
			                ALL('Unique Product Category'[Product Category]),
			                IF(TopBottomValue = "Top",
			                    RANKX(ALL('Unique Product Category'[Product Category]), [Actual], , DESC) > RankingLimit,
			                    RANKX(ALL('Unique Product Category'[Product Category]), [Actual], , ASC) > RankingLimit
			                )
			            )
			        ),
					
					
			            CALCULATE(
			                [Actual],
			                FILTER(
			                    ALL('Unique Product'[Product_Description]),
			                    IF(TopBottomValue = "Top",
			                        RANKX(ALL('Unique Product'[Product_Description]), [Actual], , DESC) > RankingLimit,
			                        RANKX(ALL('Unique Product'[Product_Description]), [Actual], , ASC) > RankingLimit
			                    )
			                )
			            )
			        ))
			    
			
			
			
			
			
			RETURN
			IF(
			    (IsCountry && SELECTEDVALUE('Unique Country'[Geographical_Location]) = "Others") ||
			    (IsProductCategory && SELECTEDVALUE('Unique Product Category'[Product Category]) = "Others")||
				(IsProduct && SELECTEDVALUE('Unique Product'[Product_Description]) = "Others"),
				
			    OthersValue,
			    IF(
			        TopBottomValue = "Top",
			        IF(CurrentRank <= RankingLimit, [Actual], BLANK()),
			        IF(CurrentRank <= RankingLimit + 1, [Actual], BLANK())
					
					
			    )
			)
			RETURN
			IF( ISFILTERED('PH_WH DTbl_AllUserAndCYPValues'[Channel]),Result,BLANK())
			```
		lineageTag: c3c8257b-f52e-4433-b3e3-0ddf78bd9441

		annotation PBI_FormatHint = {"isGeneralNumber":true}

