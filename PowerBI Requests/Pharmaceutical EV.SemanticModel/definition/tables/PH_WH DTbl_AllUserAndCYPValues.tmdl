			    'PH_WH DTbl_AllUserAndCYPValues'[Product_Category_Description]= "5-year IUD",6,
			    'PH_WH DTbl_AllUserAndCYPValues'[Product_Category_Description]= "Implant",7,
			    'PH_WH DTbl_AllUserAndCYPValues'[Product_Category_Description]= "8-year IUS",8,
			    'PH_WH DTbl_AllUserAndCYPValues'[Product_Category_Description]= "not assigned",9,
			   
			
			    BLANK()
			)
			```
