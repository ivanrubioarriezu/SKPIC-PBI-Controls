table 'PH_WH DTbl_Target'
	lineageTag: 6036b93d-182b-4665-95d0-d37828aacbec

	measure 'E_FY (Year Filter)' = ```
			
			VAR CurrentYear = YEAR(TODAY())
			VAR CurrentMonth = MONTH(TODAY())
			VAR CurrentDay = DAY(TODAY())
			VAR YearV = SELECTEDVALUE('PH_WH DTbl_Target'[Year])
			RETURN
			IF (
			    YearV + 1 < CurrentYear ||
			    (
			        (
			            (CurrentMonth = 1 && CurrentDay >= 29) || 
			            (CurrentMonth > 1)
			        ) &&
			        (YearV + 1 = CurrentYear)
			    )
			,
			1,
			0
			)
			```
		formatString: 0
		lineageTag: 8174d1fe-c985-4eb6-9c5a-3392a189cd5c

	measure 'Target in Millions' =
			
			SUM('PH_WH DTbl_Target'[Target])/1000000
