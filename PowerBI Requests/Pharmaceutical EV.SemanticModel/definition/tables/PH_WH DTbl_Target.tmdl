				    "SELECT
				    year AS Year,
				    target AS Target,
				    user_ytd AS User_Ytd,
				    cyp_ytd AS Cyp_Ytd,
				    is_preliminary AS Is_Preliminary,
				    valid_from AS Valid_From,
				    valid_to AS Valid_To
				FROM generaldiscovery_intfc_sustainability_r.sus_skpic_ph_wh_dmt_target_intfc_view
				where is_preliminary = FALSE"
				    , null, [EnableFolding=true])
				in
