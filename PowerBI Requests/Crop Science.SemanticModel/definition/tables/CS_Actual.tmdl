	measure E_Latest_Forecast_Selection = ```
			
			VAR TodayDay = DAY(TODAY())
			VAR TodayMonth = MONTH(TODAY())
			VAR TodayYear = YEAR(TODAY())
			VAR FiscalYear = YEAR(MAX('CS_Actual'[Fiscal_Date]))
			RETURN
			IF(
			    FiscalYear < TodayYear,
			    SUM([Farmer_FC3_Full_Year]),
			    IF(
			        (
			            (
			                (TodayDay >= 25 && TodayMonth = 11) || TodayMonth > 11
			            )
			            ||
			            (
			                ((TodayDay <= 24 && TodayMonth = 5) || TodayMonth < 5)
			                && FiscalYear + 1 = TodayYear
			            )
			        ),
			        SUM([Farmer_FC3_Full_Year]),
			        IF(
			            (
			                ((TodayDay >= 25 && TodayMonth = 8) || TodayMonth > 8)
			                ||
			                ((TodayDay <= 24 && TodayMonth = 11) || TodayMonth > 11)
			            ),
			            SUM([Farmer_FC2_Full_Year]),
			            IF(
			                (
			                    ((TodayDay >= 25 && TodayMonth = 5) || TodayMonth > 5)
			                    ||
			                    ((TodayDay <= 24 && TodayMonth = 8) || TodayMonth > 8)
			                ),
			                SUM([Farmer_FC1_Full_Year]),
			                BLANK()
			            )
			        )
			    )
			)
			
			```
		lineageTag: 22aff602-5d40-48b9-abb1-03fdc9f37c91

