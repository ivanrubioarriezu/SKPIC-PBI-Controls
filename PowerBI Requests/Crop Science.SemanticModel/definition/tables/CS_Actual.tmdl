	column M_Plan_Filter =
			
			VAR TodayDay = DAY(TODAY())
			VAR TodayMonth = MONTH(TODAY())
			VAR TodayYear = YEAR(TODAY())
			VAR FiscalYear = YEAR('CS_Actual'[Fiscal_Date])
			RETURN
			IF(
			    (
			        (
			            (TodayDay <= 25 && TodayMonth = 2) || (TodayMonth < 2)
			        )
			        && FiscalYear = TodayYear
			    )
			    || (FiscalYear < TodayYear),
			    TRUE(),
			    FALSE()
			)
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 12b71f7c-059c-4b3f-81f8-983d30ff4453
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column M_Plan_Label = ```
			
			IF(
			    [M_Plan_Filter],
			    "FY Plan " & FORMAT([Year Label] + 1, "0"),
			    "FY Plan " & FORMAT([Year Label], "0")
			)
			
