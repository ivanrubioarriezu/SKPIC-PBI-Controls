		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'E_Forecast_Full_Year Dynamic' = ```
			
			
			VAR TopBottomValue =
			    SELECTEDVALUE ( 'Top/Bottom'[Value] )          /* "Top" or "Bottom" */
			
			VAR RankingLimit =
			    VALUE ( SELECTEDVALUE ( 'Ranking Option EV'[Ranking Option EV], 10 ) )
			
			VAR ViewBySelection =
			    SELECTEDVALUE ( 'View by'[View by Fields] )
			
			/* Dimension flags (as in your measure) */
			VAR IsCluster               = CONTAINSSTRING ( ViewBySelection, "Cluster" )
			VAR IsCountry               = CONTAINSSTRING ( ViewBySelection, "Country" )
			VAR IsCropGroup             = CONTAINSSTRING ( ViewBySelection, "Crop_Main_Group_Description" )
			VAR IsCountryCropIndication = CONTAINSSTRING ( ViewBySelection, "Country-Crop-Indication" )
			VAR IsCountryIndication     = CONTAINSSTRING ( ViewBySelection, "Country-Indication" )
			VAR IsIndication            = CONTAINSSTRING ( ViewBySelection, "Indication" )
			
			/* -------------------- Country-Crop-Indication (Specialized) -------------------- */
			VAR RankTable_CCI =
			    ALL ( 'Unique Country-Crop-Indication'[Country-Crop-Indication] )
			
			VAR RankDesc_CCI =
			    RANKX ( RankTable_CCI, [E_Forecast_Full_Year], , DESC )
			VAR RankAsc_CCI  =
			    RANKX ( RankTable_CCI, [E_Forecast_Full_Year], , ASC )
			
			VAR CurrentRank_CCI =
			    IF ( TopBottomValue = "Top", RankDesc_CCI, RankAsc_CCI )
			
			VAR OthersValue_CCI =
			    CALCULATE (
			        [E_Forecast_Full_Year],
			        FILTER (
			            RankTable_CCI,
			            IF ( TopBottomValue = "Top", RankDesc_CCI > RankingLimit, RankAsc_CCI > RankingLimit )
			        )
			    )
			
			VAR IsOthers_CCI =
			    SELECTEDVALUE ( 'Unique Country-Crop-Indication'[Country-Crop-Indication] ) = "Others"
			
			VAR Result_CCI =
			    IF (
			        IsOthers_CCI,
			        OthersValue_CCI,
			        IF ( CurrentRank_CCI <= RankingLimit, [E_Forecast_Full_Year], BLANK () )
			    )
			
			/* -------------------- Other dimensions (unchanged logic) -------------------- */
			VAR CurrentRank_Other =
			    SWITCH (
			        TRUE (),
			        IsCluster,
			            IF (
			                TopBottomValue = "Top",
			                RANKX ( ALL ( 'Unique Cluster'[Cluster] ), [E_Forecast_Full_Year], , DESC ),
			                RANKX ( ALL ( 'Unique Cluster'[Cluster] ), [E_Forecast_Full_Year], , ASC )
			            ),
			        IsCountry,
			            IF (
			                TopBottomValue = "Top",
			                RANKX ( ALL ( 'Unique Country'[Country] ), [E_Forecast_Full_Year], , DESC ),
			                RANKX ( ALL ( 'Unique Country'[Country] ), [E_Forecast_Full_Year], , ASC )
			            ),
			        IsCropGroup,
			            IF (
			                TopBottomValue = "Top",
			                RANKX (
			                    ALL ( 'Unique Crop main group'[Crop_Main_Group_Description] ),
			                    [E_Forecast_Full_Year],
			                    ,
			                    DESC
			                ),
			                RANKX (
			                    ALL ( 'Unique Crop main group'[Crop_Main_Group_Description] ),
			                    [E_Forecast_Full_Year],
			                    ,
			                    ASC
			                )
			            ),
			        /* Country-Indication has specialized block below, so don’t rank it here */
			        IsIndication,
			            IF (
			                TopBottomValue = "Top",
			                RANKX ( ALL ( 'Unique Indication'[Indication] ), [E_Forecast_Full_Year], , DESC ),
			                RANKX ( ALL ( 'Unique Indication'[Indication] ), [E_Forecast_Full_Year], , ASC )
			            )
			    )
			
			VAR OthersValue_Other =
			    SWITCH (
			        TRUE (),
			        IsCluster,
			            CALCULATE (
			                [E_Forecast_Full_Year],
			                FILTER (
			                    ALL ( 'Unique Cluster'[Cluster] ),
			                    IF (
			                        TopBottomValue = "Top",
			                        RANKX ( ALL ( 'Unique Cluster'[Cluster] ), [E_Forecast_Full_Year], , DESC ) > RankingLimit,
			                        RANKX ( ALL ( 'Unique Cluster'[Cluster] ), [E_Forecast_Full_Year], , ASC ) > RankingLimit
			                    )
			                )
			            ),
			        IsCountry,
			            CALCULATE (
			                [E_Forecast_Full_Year],
			                FILTER (
			                    ALL ( 'Unique Country'[Country] ),
			                    IF (
			                        TopBottomValue = "Top",
			                        RANKX ( ALL ( 'Unique Country'[Country] ), [E_Forecast_Full_Year], , DESC ) > RankingLimit,
			                        RANKX ( ALL ( 'Unique Country'[Country] ), [E_Forecast_Full_Year], , ASC ) > RankingLimit
			                    )
			                )
			            ),
			        IsCropGroup,
			            CALCULATE (
			                [E_Forecast_Full_Year],
			                FILTER (
			                    ALL ( 'Unique Crop main group'[Crop_Main_Group_Description] ),
			                    IF (
			                        TopBottomValue = "Top",
			                        RANKX (
			                            ALL ( 'Unique Crop main group'[Crop_Main_Group_Description] ),
			                            [E_Forecast_Full_Year],
			                            ,
			                            DESC
			                        ) > RankingLimit,
			                        RANKX (
			                            ALL ( 'Unique Crop main group'[Crop_Main_Group_Description] ),
			                            [E_Forecast_Full_Year],
			                            ,
			                            ASC
			                        ) > RankingLimit
			                    )
			                )
			            ),
			        /* Country-Indication handled in specialized block; excluded here */
			        IsIndication,
			            CALCULATE (
			                [E_Forecast_Full_Year],
			                FILTER (
			                    ALL ( 'Unique Indication'[Indication] ),
			                    IF (
			                        TopBottomValue = "Top",
			                        RANKX ( ALL ( 'Unique Indication'[Indication] ), [E_Forecast_Full_Year], , DESC ) > RankingLimit,
			                        RANKX ( ALL ( 'Unique Indication'[Indication] ), [E_Forecast_Full_Year], , ASC ) > RankingLimit
			                    )
			                )
			            )
			    )
			
			VAR IsOthers_Other =
			    SWITCH (
			        TRUE (),
			        IsCluster,     SELECTEDVALUE ( 'Unique Cluster'[Cluster] ) = "Others",
			        IsCountry,     SELECTEDVALUE ( 'Unique Country'[Country] ) = "Others",
			        IsCropGroup,   SELECTEDVALUE ( 'Unique Crop main group'[Crop_Main_Group_Description] ) = "Others",
			        /* Country-Indication handled below */
			        IsIndication,  SELECTEDVALUE ( 'Unique Indication'[Indication] ) = "Others",
			        FALSE
			    )
			
			VAR Result_Other =
			    IF (
			        IsOthers_Other,
			        OthersValue_Other,
			        IF (
			            TopBottomValue = "Top",
			            IF ( CurrentRank_Other <= RankingLimit, [E_Forecast_Full_Year], BLANK () ),
			            IF ( CurrentRank_Other <= RankingLimit + 1, [E_Forecast_Full_Year], BLANK () )
			        )
			    )
			
			/* -------------------- Country-Indication (Specialized like CCI) -------------------- */
			VAR RankTable_CInd =
			    ALL ( 'Unique Country-Indication'[Country-Indication] )
			
			VAR RankDesc_CInd =
			    RANKX ( RankTable_CInd, [E_Forecast_Full_Year], , DESC )
			VAR RankAsc_CInd  =
			    RANKX ( RankTable_CInd, [E_Forecast_Full_Year], , ASC )
			
			VAR CurrentRank_CInd =
			    IF ( TopBottomValue = "Top", RankDesc_CInd, RankAsc_CInd )
			
			VAR OthersValue_CInd =
			    CALCULATE (
			        [E_Forecast_Full_Year],
			        FILTER (
			            RankTable_CInd,
			            IF ( TopBottomValue = "Top", RankDesc_CInd > RankingLimit, RankAsc_CInd > RankingLimit )
			        )
			    )
			
			VAR IsOthers_CInd =
			    SELECTEDVALUE ( 'Unique Country-Indication'[Country-Indication] ) = "Others"
			
			VAR Result_CInd =
			    IF (
			        IsOthers_CInd,
			        OthersValue_CInd,
			        IF ( CurrentRank_CInd <= RankingLimit, [E_Forecast_Full_Year], BLANK () )
			    )
			
			/* -------------------- Final RETURN -------------------- */
			RETURN
			    IF (
			        IsCountryCropIndication,
			        IF ( ISFILTERED ( 'Unique Country-Crop-Indication'[Country-Crop-Indication] ), Result_CCI, BLANK () ),
			        IF (
			            IsCountryIndication,
			            IF ( ISFILTERED ( 'Unique Country-Indication'[Country-Indication] ), Result_CInd, BLANK () ),
			            IF ( ISFILTERED ( 'CS_Actual'[Channel] ), Result_Other, BLANK () )
			        )
			    )
			
			```
		lineageTag: 8ed3e03a-9cf0-4be5-856e-4f31c63b4952

		annotation PBI_FormatHint = {"isGeneralNumber":true}

