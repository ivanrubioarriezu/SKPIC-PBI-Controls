	column 'ACT CY Label clm' = ```
			
			VAR CurrentSelection =
			    CALCULATE(
			        FIRSTNONBLANK(GMV_Selection_Table[Selection], 1),
			        ALL(GMV_Selection_Table)
			    )
			VAR YearLabelText = FORMAT('CS_Actual'[Year Label], "0")
			RETURN
			IF(
			    CurrentSelection = "Half Year",
			    YearLabelText & " HY1",
			    YearLabelText
			)
			
			
			
			```
		lineageTag: f1421eb4-b717-4c39-936b-322b3732bed5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'M_Latest Forecast Label' = ```
			
			VAR FiscalYear = YEAR('CS_Actual'[Fiscal_Date])
			VAR TodayDay = DAY(TODAY())
			VAR TodayMonth = MONTH(TODAY())
			VAR TodayYear = YEAR(TODAY())
			RETURN
			IF(
			    FiscalYear <> TodayYear,
			    "FC3",
			    IF(
			        (
			            (
			                (TodayDay >= 30 && TodayMonth = 11) || TodayMonth > 11
			            )
			            ||
			            (
			                (
			                    (TodayDay <= 19 && TodayMonth = 2) || TodayMonth < 2
			                )
			                && FiscalYear + 1 = TodayYear
			            )
			        ),
			        "FC3",
			        IF(
			            (
			                ((TodayDay >= 30 && TodayMonth = 8) || TodayMonth > 8)
			                ||
			                ((TodayDay <= 29 && TodayMonth = 11) || TodayMonth > 11)
			            ),
			            "FC2",
			            IF(
			                (
			                    ((TodayDay >= 30 && TodayMonth = 5) || TodayMonth > 5)
			                    ||
			                    ((TodayDay <= 29 && TodayMonth = 8) || TodayMonth > 8)
			                ),
			                "FC1",
			                BLANK()
			            )
			        )
			    )
			)
			
			```
		lineageTag: aaa24d11-11ae-4208-b99c-20e3d158b66e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'M_Forecast Label' = ```
			
