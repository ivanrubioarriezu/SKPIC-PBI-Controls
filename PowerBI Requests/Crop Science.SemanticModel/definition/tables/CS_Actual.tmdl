	column 'E_Plan Filter' = ```
			
			VAR TodayDay = DAY(TODAY())
			VAR TodayMonth = MONTH(TODAY())
			VAR TodayYear = YEAR(TODAY())
			VAR FiscalYear = YEAR('CS_Actual'[Fiscal_Date])
			RETURN
			IF(
			    (
			        (
			            (TodayDay <= 15 && TodayMonth = 2) || TodayMonth < 2
			        )
			        && FiscalYear = TodayYear
			    )
			    || FiscalYear < TodayYear,
			    TRUE(),
			    FALSE()
			)
			
