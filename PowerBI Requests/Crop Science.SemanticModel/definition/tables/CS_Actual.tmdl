	measure 01GMV_CY_Dynamic_Sort_Order =
			
			VAR ViewBySelection =
			    SELECTEDVALUE ( 'View by'[View by Fields] )
			
			RETURN
			SWITCH (
			    TRUE (),
			    ViewBySelection = NAMEOF ( 'Unique Cluster'[Cluster] ),
			        IF ( SELECTEDVALUE ( 'Unique Cluster'[Cluster] ) = "Others", -1, [GMV_CY_Selection (HY/FY)] ),
			    ViewBySelection = NAMEOF ( 'Unique Country'[Country] ),
			        IF ( SELECTEDVALUE ( 'Unique Country'[Country] ) = "Others", -1, [GMV_CY_Selection (HY/FY)] ),
			    ViewBySelection = NAMEOF ( 'Unique Crop main group'[Crop_Main_Group_Description] ),
			        IF ( SELECTEDVALUE ( 'Unique Crop main group'[Crop_Main_Group_Description] ) = "Others", -1, [GMV_CY_Selection (HY/FY)] ),
			    ViewBySelection = NAMEOF ( 'Unique Country-Crop-Indication'[Country-Crop-Indication] ),
			        IF ( SELECTEDVALUE ( 'Unique Country-Crop-Indication'[Country-Crop-Indication] ) = "Others", -1, [GMV_CY_Selection (HY/FY)] ),
			    ViewBySelection = NAMEOF ( 'Unique Country-Indication'[Country-Indication] ),
			        IF ( SELECTEDVALUE ( 'Unique Country-Indication'[Country-Indication] ) = "Others", -1, [GMV_CY_Selection (HY/FY)] ),
			    ViewBySelection = NAMEOF ( 'Unique Indication'[Indication] ),
			        IF ( SELECTEDVALUE ( 'Unique Indication'[Indication] ) = "Others", -1, [GMV_CY_Selection (HY/FY)] )
			)
		lineageTag: 7ea394a5-fd8e-4041-ae6f-be2eca1c7004

