	measure '_ Eplan filter 01Show_TopX_And_Others_Dynamic' =
			
			VAR TopX =
			    SELECTEDVALUE ( 'Ranking Option EV'[Ranking Option EV], 0 )
			
			VAR ViewBySelection =
			    SELECTEDVALUE ( 'View by'[View by Fields] )
			
			/* ✅ FORCE VALUE */
			VAR ValueForRank =
			    COALESCE ( [E_Forecast_Full_Year], 0 )
			
			/* ===================== RANK ===================== */
			
			VAR CurrentRank =
			    SWITCH (
			        TRUE (),
			
			        ViewBySelection = NAMEOF ( 'Unique Country'[Country] ),
			            RANKX (
			                FILTER ( ALL ( 'Unique Country'[Country] ), 'Unique Country'[Country] <> "Others" ),
			                COALESCE ( [E_Forecast_Full_Year], 0 ),
			                ,
			                DESC,
			                DENSE
			            ),
			
			        ViewBySelection = NAMEOF ( 'Unique Cluster'[Cluster] ),
			            RANKX (
			                FILTER ( ALL ( 'Unique Cluster'[Cluster] ), 'Unique Cluster'[Cluster] <> "Others" ),
			                COALESCE ( [E_Forecast_Full_Year], 0 ),
			                ,
			                DESC,
			                DENSE
			            )
			    )
			
			/* ===================== IS OTHERS ===================== */
			
			VAR IsOthers =
			    SWITCH (
			        TRUE (),
			
			        ViewBySelection = NAMEOF ( 'Unique Country'[Country] ),
			            SELECTEDVALUE ( 'Unique Country'[Country] ) = "Others",
			
			        ViewBySelection = NAMEOF ( 'Unique Cluster'[Cluster] ),
			            SELECTEDVALUE ( 'Unique Cluster'[Cluster] ) = "Others",
			
			        FALSE
			    )
			
			/* ===================== FINAL FILTER ===================== */
			
			RETURN
			IF (
			    IsOthers
			        || CurrentRank <= TopX,
			    1,
			    0
			)
		formatString: 0
		lineageTag: 0e3dc2e1-0678-483b-ba37-4897396517bb

	measure TopX_Filter_Control_Only =
			
			VAR TopX =
			    SELECTEDVALUE ( 'Ranking Option EV'[Ranking Option EV], 0 )
			
			VAR ViewBySelection =
			    SELECTEDVALUE ( 'View by'[View by Fields] )
			
			/* ✅ RANK ONLY FOR SELECTION CONTROL (NO VALUE CHANGE) */
			VAR CurrentRank =
			    SWITCH (
			        TRUE (),
			
			        ViewBySelection = NAMEOF ( 'Unique Country'[Country] ),
			            RANKX (
			                FILTER (
			                    ALL ( 'Unique Country'[Country] ),
			                    'Unique Country'[Country] <> "Others"
			                ),
			                [E_Forecast_Full_Year],
			                ,
			                DESC,
			                DENSE
			            ),
			
			        ViewBySelection = NAMEOF ( 'Unique Cluster'[Cluster] ),
			            RANKX (
			                FILTER (
			                    ALL ( 'Unique Cluster'[Cluster] ),
			                    'Unique Cluster'[Cluster] <> "Others"
			                ),
			                [E_Forecast_Full_Year],
			                ,
			                DESC,
			                DENSE
			            )
			    )
			
			/* ✅ IDENTIFY OTHERS */
			VAR IsOthers =
			    SWITCH (
			        TRUE (),
			
			        ViewBySelection = NAMEOF ( 'Unique Country'[Country] ),
			            SELECTEDVALUE ( 'Unique Country'[Country] ) = "Others",
			
			        ViewBySelection = NAMEOF ( 'Unique Cluster'[Cluster] ),
			            SELECTEDVALUE ( 'Unique Cluster'[Cluster] ) = "Others",
			
			        FALSE
			    )
			
			/* ✅ FINAL: ONLY CONTROL MEMBERS (NOT VALUES) */
			RETURN
			IF (
			    NOT IsOthers
			        && CurrentRank <= TopX,
			    1,
			    0
			)
		formatString: 0
		lineageTag: c148f28b-4e0a-41f8-800f-835883755977

	measure 'TopX_Filter_Final E Plan' =
			
			VAR TopX =
			    SELECTEDVALUE ( 'Ranking Option EV'[Ranking Option EV], 0 )
			
			VAR ViewBySelection =
			    SELECTEDVALUE ( 'View by'[View by Fields] )
			
			/* ✅ EXCLUDE "OTHERS" FROM RANKING */
			VAR CurrentRank =
			    SWITCH (
			        TRUE (),
			
			        ViewBySelection = NAMEOF ( 'Unique Country'[Country] ),
			            RANKX (
			                FILTER (
			                    ALL ( 'Unique Country'[Country] ),
			                    'Unique Country'[Country] <> "Others"
			                ),
			                [01E_Plan_TopX_With_Others_Dynamic],
			                ,
			                DESC,
			                DENSE
			            ),
			
			        ViewBySelection = NAMEOF ( 'Unique Cluster'[Cluster] ),
			            RANKX (
			                FILTER (
			                    ALL ( 'Unique Cluster'[Cluster] ),
			                    'Unique Cluster'[Cluster] <> "Others"
			                ),
			                [01E_Plan_TopX_With_Others_Dynamic],
			                ,
			                DESC,
			                DENSE
			            )
			    )
			
			/* ✅ SAFE RANK */
			VAR SafeRank =
			    IF ( ISBLANK ( CurrentRank ), 999999, CurrentRank )
			
			/* ✅ IDENTIFY OTHERS */
			VAR IsOthers =
			    SWITCH (
			        TRUE (),
			
			        ViewBySelection = NAMEOF ( 'Unique Country'[Country] ),
			            SELECTEDVALUE ( 'Unique Country'[Country] ) = "Others",
			
			        ViewBySelection = NAMEOF ( 'Unique Cluster'[Cluster] ),
			            SELECTEDVALUE ( 'Unique Cluster'[Cluster] ) = "Others",
			
			        FALSE
			    )
			
			/* ✅ FINAL LOGIC: TopX + Others */
			RETURN
			IF (
			    IsOthers
			        || SafeRank <= TopX,
			    1,
			    0
			)
		formatString: 0
		lineageTag: 8efbf754-1dc8-44bf-8139-0eaeeb8fb9d9

	measure 'TopX_Filter_Final E Plan test gaps' =
			
			VAR TopX =
			    SELECTEDVALUE ( 'Ranking Option EV'[Ranking Option EV], 0 )
			
			VAR ViewBySelection =
			    SELECTEDVALUE ( 'View by'[View by Fields] )
			
			/* ✅ FORCE BLANKS TO PARTICIPATE IN RANKING */
			VAR CurrentRank =
			    SWITCH (
			        TRUE (),
			
			        ViewBySelection = NAMEOF ( 'Unique Country'[Country] ),
			            RANKX (
			                FILTER (
			                    ALL ( 'Unique Country'[Country] ),
			                    'Unique Country'[Country] <> "Others"
			                ),
			                COALESCE ( [01E_Plan_TopX_With_Others_Dynamic], -999999 ),
			                ,
			                DESC,
			                DENSE
			            ),
			
			        ViewBySelection = NAMEOF ( 'Unique Cluster'[Cluster] ),
			            RANKX (
			                FILTER (
			                    ALL ( 'Unique Cluster'[Cluster] ),
			                    'Unique Cluster'[Cluster] <> "Others"
			                ),
			                COALESCE ( [01E_Plan_TopX_With_Others_Dynamic], -999999 ),
			                ,
			                DESC,
			                DENSE
			            )
			    )
			
			/* ✅ SAFE RANK */
			VAR SafeRank =
			    IF ( ISBLANK ( CurrentRank ), 999999, CurrentRank )
			
			/* ✅ IDENTIFY OTHERS */
			VAR IsOthers =
			    SWITCH (
			        TRUE (),
			
			        ViewBySelection = NAMEOF ( 'Unique Country'[Country] ),
			            SELECTEDVALUE ( 'Unique Country'[Country] ) = "Others",
			
			        ViewBySelection = NAMEOF ( 'Unique Cluster'[Cluster] ),
			            SELECTEDVALUE ( 'Unique Cluster'[Cluster] ) = "Others",
			
			        FALSE
			    )
			
			/* ✅ FINAL: TopX + Others (INCLUDING GAPS) */
			RETURN
			IF (
			    IsOthers
			        || SafeRank <= TopX,
			    1,
			    0
			)
		formatString: 0
		lineageTag: 96985d51-a0d9-4037-86e2-f273824f2518

	measure TopX_Filter_Final_Stable =
			
			VAR TopX =
			    SELECTEDVALUE ( 'Ranking Option EV'[Ranking Option EV], 0 )
			
			VAR ViewBySelection =
			    SELECTEDVALUE ( 'View by'[View by Fields] )
			
			/* ✅ SAME VALUE LOGIC */
			VAR RankValue =
			    COALESCE ( [E_Forecast_Full_Year], 0 )
			
			/* ✅ RANK WITHOUT REMOVING ANY ROWS */
			VAR CurrentRank =
			    SWITCH (
			        TRUE (),
			
			        ViewBySelection = NAMEOF ( 'Unique Country'[Country] ),
			            RANKX (
			                ALL ( 'Unique Country'[Country] ),
			                RankValue,
			                ,
			                DESC,
			                DENSE
			            ),
			
			        ViewBySelection = NAMEOF ( 'Unique Cluster'[Cluster] ),
			            RANKX (
			                ALL ( 'Unique Cluster'[Cluster] ),
			                RankValue,
			                ,
			                DESC,
			                DENSE
			            )
			    )
			
			/* ✅ IDENTIFY OTHERS ROW */
			VAR IsOthers =
			    SWITCH (
			        TRUE (),
			
			        ViewBySelection = NAMEOF ( 'Unique Country'[Country] ),
			            SELECTEDVALUE ( 'Unique Country'[Country] ) = "Others",
			
			        ViewBySelection = NAMEOF ( 'Unique Cluster'[Cluster] ),
			            SELECTEDVALUE ( 'Unique Cluster'[Cluster] ) = "Others",
			
			        FALSE
			    )
			
			/* ✅ FINAL LOGIC */
			RETURN
			IF (
			    -- ✅ Keep Others ALWAYS
			    IsOthers
			        ||
			    -- ✅ Keep TopX members
			    CurrentRank <= TopX
			        ||
			    -- ✅ Keep remaining rows (needed for Others calculation!)
			    TRUE(),
			    1,
			    0
			)
		formatString: 0
		lineageTag: bfa31248-cee8-4787-8966-ef486032d4ff

	measure 'test 01E_Forecast_TopX_With_Others_Dynamic' = ```
			
			VAR TopX =
			    SELECTEDVALUE ( 'Ranking Option EV'[Ranking Option EV], 5 )
			
			VAR ViewBySelection =
			    SELECTEDVALUE ( 'View by'[View by Fields] )
			
			/* ✅ BASE VALUE */
			VAR BaseValue =
			    COALESCE ( [E_Forecast_Full_Year], 0 )
			
			/* ✅ UNIQUE RANK VALUE (FIX FOR ZERO TIES) */
			VAR UniqueRankValue_Country =
			    BaseValue +
			    DIVIDE (
			        RANKX (
			            ALL ( 'Unique Country'[Country] ),
			            SELECTEDVALUE ( 'Unique Country'[Country] ),
			            ,
			            ASC
			        ),
			        1000000
			    )
			
			VAR UniqueRankValue_Cluster =
			    BaseValue +
			    DIVIDE (
			        RANKX (
			            ALL ( 'Unique Cluster'[Cluster] ),
			            SELECTEDVALUE ( 'Unique Cluster'[Cluster] ),
			            ,
			            ASC
			        ),
			        1000000
			    )
			
			/* ===================== RANK ===================== */
			VAR Rank_Country =
			    RANKX (
			        ALL ( 'Unique Country'[Country] ),
			        UniqueRankValue_Country,
			        ,
			        DESC,
			        DENSE
			    )
			
			VAR Rank_Cluster =
			    RANKX (
			        ALL ( 'Unique Cluster'[Cluster] ),
			        UniqueRankValue_Cluster,
			        ,
			        DESC,
			        DENSE
			    )
			
			VAR CurrentRank =
			    SWITCH (
			        TRUE (),
			        ViewBySelection = NAMEOF ( 'Unique Country'[Country] ), Rank_Country,
			        ViewBySelection = NAMEOF ( 'Unique Cluster'[Cluster] ), Rank_Cluster
			    )
			
			VAR SafeRank =
			    IF ( ISBLANK ( CurrentRank ), 999999, CurrentRank )
			
			/* ===================== OTHERS ===================== */
			VAR OthersValue =
			    SWITCH (
			        TRUE (),
			
			        ViewBySelection = NAMEOF ( 'Unique Country'[Country] ),
			            CALCULATE (
			                SUMX (
			                    FILTER (
			                        ALL ( 'Unique Country'[Country] ),
			                        RANKX (
			                            ALL ( 'Unique Country'[Country] ),
			                            UniqueRankValue_Country,
			                            ,
			                            DESC,
			                            DENSE
			                        ) > TopX
			                    ),
			                    COALESCE ( [E_Forecast_Full_Year], 0 )
			                )
			            ),
			
			        ViewBySelection = NAMEOF ( 'Unique Cluster'[Cluster] ),
			            CALCULATE (
			                SUMX (
			                    FILTER (
			                        ALL ( 'Unique Cluster'[Cluster] ),
			                        RANKX (
			                            ALL ( 'Unique Cluster'[Cluster] ),
			                            UniqueRankValue_Cluster,
			                            ,
			                            DESC,
			                            DENSE
			                        ) > TopX
			                    ),
			                    COALESCE ( [E_Forecast_Full_Year], 0 )
			                )
			            )
			    )
			
			/* ===================== IS OTHERS ===================== */
			VAR IsOthers =
			    SWITCH (
			        TRUE (),
			        ViewBySelection = NAMEOF ( 'Unique Country'[Country] ),
			            SELECTEDVALUE ( 'Unique Country'[Country] ) = "Others",
			        ViewBySelection = NAMEOF ( 'Unique Cluster'[Cluster] ),
			            SELECTEDVALUE ( 'Unique Cluster'[Cluster] ) = "Others",
			        FALSE
			    )
			
			/* ===================== FINAL RETURN ===================== */
			RETURN
			SWITCH (
			    TRUE (),
			
			    -- ✅ Others (NO COALESCE → avoid fake 0)
			    IsOthers,
			        OthersValue,
			
			    -- ✅ STRICT TopX (zeros included safely)
			    SafeRank <= TopX,
			        BaseValue,
			
			    -- ✅ Hide rest
			    BLANK ()
			)
			
			```
		lineageTag: 845a904b-2907-4d39-86d8-8e42b1fdcb07

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Filter_Final = ```
			
