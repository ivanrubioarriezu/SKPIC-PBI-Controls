		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: aa31991a-c7e4-461f-8517-c49a62aeef0c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'E_Latest Forecast Label' = ```
			
			VAR TodayDate = TODAY()
			VAR FDate     = CS_Actual[Fiscal_Date]
			VAR FYear     = YEAR(FDate)
			VAR TYear     = YEAR(TodayDate)
			VAR TMonth    = MONTH(TodayDate)
			VAR TDay      = DAY(TodayDate)
			RETURN
			IF (
			    // Tableau: IF YEAR([Fiscal_Date]) != YEAR(TODAY()) THEN 'FC3'
			    FYear <> TYear,
			    "FC3",
			    // ELSEIF ... THEN 'FC3'
			    IF (
			        (
			            // (((DAY([Today]) >= 25 AND MONTH([Today]) = 11) OR MONTH([Today]) > 11))
			            (TDay >= 25 && TMonth = 11) || (TMonth > 11)
			        )
			        ||
			        (
			            // ((((DAY([Today]) <= 19 AND MONTH([Today]) = 2) OR MONTH([Today]) < 2))
			            //   AND YEAR([Fiscal_Date]) + 1 = YEAR([Today]) )
			            ((TDay <= 19 && TMonth = 2) || (TMonth < 2))
			            && (FYear + 1 = TYear)
			        ),
			        "FC3",
			        // ELSEIF ... THEN 'FC2'
			        IF (
			            (
			                // (((DAY([Today]) >= 25 AND MONTH([Today]) = 8) OR MONTH([Today]) > 8)
			                (TDay >= 25 && TMonth = 8) || (TMonth > 8)
			            )
			            ||
			            (
			                // OR ((DAY([Today]) <= 24 AND MONTH([Today]) = 11) OR MONTH([Today]) > 11))
			                (TDay <= 24 && TMonth = 11) || (TMonth > 11)
			            ),
			            "FC2",
			            // ELSEIF ... THEN 'FC1'
			            IF (
			                (
			                    // (((DAY([Today]) >= 25 AND MONTH([Today]) = 5) OR MONTH([Today]) > 5)
			                    (TDay >= 25 && TMonth = 5) || (TMonth > 5)
			                )
			                ||
			                (
			                    // OR ((DAY([Today]) <= 24 AND MONTH([Today]) = 8) OR MONTH([Today]) > 8))
			                    (TDay <= 24 && TMonth = 8) || (TMonth > 8)
			                ),
			                "FC1",
			                BLANK()
			            )
			        )
			    )
			)
			
			```
		lineageTag: 58f20bb8-6e3c-4d06-a86e-ff7ca8e759fe
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

