	measure '_Dynamic GMV (Country-Crop-Indication Only)' = ```
			
			VAR TopBottomValue =
			    SELECTEDVALUE ( 'Top/Bottom'[Value] )            // "Top" or "Bottom"
			VAR RankingLimit =
			    VALUE ( SELECTEDVALUE ( 'Ranking Option'[Ranking Option], 10 ) )   // default 10 if nothing selected
			
			// Rank setup over the Country-Crop-Indication members
			VAR RankTable =
			    ALL ( 'Unique Country-Crop-Indication'[Country-Crop-Indication] )
			VAR RankDesc =
			    RANKX ( RankTable, [GMV_CY_Selection (HY/FY)], , DESC )
			VAR RankAsc  =
			    RANKX ( RankTable, [GMV_CY_Selection (HY/FY)], , ASC )
			VAR CurrentRank =
			    IF ( TopBottomValue = "Top", RankDesc, RankAsc )
			
			// Sum of all members beyond the RankingLimit -> used when the current label is "Others"
			VAR OthersValue =
			    CALCULATE (
			        [GMV_CY_Selection (HY/FY)],
			        FILTER (
			            RankTable,
			            IF ( TopBottomValue = "Top", RankDesc > RankingLimit, RankAsc > RankingLimit )
			        )
			    )
			
			VAR IsOthers =
			    SELECTEDVALUE ( 'Unique Country-Crop-Indication'[Country-Crop-Indication] ) = "Others"
			
			VAR Result =
			    IF (
			        IsOthers,
			        OthersValue,
			        // Show value only for Top/Bottom N; hide the rest
			        IF ( CurrentRank <= RankingLimit, [GMV_CY_Selection (HY/FY)], BLANK () )
			    )
			
			RETURN
			IF ( ISFILTERED ( 'Unique Country-Crop-Indication'[Country-Crop-Indication] ), Result, BLANK () )
			
			```
