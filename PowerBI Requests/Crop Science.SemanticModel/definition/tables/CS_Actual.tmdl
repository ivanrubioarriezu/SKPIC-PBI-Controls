		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'M_Latest Forecast Selection' = ```
			
			VAR FiscalYear = YEAR(MAX('CS_Actual'[Fiscal_Date]))
			VAR TodayDay = DAY(TODAY())
			VAR TodayMonth = MONTH(TODAY())
			VAR TodayYear = YEAR(TODAY())
			RETURN
			IF(
			    FiscalYear < TodayYear,
			    SUM([Farmer_FC3_Full_Year]),
			    IF(
			        (
			            (
			                (TodayDay >= 30 && TodayMonth = 11) || TodayMonth > 11
			            )
			            ||
			            (
			                (
			                    (TodayDay <= 29 && TodayMonth = 5) || TodayMonth < 5
			                )
			                && FiscalYear + 1 = TodayYear
			            )
			        ),
			        SUM([Farmer_FC3_Full_Year]),
			        IF(
			            (
			                ((TodayDay >= 30 && TodayMonth = 8) || TodayMonth > 8)
			                ||
			                ((TodayDay <= 29 && TodayMonth = 11) || TodayMonth > 11)
			            ),
			            SUM([Farmer_FC2_Full_Year]),
			            IF(
			                (
			                    ((TodayDay >= 30 && TodayMonth = 5) || TodayMonth > 5)
			                    ||
			                    ((TodayDay <= 29 && TodayMonth = 8) || TodayMonth > 8)
			                ),
			                SUM([Farmer_FC1_Full_Year]),
			                BLANK()
			            )
			        )
			    )
			)
			
			```
		lineageTag: 63a88298-3e98-4881-a0e6-7fcaa75864de

