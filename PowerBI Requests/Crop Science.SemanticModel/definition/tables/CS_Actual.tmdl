	measure '_2Test Dynamic GMV' = ```
			
			VAR TopBottomValue =
			    SELECTEDVALUE ( 'Top/Bottom'[Value] )          /* "Top" or "Bottom" */
			
			VAR RankingLimit =
			    VALUE ( SELECTEDVALUE ( 'Ranking Option EV'[Ranking Option EV], 10 ) )
			
			VAR ViewBySelection =
			    SELECTEDVALUE ( 'View by'[View by Fields] )
			
			/* Dimension flags (as in your measure) */
			VAR IsCluster               = CONTAINSSTRING ( ViewBySelection, "Cluster" )
			VAR IsCountry               = CONTAINSSTRING ( ViewBySelection, "Country" )
			VAR IsCropGroup             = CONTAINSSTRING ( ViewBySelection, "Crop_Main_Group_Description" )
			VAR IsCountryCropIndication = CONTAINSSTRING ( ViewBySelection, "Country-Crop-Indication" )
			VAR IsCountryIndication     = CONTAINSSTRING ( ViewBySelection, "Country-Indication" )
			VAR IsIndication            = CONTAINSSTRING ( ViewBySelection, "Indication" )
			
			/* -------------------- Country-Crop-Indication (Existing Specialized) -------------------- */
			VAR RankTable_CCI =
			    ALL ( 'Unique Country-Crop-Indication'[Country-Crop-Indication] )
			
			VAR RankDesc_CCI =
			    RANKX ( RankTable_CCI, [GMV_CY_Selection (HY/FY)], , DESC )
			VAR RankAsc_CCI  =
			    RANKX ( RankTable_CCI, [GMV_CY_Selection (HY/FY)], , ASC )
			
			VAR CurrentRank_CCI =
			    IF ( TopBottomValue = "Top", RankDesc_CCI, RankAsc_CCI )
			
			VAR OthersValue_CCI =
			    CALCULATE (
			        [GMV_CY_Selection (HY/FY)],
			        FILTER (
			            RankTable_CCI,
			            IF ( TopBottomValue = "Top", RankDesc_CCI > RankingLimit, RankAsc_CCI > RankingLimit )
			        )
			    )
			
			VAR IsOthers_CCI =
			    SELECTEDVALUE ( 'Unique Country-Crop-Indication'[Country-Crop-Indication] ) = "Others"
			
			VAR Result_CCI =
			    IF (
			        IsOthers_CCI,
			        OthersValue_CCI,
			        IF ( CurrentRank_CCI <= RankingLimit, [GMV_CY_Selection (HY/FY)], BLANK () )
			    )
			
			/* -------------------- Country-Indication (New Specialized, same as CCI) -------------------- */
			VAR RankTable_CInd =
			    ALL ( 'Unique Country-Indication'[Country-Indication] )
			
			VAR RankDesc_CInd =
			    RANKX ( RankTable_CInd, [GMV_CY_Selection (HY/FY)], , DESC )
			VAR RankAsc_CInd  =
			    RANKX ( RankTable_CInd, [GMV_CY_Selection (HY/FY)], , ASC )
			
			VAR CurrentRank_CInd =
			    IF ( TopBottomValue = "Top", RankDesc_CInd, RankAsc_CInd )
			
			VAR OthersValue_CInd =
			    CALCULATE (
			        [GMV_CY_Selection (HY/FY)],
			        FILTER (
			            RankTable_CInd,
			            IF ( TopBottomValue = "Top", RankDesc_CInd > RankingLimit, RankAsc_CInd > RankingLimit )
			        )
			    )
			
			VAR IsOthers_CInd =
			    SELECTEDVALUE ( 'Unique Country-Indication'[Country-Indication] ) = "Others"
			
			VAR Result_CInd =
			    IF (
			        IsOthers_CInd,
			        OthersValue_CInd,
			        IF ( CurrentRank_CInd <= RankingLimit, [GMV_CY_Selection (HY/FY)], BLANK () )
			    )
			
			/* -------------------- Other dimensions (unchanged) -------------------- */
			VAR CurrentRank_Other =
			    SWITCH (
			        TRUE (),
			        IsCluster,
			            IF (
			                TopBottomValue = "Top",
			                RANKX ( ALL ( 'Unique Cluster'[Cluster] ), [GMV_CY_Selection (HY/FY)], , DESC ),
			                RANKX ( ALL ( 'Unique Cluster'[Cluster] ), [GMV_CY_Selection (HY/FY)], , ASC )
			            ),
			        IsCountry,
			            IF (
			                TopBottomValue = "Top",
			                RANKX ( ALL ( 'Unique Country'[Country] ), [GMV_CY_Selection (HY/FY)], , DESC ),
			                RANKX ( ALL ( 'Unique Country'[Country] ), [GMV_CY_Selection (HY/FY)], , ASC )
			            ),
			        IsCropGroup,
			            IF (
			                TopBottomValue = "Top",
			                RANKX (
			                    ALL ( 'Unique Crop main group'[Crop_Main_Group_Description] ),
			                    [GMV_CY_Selection (HY/FY)],
			                    ,
			                    DESC
			                ),
			                RANKX (
			                    ALL ( 'Unique Crop main group'[Crop_Main_Group_Description] ),
			                    [GMV_CY_Selection (HY/FY)],
			                    ,
			                    ASC
			                )
			            ),
			        /* Removed Country-Indication from "Other" block, it has its own specialized logic now */
			        IsIndication,
			            IF (
			                TopBottomValue = "Top",
			                RANKX ( ALL ( 'Unique Indication'[Indication] ), [GMV_CY_Selection (HY/FY)], , DESC ),
			                RANKX ( ALL ( 'Unique Indication'[Indication] ), [GMV_CY_Selection (HY/FY)], , ASC )
			            )
			    )
			
			VAR OthersValue_Other =
			    SWITCH (
			        TRUE (),
			        IsCluster,
			            CALCULATE (
			                [GMV_CY_Selection (HY/FY)],
			                FILTER (
			                    ALL ( 'Unique Cluster'[Cluster] ),
			                    IF (
			                        TopBottomValue = "Top",
			                        RANKX ( ALL ( 'Unique Cluster'[Cluster] ), [GMV_CY_Selection (HY/FY)], , DESC ) > RankingLimit,
			                        RANKX ( ALL ( 'Unique Cluster'[Cluster] ), [GMV_CY_Selection (HY/FY)], , ASC ) > RankingLimit
			                    )
			                )
			            ),
			        IsCountry,
			            CALCULATE (
			                [GMV_CY_Selection (HY/FY)],
			                FILTER (
			                    ALL ( 'Unique Country'[Country] ),
			                    IF (
			                        TopBottomValue = "Top",
			                        RANKX ( ALL ( 'Unique Country'[Country] ), [GMV_CY_Selection (HY/FY)], , DESC ) > RankingLimit,
			                        RANKX ( ALL ( 'Unique Country'[Country] ), [GMV_CY_Selection (HY/FY)], , ASC ) > RankingLimit
			                    )
			                )
			            ),
			        IsCropGroup,
			            CALCULATE (
			                [GMV_CY_Selection (HY/FY)],
			                FILTER (
			                    ALL ( 'Unique Crop main group'[Crop_Main_Group_Description] ),
			                    IF (
			                        TopBottomValue = "Top",
			                        RANKX (
			                            ALL ( 'Unique Crop main group'[Crop_Main_Group_Description] ),
			                            [GMV_CY_Selection (HY/FY)],
			                            ,
			                            DESC
			                        ) > RankingLimit,
			                        RANKX (
			                            ALL ( 'Unique Crop main group'[Crop_Main_Group_Description] ),
			                            [GMV_CY_Selection (HY/FY)],
			                            ,
			                            ASC
			                        ) > RankingLimit
			                    )
			                )
			            ),
			        /* Removed Country-Indication here (specialized above) */
			        IsIndication,
			            CALCULATE (
			                [GMV_CY_Selection (HY/FY)],
			                FILTER (
			                    ALL ( 'Unique Indication'[Indication] ),
			                    IF (
			                        TopBottomValue = "Top",
			                        RANKX ( ALL ( 'Unique Indication'[Indication] ), [GMV_CY_Selection (HY/FY)], , DESC ) > RankingLimit,
			                        RANKX ( ALL ( 'Unique Indication'[Indication] ), [GMV_CY_Selection (HY/FY)], , ASC ) > RankingLimit
			                    )
			                )
			            )
			    )
			
			VAR IsOthers_Other =
			    SWITCH (
			        TRUE (),
			        IsCluster,   SELECTEDVALUE ( 'Unique Cluster'[Cluster] ) = "Others",
			        IsCountry,   SELECTEDVALUE ( 'Unique Country'[Country] ) = "Others",
			        IsCropGroup, SELECTEDVALUE ( 'Unique Crop main group'[Crop_Main_Group_Description] ) = "Others",
			        /* Removed Country-Indication; handled by specialized block */
			        IsIndication, SELECTEDVALUE ( 'Unique Indication'[Indication] ) = "Others",
			        FALSE
			    )
			
			VAR Result_Other =
			    IF (
			        IsOthers_Other,
			        OthersValue_Other,
			        IF (
			            TopBottomValue = "Top",
			            IF ( CurrentRank_Other <= RankingLimit, [GMV_CY_Selection (HY/FY)], BLANK () ),
			            IF ( CurrentRank_Other <= RankingLimit + 1, [GMV_CY_Selection (HY/FY)], BLANK () )
			        )
			    )
			
			RETURN
			    IF (
			        IsCountryCropIndication,
			        IF ( ISFILTERED ( 'Unique Country-Crop-Indication'[Country-Crop-Indication] ), Result_CCI, BLANK () ),
			        IF (
			            IsCountryIndication,
			            IF ( ISFILTERED ( 'Unique Country-Indication'[Country-Indication] ), Result_CInd, BLANK () ),
			            IF ( ISFILTERED ( 'CS_Actual'[Channel] ), Result_Other, BLANK () )
			        )
			    )
			
			```
		lineageTag: 349bec26-1475-4fc9-9618-1750938e1dad

