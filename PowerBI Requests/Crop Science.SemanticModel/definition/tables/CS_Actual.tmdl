		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 01E_Plan_TopX_With_Others_Dynamic = ```
			
			VAR TopX =
			    SELECTEDVALUE ( 'Ranking Option EV'[Ranking Option EV], 0 )
			
			VAR ViewBySelection =
			    SELECTEDVALUE ( 'View by'[View by Fields] )
			
			/* ===================== RANKS ===================== */
			
			VAR Rank_Cluster =
			    RANKX (
			        FILTER ( ALL ( 'Unique Cluster'[Cluster] ), 'Unique Cluster'[Cluster] <> "Others" ),
			        [E_Plan dynamic],
			        ,
			        DESC,
			        DENSE
			    )
			
			VAR Rank_Country =
			    RANKX (
			        FILTER ( ALL ( 'Unique Country'[Country] ), 'Unique Country'[Country] <> "Others" ),
			        [E_Plan dynamic],
			        ,
			        DESC,
			        DENSE
			    )
			
			VAR Rank_Crop =
			    RANKX (
			        FILTER (
			            ALL ( 'Unique Crop main group'[Crop_Main_Group_Description] ),
			            'Unique Crop main group'[Crop_Main_Group_Description] <> "Others"
			        ),
			        [E_Plan dynamic],
			        ,
			        DESC,
			        DENSE
			    )
			
			VAR Rank_CCI =
			    RANKX (
			        FILTER (
			            ALL ( 'Unique Country-Crop-Indication'[Country-Crop-Indication] ),
			            'Unique Country-Crop-Indication'[Country-Crop-Indication] <> "Others"
			        ),
			       [E_Plan dynamic],
			        ,
			        DESC,
			        DENSE
			    )
			
			VAR Rank_CInd =
			    RANKX (
			        FILTER (
			            ALL ( 'Unique Country-Indication'[Country-Indication] ),
			            'Unique Country-Indication'[Country-Indication] <> "Others"
			        ),
			        [E_Plan dynamic],
			        ,
			        DESC,
			        DENSE
			    )
			
			VAR Rank_Indication =
			    RANKX (
			        FILTER (
			            ALL ( 'Unique Indication'[Indication] ),
			            'Unique Indication'[Indication] <> "Others"
			        ),
			        [E_Plan dynamic],
			        ,
			        DESC,
			        DENSE
			    )
			
			/* ===================== OTHERS (FIXED ✅) ===================== */
			
			VAR Others_Cluster =
			    CALCULATE (
			        [GMV_CY_Selection (HY/FY)],
			        FILTER (
			            ALL ( 'Unique Cluster'[Cluster] ),
			            'Unique Cluster'[Cluster] <> "Others"
			                && RANKX (
			                    FILTER ( ALL ( 'Unique Cluster'[Cluster] ), 'Unique Cluster'[Cluster] <> "Others" ),
			                    [E_Plan dynamic],
			                    ,
			                    DESC,
			                    DENSE
			                ) > TopX
			        )
			    )
			
			VAR Others_Country =
			    CALCULATE (
			        [E_Plan dynamic],
			        FILTER (
			            ALL ( 'Unique Country'[Country] ),
			            'Unique Country'[Country] <> "Others"
			                && RANKX (
			                    FILTER ( ALL ( 'Unique Country'[Country] ), 'Unique Country'[Country] <> "Others" ),
			                    [E_Plan dynamic],
			                    ,
			                    DESC,
			                    DENSE
			                ) > TopX
			        )
			    )
			
			VAR Others_Crop =
			    CALCULATE (
			        [E_Plan dynamic],
			        FILTER (
			            ALL ( 'Unique Crop main group'[Crop_Main_Group_Description] ),
			            'Unique Crop main group'[Crop_Main_Group_Description] <> "Others"
			                && RANKX (
			                    FILTER ( ALL ( 'Unique Crop main group'[Crop_Main_Group_Description] ), 'Unique Crop main group'[Crop_Main_Group_Description] <> "Others" ),
			                    [E_Plan dynamic],
			                    ,
			                    DESC,
			                    DENSE
			                ) > TopX
			        )
			    )
			
			VAR Others_CCI =
			    CALCULATE (
			       [E_Plan dynamic],
			        FILTER (
			            ALL ( 'Unique Country-Crop-Indication'[Country-Crop-Indication] ),
			            'Unique Country-Crop-Indication'[Country-Crop-Indication] <> "Others"
			                && RANKX (
			                    FILTER ( ALL ( 'Unique Country-Crop-Indication'[Country-Crop-Indication] ), 'Unique Country-Crop-Indication'[Country-Crop-Indication] <> "Others" ),
			                    [E_Plan dynamic],
			                    ,
			                    DESC,
			                    DENSE
			                ) > TopX
			        )
			    )
			
			VAR Others_CInd =
			    CALCULATE (
			        [E_Plan dynamic],
			        FILTER (
			            ALL ( 'Unique Country-Indication'[Country-Indication] ),
			            'Unique Country-Indication'[Country-Indication] <> "Others"
			                && RANKX (
			                    FILTER ( ALL ( 'Unique Country-Indication'[Country-Indication] ), 'Unique Country-Indication'[Country-Indication] <> "Others" ),
			                    [E_Plan dynamic],
			                    ,
			                    DESC,
			                    DENSE
			                ) > TopX
			        )
			    )
			
			VAR Others_Indication =
			    CALCULATE (
			       [E_Plan dynamic],
			        FILTER (
			            ALL ( 'Unique Indication'[Indication] ),
			            'Unique Indication'[Indication] <> "Others"
			                && RANKX (
			                    FILTER ( ALL ( 'Unique Indication'[Indication] ), 'Unique Indication'[Indication] <> "Others" ),
			                    [E_Plan dynamic],
			                    ,
			                    DESC,
			                    DENSE
			                ) > TopX
			        )
			    )
			
			/* ===================== CURRENT RANK ===================== */
			
			VAR CurrentRank =
			    SWITCH (
			        TRUE (),
			        ViewBySelection = NAMEOF ( 'Unique Cluster'[Cluster] ), Rank_Cluster,
			        ViewBySelection = NAMEOF ( 'Unique Country'[Country] ), Rank_Country,
			        ViewBySelection = NAMEOF ( 'Unique Crop main group'[Crop_Main_Group_Description] ), Rank_Crop,
			        ViewBySelection = NAMEOF ( 'Unique Country-Crop-Indication'[Country-Crop-Indication] ), Rank_CCI,
			        ViewBySelection = NAMEOF ( 'Unique Country-Indication'[Country-Indication] ), Rank_CInd,
			        ViewBySelection = NAMEOF ( 'Unique Indication'[Indication] ), Rank_Indication
			    )
			
			/* ===================== IS OTHERS ===================== */
			
			VAR IsOthers =
			    SWITCH (
			        TRUE (),
			        ViewBySelection = NAMEOF ( 'Unique Cluster'[Cluster] ),
			            SELECTEDVALUE ( 'Unique Cluster'[Cluster] ) = "Others",
			        ViewBySelection = NAMEOF ( 'Unique Country'[Country] ),
			            SELECTEDVALUE ( 'Unique Country'[Country] ) = "Others",
			        ViewBySelection = NAMEOF ( 'Unique Crop main group'[Crop_Main_Group_Description] ),
			            SELECTEDVALUE ( 'Unique Crop main group'[Crop_Main_Group_Description] ) = "Others",
			        ViewBySelection = NAMEOF ( 'Unique Country-Crop-Indication'[Country-Crop-Indication] ),
			            SELECTEDVALUE ( 'Unique Country-Crop-Indication'[Country-Crop-Indication] ) = "Others",
			        ViewBySelection = NAMEOF ( 'Unique Country-Indication'[Country-Indication] ),
			            SELECTEDVALUE ( 'Unique Country-Indication'[Country-Indication] ) = "Others",
			        ViewBySelection = NAMEOF ( 'Unique Indication'[Indication] ),
			            SELECTEDVALUE ( 'Unique Indication'[Indication] ) = "Others",
			        FALSE
			    )
			
			/* ===================== FINAL ===================== */
			
			RETURN
			SWITCH (
			    TRUE (),
			
			    -- ✅ Others (now correct)
			    IsOthers,
			        SWITCH (
			            TRUE (),
			            ViewBySelection = NAMEOF ( 'Unique Cluster'[Cluster] ), Others_Cluster,
			            ViewBySelection = NAMEOF ( 'Unique Country'[Country] ), Others_Country,
			            ViewBySelection = NAMEOF ( 'Unique Crop main group'[Crop_Main_Group_Description] ), Others_Crop,
			            ViewBySelection = NAMEOF ( 'Unique Country-Crop-Indication'[Country-Crop-Indication] ), Others_CCI,
			            ViewBySelection = NAMEOF ( 'Unique Country-Indication'[Country-Indication] ), Others_CInd,
			            ViewBySelection = NAMEOF ( 'Unique Indication'[Indication] ), Others_Indication
			        ),
			
			    -- ✅ TopX
			    TopX = 0 || CurrentRank <= TopX,
			       [E_Plan dynamic],
			
			    BLANK ()
			)
			
			```
		lineageTag: 665b11fa-bb98-4265-8e00-dc86b06dc9f9

