table 'CH_UP DMT_Target'
	lineageTag: c1e539c9-8d4f-4de8-a575-8914eed66097

	measure 's ch target' = ```
			
			VAR anyValue =
			    
			        SUM('CH_UP DMT_Target'[Target])
			        
			        
			    
			RETURN
			    IF ( ISBLANK(anyValue), BLANK(), "●" )
			```
		lineageTag: 1313e323-e36b-40d3-a4e2-c245466df021

	measure 'Dot Color Target ch' = ```
			
			VAR anyValue =
			     (
			        SUM('CH_UP DMT_Target'[Target])
			       
			    )
			VAR prelim =
			    SELECTEDVALUE ('CH_UP DMT_Target'[Is_Preliminary] )
			RETURN
			    IF (
			        ISBLANK ( anyValue ),
			        BLANK(),
			        IF ( prelim = TRUE(), "#D9D9D9", "#00AEEF" )
			    )
			```
		lineageTag: 588f55e2-b4ef-486d-af05-420b44beafc4

