table 'PH_WH DTbl_AllUserAndCYPValues'
	lineageTag: c83daa41-9e9c-458f-b1c8-0e78418a21c4

	measure 's ph' = ```
			
			VAR anyValue =
			    COALESCE (
			        SUM('PH_WH DTbl_AllUserAndCYPValues'[User_Value_Actual_YtD]),
			        SUM('PH_WH DTbl_AllUserAndCYPValues'[User_Value_Plan_YtD]),
			        SUM('PH_WH DTbl_AllUserAndCYPValues'[User_Value_Forecast1_YtD]),
			        SUM('PH_WH DTbl_AllUserAndCYPValues'[User_Value_Forecast2_YtD]),
			         SUM('PH_WH DTbl_AllUserAndCYPValues'[User_Value_Forecast3_YtD])
			        
			    )
			RETURN
			    IF ( ISBLANK(anyValue), BLANK(), "●" )
			```
		lineageTag: 13a645de-45bd-488e-89db-f43468ceded5

	measure 'Dot Color ph' =
			
			VAR anyValue =
			    COALESCE (
			        SUM('PH_WH DTbl_AllUserAndCYPValues'[User_Value_Actual_YtD]),
			        SUM('PH_WH DTbl_AllUserAndCYPValues'[User_Value_Plan_YtD]),
			        SUM('PH_WH DTbl_AllUserAndCYPValues'[User_Value_Forecast1_YtD]),
			         SUM('PH_WH DTbl_AllUserAndCYPValues'[User_Value_Forecast2_YtD]),
			         SUM('PH_WH DTbl_AllUserAndCYPValues'[User_Value_Forecast3_YtD])
			    )
			VAR prelim =
			    SELECTEDVALUE ( 'PH_WH DTbl_AllUserAndCYPValues'[Is_Preliminary] )
			RETURN
			    IF (
			        ISBLANK ( anyValue ),
			        BLANK(),
			        IF ( prelim = TRUE(), "#D9D9D9", "#00AEEF" )
			    )
		lineageTag: 53cc3ca2-1a0b-4d76-ae10-6214b3591811

	measure 'ACT YTD ph' =
			
			DIVIDE( SUM('PH_WH DTbl_AllUserAndCYPValues'[User_Value_Actual_YtD]), 1000000 )
		lineageTag: c79ee95c-5e67-499b-8e30-bd9e8b624e29

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Plan YTD ph' =
			
			DIVIDE( SUM('PH_WH DTbl_AllUserAndCYPValues'[User_Value_Plan_YtD]), 1000000 )
		lineageTag: 64335455-ec10-4325-a7a7-78af7aeb3763

