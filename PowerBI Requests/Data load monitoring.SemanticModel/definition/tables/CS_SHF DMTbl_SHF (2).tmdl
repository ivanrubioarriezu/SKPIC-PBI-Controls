table 'CS_SHF DMTbl_SHF (2)'
	lineageTag: 708e68f0-f0e6-4fe1-aafe-023acb82f238

	measure s2 =
			
			VAR anyValue =
			    COALESCE (
			        SUM('CS_SHF DMTbl_SHF (2)'[Farmer_Actual]),
			        SUM('CS_SHF DMTbl_SHF (2)'[Farmer_Budget]),
			        SUM('CS_SHF DMTbl_SHF (2)'[Farmer_FC1]),
			        SUM('CS_SHF DMTbl_SHF (2)'[Farmer_FC2]),
			        SUM('CS_SHF DMTbl_SHF (2)'[Farmer_FC3])
			    )
			RETURN
			    IF ( ISBLANK(anyValue), BLANK(), "●" )
		lineageTag: 06bb8723-17d4-4562-90d5-3120bec17701

	measure 'Dot Color QA' =
			
			VAR anyValue =
			    COALESCE (
			        SUM('CS_SHF DMTbl_SHF (2)'[Farmer_Actual]),
			        SUM('CS_SHF DMTbl_SHF (2)'[Farmer_Budget]),
			        SUM('CS_SHF DMTbl_SHF (2)'[Farmer_FC1]),
			        SUM('CS_SHF DMTbl_SHF (2)'[Farmer_FC2]),
			        SUM('CS_SHF DMTbl_SHF (2)'[Farmer_FC3])
			    )
			VAR prelim =
			    SELECTEDVALUE ( 'CS_SHF DMTbl_SHF (2)'[Is_Preliminary] )
			RETURN
			    IF (
			        ISBLANK ( anyValue ),
			        BLANK(),
			        IF ( prelim = TRUE(), "#D9D9D9", "#00AEEF" )
			    )
