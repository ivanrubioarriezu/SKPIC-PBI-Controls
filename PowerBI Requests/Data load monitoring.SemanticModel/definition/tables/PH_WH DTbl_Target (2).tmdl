	measure 'Dot Color Target ph QA' = ```
			
			VAR anyValue =
			     (
			        SUM('PH_WH DTbl_Target (2)'[Target])
			       
			    )
			VAR prelim =
			    SELECTEDVALUE ('PH_WH DTbl_Target (2)'[Is_Preliminary] )
			RETURN
			    IF (
			        ISBLANK ( anyValue ),
			        BLANK(),
			        IF ( prelim = TRUE(), "#D9D9D9", "#00AEEF" )
			    )
			```
