table 'PH_WH DTbl_Target'
	lineageTag: c89b0bfc-5168-4b01-88a0-bc736fd0d92a

	measure 'Target ph' =
			
			DIVIDE( SUM('PH_WH DTbl_Target'[Target]), 1000000 )
		lineageTag: 197fc20b-7df3-4c3b-b263-44aebedb36cf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 's ph target' = ```
			
			VAR anyValue =
			    
			        SUM('PH_WH DTbl_Target'[Target])
			        
			        
			    
			RETURN
			    IF ( ISBLANK(anyValue), BLANK(), "●" )
			```
		lineageTag: 213e3b3d-d402-4ada-876a-22e3f47b720b

	measure 'Dot Color Target ph' = ```
			
			VAR anyValue =
			     (
			        SUM('PH_WH DTbl_Target'[Target])
			       
			    )
			VAR prelim =
			    SELECTEDVALUE ('PH_WH DTbl_Target'[Is_Preliminary] )
			RETURN
			    IF (
			        ISBLANK ( anyValue ),
			        BLANK(),
			        IF ( prelim = TRUE(), "#D9D9D9", "#00AEEF" )
			    )
			```
		lineageTag: ef6dff5a-80ff-4ab0-ad7e-69e6bd3e5a2f

