	measure 'Dot Color Target ch QA' = ```
			
			VAR anyValue =
			     (
			        SUM('CH_UP DMT_Target (2)'[Target])
			       
			    )
			VAR prelim =
			    SELECTEDVALUE ('CH_UP DMT_Target (2)'[Is_Preliminary] )
			RETURN
			    IF (
			        ISBLANK ( anyValue ),
			        BLANK(),
			        IF ( prelim = TRUE(), "#D9D9D9", "#00AEEF" )
			    )
			```
