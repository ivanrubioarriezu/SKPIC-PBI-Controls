table 'CS_SHF DMTbl_SHF'
	lineageTag: 4883da65-c415-44ac-aebd-9b20f93c86ce

	measure 'Dot Color' =
			
			VAR anyValue =
			    COALESCE (
			        SUM('CS_SHF DMTbl_SHF'[Farmer_Actual]),
			        SUM('CS_SHF DMTbl_SHF'[Farmer_Budget]),
			        SUM('CS_SHF DMTbl_SHF'[Farmer_FC1]),
			        SUM('CS_SHF DMTbl_SHF'[Farmer_FC2]),
			        SUM('CS_SHF DMTbl_SHF'[Farmer_FC3])
			    )
			VAR prelim =
			    SELECTEDVALUE ( 'CS_SHF DMTbl_SHF'[Is_Preliminary] )
			RETURN
			    IF (
			        ISBLANK ( anyValue ),
			        BLANK(),
			        IF ( prelim = TRUE(), "#D9D9D9", "#00AEEF" )
			    )
		lineageTag: 7ed7e1bf-876a-403d-bf9b-be9d91081ee0

	measure s =
			
			VAR anyValue =
			    COALESCE (
			        SUM('CS_SHF DMTbl_SHF'[Farmer_Actual]),
			        SUM('CS_SHF DMTbl_SHF'[Farmer_Budget]),
			        SUM('CS_SHF DMTbl_SHF'[Farmer_FC1]),
			        SUM('CS_SHF DMTbl_SHF'[Farmer_FC2]),
			        SUM('CS_SHF DMTbl_SHF'[Farmer_FC3])
			    )
			RETURN
			    IF ( ISBLANK(anyValue), BLANK(), "●" )
		lineageTag: ff944419-57fc-4e29-970f-8fefa95d56fd

