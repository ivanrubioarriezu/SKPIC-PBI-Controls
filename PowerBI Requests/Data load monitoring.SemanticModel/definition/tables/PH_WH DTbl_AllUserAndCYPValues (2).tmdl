table 'PH_WH DTbl_AllUserAndCYPValues (2)'
	lineageTag: 87a9065c-aefe-4234-8efd-da6570147480

	measure 'ACT YTD ph2' =
			
			DIVIDE( SUM('PH_WH DTbl_AllUserAndCYPValues (2)'[User_Value_Actual_YtD]), 1000000 )
		lineageTag: a1851054-0ec9-4beb-8001-02d84460c21d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure h2 = ```
			
			VAR anyValue =
			    COALESCE (
			        SUM('PH_WH DTbl_AllUserAndCYPValues (2)'[User_Value_Actual_YtD]),
			        SUM('PH_WH DTbl_AllUserAndCYPValues (2)'[User_Value_Plan_YtD]),
			        SUM('PH_WH DTbl_AllUserAndCYPValues (2)'[User_Value_Forecast1_YtD]),
			        SUM('PH_WH DTbl_AllUserAndCYPValues (2)'[User_Value_Forecast2_YtD]),
			         SUM('PH_WH DTbl_AllUserAndCYPValues (2)'[User_Value_Forecast3_YtD])
			        
			    )
			RETURN
			    IF ( ISBLANK(anyValue), BLANK(), "●" )
			```
		lineageTag: 6ce416f6-c517-4362-ae3b-e623d8e4a88c

	measure 'Dot Color ph QA' =
			
			VAR anyValue =
			    COALESCE (
			        SUM('PH_WH DTbl_AllUserAndCYPValues (2)'[User_Value_Actual_YtD]),
			        SUM('PH_WH DTbl_AllUserAndCYPValues (2)'[User_Value_Plan_YtD]),
			        SUM('PH_WH DTbl_AllUserAndCYPValues (2)'[User_Value_Forecast1_YtD]),
			         SUM('PH_WH DTbl_AllUserAndCYPValues (2)'[User_Value_Forecast2_YtD]),
			         SUM('PH_WH DTbl_AllUserAndCYPValues (2)'[User_Value_Forecast3_YtD])
			    )
			VAR prelim =
			    SELECTEDVALUE ( 'PH_WH DTbl_AllUserAndCYPValues (2)'[Is_Preliminary] )
			RETURN
			    IF (
			        ISBLANK ( anyValue ),
			        BLANK(),
			        IF ( prelim = TRUE(), "#D9D9D9", "#00AEEF" )
			    )
		lineageTag: 44d547ae-cce6-43e6-b286-a9c90ce2d44c

