table 'CS_SHF DMTbl_FarmerActual_Target_Timeline_Detail (2)'
	lineageTag: 326c9be4-4d50-429d-8772-e8f6a55845c7

	measure 'Dot Color Target QA' = ```
			
			VAR anyValue =
			     (
			        SUM('CS_SHF DMTbl_FarmerActual_Target_Timeline_Detail (2)'[Target])
			       
			    )
			VAR prelim =
			    SELECTEDVALUE ( 'CS_SHF DMTbl_FarmerActual_Target_Timeline_Detail (2)'[Is_Preliminary] )
			RETURN
			    IF (
			        ISBLANK ( anyValue ),
			        BLANK(),
			        IF ( prelim = TRUE(), "#D9D9D9", "#00AEEF" )
			    )
			```
