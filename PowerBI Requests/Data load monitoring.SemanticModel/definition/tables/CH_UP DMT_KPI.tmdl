	partition 'CH_UP DMT_KPI' = m
		mode: import
		source = ```
				let
				    Source = Value.NativeQuery(Databricks.Catalogs(hostname, httpPath, [Catalog=Catalogue, Database=null, EnableAutomaticProxyDiscovery="enabled"]){[Name=Catalogue,Kind="Database"]}[Data], 
				    "SELECT
				    fiscal_year AS Fiscal_Year,
				    fiscal_month AS Fiscal_Month,
				    fiscal_period AS Fiscal_Period,
				    is_current AS Is_Current,
				    geographical_location AS Geographical_Location,
				    region AS Region,
				    subregion AS Subregion,
				    impact AS Impact,
				    income_group AS Income_Group,
				    product_description AS Product_Description,
				    product_category AS Product_Category,
				    actual_cm AS Actual_Cm,
				    actual_pm_not_used AS Actual_Pm_Not_Used,
				    actual_ytd AS Actual_Ytd,
				    actual_pytd_not_used AS Actual_Pytd_Not_Used,
				    actual_bytd_not_used AS Actual_Bytd_Not_Used,
				    plan_ytd AS Plan_Ytd,
				    forecast_ytd AS Forecast_Ytd,
				    valid_from AS Valid_From,
				    valid_to AS Valid_To,
				    actual_bfy AS Actual_Bfy,
				    actual_bhy AS Actual_Bhy,
				    actual_pfy AS Actual_Pfy,
				    actual_phy AS Actual_Phy,
				    fiscal_date AS Fiscal_Date,
				    is_preliminary AS Is_Preliminary,
				    plan_ye AS Plan_Ye,
				    forecast_ye AS Forecast_Ye,
				    sku_class AS Sku_Class
				FROM generaldiscovery_intfc_sustainability_r.sus_skpic_ch_up_dmt_kpi_intfc_view"
				    , null, [EnableFolding=true])
				in
				    Source
				```

	annotation PBI_ResultType = Exception

