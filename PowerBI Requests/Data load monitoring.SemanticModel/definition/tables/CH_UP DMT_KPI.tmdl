table 'CH_UP DMT_KPI'
	lineageTag: a0ddfe99-fc07-4f56-870d-18f065709f60

	measure 's ch' = ```
			
			VAR anyValue =
			    COALESCE (
			        SUM('CH_UP DMT_KPI'[Actual_YtD]),
			        SUM('CH_UP DMT_KPI'[Plan_YtD])
			      
			        
			    )
			RETURN
			    IF ( ISBLANK(anyValue), BLANK(), "●" )
			```
		lineageTag: 0e66f3ae-75b4-4e58-9248-2e67bb9874d1

	measure 'Dot Color ch' = ```
			
			VAR anyValue =
			    COALESCE (
			        SUM('CH_UP DMT_KPI'[Actual_YtD]),
			        SUM('CH_UP DMT_KPI'[Plan_YtD])
			        
			    )
			VAR prelim =
			    SELECTEDVALUE ( 'CH_UP DMT_KPI'[Is_Preliminary] )
			RETURN
			    IF (
			        ISBLANK ( anyValue ),
			        BLANK(),
			        IF ( prelim = TRUE(), "#D9D9D9", "#00AEEF" )
			    )
			```
		lineageTag: 3fecd8cc-e7b2-440d-8c06-65de9f2476da

