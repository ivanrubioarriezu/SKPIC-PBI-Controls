table 'CS_SHF DMTbl_FarmerActual_Target_Timeline_Detail'
	lineageTag: 4ea3ec2e-b298-44a1-a04d-c85037a0504f

	measure sT = ```
			
			VAR anyValue =
			    
			        SUM('CS_SHF DMTbl_FarmerActual_Target_Timeline_Detail'[Target])
			        
			
			RETURN
			    IF ( ISBLANK(anyValue), BLANK(), "●" )
			```
		lineageTag: 915b44d8-302c-40de-87f6-9111ee74a992

	measure 'Target.' =
			
			DIVIDE( SUM('CS_SHF DMTbl_FarmerActual_Target_Timeline_Detail'[Target]), 1000000 )
		lineageTag: a90e65cb-e696-429a-a6cc-5ef807e4b56e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Dot Color Target' = ```
			
			VAR anyValue =
			     (
			        SUM('CS_SHF DMTbl_FarmerActual_Target_Timeline_Detail'[Target])
			       
			    )
			VAR prelim =
			    SELECTEDVALUE ( 'CS_SHF DMTbl_FarmerActual_Target_Timeline_Detail'[Is_Preliminary] )
			RETURN
			    IF (
			        ISBLANK ( anyValue ),
			        BLANK(),
			        IF ( prelim = TRUE(), "#D9D9D9", "#00AEEF" )
			    )
			```
		lineageTag: 33514427-8bdf-4936-a596-f2286f08d49f

	measure 'Target Display' =
			
			
			VAR FinalTarget =
			    CALCULATE(
			        MAX('CS_SHF DMTbl_FarmerActual_Target_Timeline_Detail'[Target]),
			        'CS_SHF DMTbl_FarmerActual_Target_Timeline_Detail'[Is_Preliminary] = FALSE()
			    )
			
			VAR PreliminaryTarget =
			    CALCULATE(
			        MAX('CS_SHF DMTbl_FarmerActual_Target_Timeline_Detail'[Target]),
			        'CS_SHF DMTbl_FarmerActual_Target_Timeline_Detail'[Is_Preliminary] = TRUE()
			    )
			
			RETURN
			    COALESCE(FinalTarget, PreliminaryTarget)
		lineageTag: 19ec53c8-a227-44dc-aa62-9161eb6a9d74

		annotation PBI_FormatHint = {"isGeneralNumber":true}

