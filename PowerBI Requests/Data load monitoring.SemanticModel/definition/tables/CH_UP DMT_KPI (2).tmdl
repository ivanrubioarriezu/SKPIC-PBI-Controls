table 'CH_UP DMT_KPI (2)'
	lineageTag: 82ae4a08-aac1-447b-961c-779f2818a384

	measure s2c = ```
			
			VAR anyValue =
			    COALESCE (
			        SUM('CH_UP DMT_KPI (2)'[Actual_YtD]),
			        SUM('CH_UP DMT_KPI (2)'[Plan_YtD])
			      
			        
			    )
			RETURN
			    IF ( ISBLANK(anyValue), BLANK(), "●" )
			```
		lineageTag: 94376ce6-628c-4b7c-8086-c93930481c00

	measure 'Dot Color ch QA' = ```
			
			VAR anyValue =
			    COALESCE (
			        SUM('CH_UP DMT_KPI (2)'[Actual_YtD]),
			        SUM('CH_UP DMT_KPI (2)'[Plan_YtD])
			        
			    )
			VAR prelim =
			    SELECTEDVALUE ( 'CH_UP DMT_KPI (2)'[Is_Preliminary] )
			RETURN
			    IF (
			        ISBLANK ( anyValue ),
			        BLANK(),
			        IF ( prelim = TRUE(), "#D9D9D9", "#00AEEF" )
			    )
			```
