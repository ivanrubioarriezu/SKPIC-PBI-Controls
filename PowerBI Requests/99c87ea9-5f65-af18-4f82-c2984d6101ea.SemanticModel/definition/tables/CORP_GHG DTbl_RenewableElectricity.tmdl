			                CALCULATE(SUM('CORP_GHG DTbl_RenewableElectricity'[Value])),
			                ,
			                ASC
			            )
			        -- Add more views as needed
			    )
			
			VAR CurrentValue = SUM('CORP_GHG DTbl_RenewableElectricity'[Value])
			
			RETURN
			IF(
