			                ALLSELECTED('Unique Country Ren Energy'[Country]),
			                CALCULATE(SUM('CORP_GHG DTbl_RenewableElectricity'[Value_PY])),
			                ,
			                DESC
			            ),
			        SelectedView = NAMEOF('Unique Country Ren Energy'[Country]) && NOT IsTop,
			            RANKX(
			                ALLSELECTED('Unique Country Ren Energy'[Country]),
			                CALCULATE(SUM('CORP_GHG DTbl_RenewableElectricity'[Value_PY])),
			                ,
			                ASC
			            ),
			        SelectedView = NAMEOF('Unique Business Unit Ren Energy'[Division]) && IsTop,
			            RANKX(
			                ALLSELECTED('Unique Business Unit Ren Energy'[Division]),
			                CALCULATE(SUM('CORP_GHG DTbl_RenewableElectricity'[Value_PY])),
			                ,
			                DESC
			            ),
			        SelectedView = NAMEOF('Unique Business Unit Ren Energy'[Division]) && NOT IsTop,
			            RANKX(
			                ALLSELECTED('Unique Business Unit Ren Energy'[Division]),
			                CALCULATE(SUM('CORP_GHG DTbl_RenewableElectricity'[Value_PY])),
			                ,
			                ASC
			            ),
			        SelectedView = NAMEOF('Unique Energy Type Ren Energy'[BaySIS_Description]) && IsTop,
			            RANKX(
			                ALLSELECTED('Unique Energy Type Ren Energy'[BaySIS_Description]),
			                CALCULATE(SUM('CORP_GHG DTbl_RenewableElectricity'[Value_PY])),
			                ,
			                DESC
			            ),
			        SelectedView = NAMEOF('Unique Energy Type Ren Energy'[BaySIS_Description]) && NOT IsTop,
			            RANKX(
			                ALLSELECTED('Unique Energy Type Ren Energy'[BaySIS_Description]),
			                CALCULATE(SUM('CORP_GHG DTbl_RenewableElectricity'[Value_PY])),
			                ,
			                ASC
			            ),
			        SelectedView = NAMEOF('Unique Site Ren Energy'[Site]) && IsTop,
			            RANKX(
			                ALLSELECTED('Unique Site Ren Energy'[Site]),
			                CALCULATE(SUM('CORP_GHG DTbl_RenewableElectricity'[Value_PY])),
			                ,
			                DESC
			            ),
			        SelectedView = NAMEOF('Unique Site Ren Energy'[Site]) && NOT IsTop,
			            RANKX(
			                ALLSELECTED('Unique Site Ren Energy'[Site]),
			                CALCULATE(SUM('CORP_GHG DTbl_RenewableElectricity'[Value_PY])),
			                ,
			                ASC
			            ),
			        SelectedView = NAMEOF('Unique Renewable energy Ren Energy'[Energy type classification]) && IsTop,
			            RANKX(
			                ALLSELECTED('Unique Renewable energy Ren Energy'[Energy type classification]),
			                CALCULATE(SUM('CORP_GHG DTbl_RenewableElectricity'[Value_PY])),
			                ,
			                DESC
			            ),
			        SelectedView = NAMEOF('Unique Renewable energy Ren Energy'[Energy type classification]) && NOT IsTop,
			            RANKX(
			                ALLSELECTED('Unique Renewable energy Ren Energy'[Energy type classification]),
			                CALCULATE(SUM('CORP_GHG DTbl_RenewableElectricity'[Value_PY])),
			                ,
			                ASC
			            ),
			        BLANK()
			    )
			
			RETURN
			IF(
			    RankValue <= SelectedRanking,
			    SUM('CORP_GHG DTbl_RenewableElectricity'[Value_PY])
			)
