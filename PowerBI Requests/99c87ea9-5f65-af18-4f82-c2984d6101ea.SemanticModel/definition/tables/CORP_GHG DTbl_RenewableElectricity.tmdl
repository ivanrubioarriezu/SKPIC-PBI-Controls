	column ActualYear =
			
			IF(
			    (
			        (
			            DAY(TODAY()) >= 29 && MONTH(TODAY()) = 1
			        ) || MONTH(TODAY()) > 1
			    ) && [Year] + 1 = YEAR(TODAY())
			    || [Year] < YEAR(TODAY()) - 1,
			    [Fiscal_Date],
			    BLANK()
			)
