	column 'Energy type classification' = ```
			
			SWITCH(
			    TRUE(),
			    
			    // Total Renewable Electricity
			    (
			        'CORP_GHG DTbl_RenewableElectricity'[Year] <= 2020 && 'CORP_GHG DTbl_RenewableElectricity'[BaySIS_Number] = "2530GA"
			    ) || (
			        'CORP_GHG DTbl_RenewableElectricity'[Year] > 2020 && 'CORP_GHG DTbl_RenewableElectricity'[BaySIS_Number] = "2530GE"
			    ),
			    "Total Renewable Electricity",
			
			    // Renewable Electricity Types
			    (
			        'CORP_GHG DTbl_RenewableElectricity'[Year] <= 2020 && 'CORP_GHG DTbl_RenewableElectricity'[BaySIS_Number] = "2530GA"
			    ) || (
			        'CORP_GHG DTbl_RenewableElectricity'[Year] > 2020 && 
			        'CORP_GHG DTbl_RenewableElectricity'[BaySIS_Number] IN {
			            "2530GEB", "2530GEG", "2530GEH", "2530GEO",
			            "2530GEP", "2530GES", "2530GEW", "2530GEX"
			        }
			    ),
			    "Renewable Electricity Types",
			
			    // Total Renewable Steam
			    'CORP_GHG DTbl_RenewableElectricity'[BaySIS_Number] = "2530GS",
			    "Total Renewable Steam",
			
			    // Renewable Steam Types
			    'CORP_GHG DTbl_RenewableElectricity'[BaySIS_Number] IN { "2530GSB", "2530GSG", "2530GSO", "2530GSS" },
			    "Renewable Steam Types",
			
			    // Total Electricity
			    'CORP_GHG DTbl_RenewableElectricity'[BaySIS_Number] = "2505",
			    "Total Electricity",
			
			    // Default
			    BLANK()
			)
			
