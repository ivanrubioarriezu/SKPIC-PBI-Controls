	measure 'Ranking by Actual emission ren energy format' = FORMAT([Ranking by Actual Emission Ren.Energy], "#,##0.00") & " TJ"
		lineageTag: 32262816-37da-45d5-a8d2-e10e64b268f1

	measure 'Test Ranking by Actual Emission Ren.Energy' =
			
			VAR SelectedRanking = SELECTEDVALUE('Ranking Option Ren Energy'[Ranking Option Ren Energy])
			VAR IsTop = SELECTEDVALUE('Top/Bottom Ren Energy'[Value]) = "Top"
			
			VAR RankValue =
			    SWITCH(
			        TRUE(),
			        IsTop,
			            RANKX(
			                ALLSELECTED('CORP_GHG DTbl_RenewableElectricity'[Country]),
			                CALCULATE(SUM('CORP_GHG DTbl_RenewableElectricity'[Value])),
			                ,
			                DESC
			            ),
			        NOT IsTop,
			            RANKX(
			                ALLSELECTED('CORP_GHG DTbl_RenewableElectricity'[Country]),
			                CALCULATE(SUM('CORP_GHG DTbl_RenewableElectricity'[Value])),
			                ,
			                ASC
			            )
			    )
			RETURN
			IF(
			    RankValue <= SelectedRanking,
			    SUM('CORP_GHG DTbl_RenewableElectricity'[Value]),
			    BLANK()
			)
		lineageTag: bf64096d-9509-4e66-b8cc-0e6bce6074cd

