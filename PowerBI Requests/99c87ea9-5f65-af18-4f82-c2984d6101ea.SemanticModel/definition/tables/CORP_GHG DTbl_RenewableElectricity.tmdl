table 'CORP_GHG DTbl_RenewableElectricity'
	lineageTag: a36bdc76-f858-4e8e-9139-8a599924ef9e

	measure 'Ren.Elec (abs) _CY' = ```
			
			
			CALCULATE(
			    SUM('CORP_GHG DTbl_RenewableElectricity'[Value]),
			    'CORP_GHG DTbl_RenewableElectricity'[Energy type classification] = "Total Renewable Electricity"
			)
			
			```
		lineageTag: 84aa5bbb-cda8-4e27-b6be-6f21e25e224d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total.Elec (abs)_CY' = ```
			
			CALCULATE(
			    SUM('CORP_GHG DTbl_RenewableElectricity'[Value]),
			    'CORP_GHG DTbl_RenewableElectricity'[BaySIS_Number] = "2505"
			)
			
			```
		lineageTag: dfdcb70c-9d19-4d76-b39f-097935816097

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ren.Elec (%)_CY' = ```
			
			DIVIDE(
			    ('CORP_GHG DTbl_RenewableElectricity'[Ren.Elec (abs) _CY]),
			    ('CORP_GHG DTbl_RenewableElectricity'[Total.Elec (abs)_CY]),
			    0
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: dcdce788-4853-433a-a978-c74fc33c36b4

	measure 'Ranking by Actual Emission Ren.Energy' =
			
			VAR _topCategory=SWITCH(TRUE(),SELECTEDVALUE('View by Ren.energy'[View by Ren.energy Fields]) ="'CORP_GHG DTbl_RenewableElectricity'[Country]",RANKX(ALLSELECTED('CORP_GHG DTbl_RenewableElectricity'[Country]),SUM('CORP_GHG DTbl_RenewableElectricity'[Value]),,DESC),
			SELECTEDVALUE('View by Ren.energy'[View by Ren.energy Fields])= "'CORP_GHG DTbl_RenewableElectricity'[Division]",RANKX(ALLSELECTED('CORP_GHG DTbl_RenewableElectricity'[Division]),SUM('CORP_GHG DTbl_RenewableElectricity'[Value]),,DESC),
			SELECTEDVALUE('View by Ren.energy'[View by Ren.energy Fields])= "'CORP_GHG DTbl_RenewableElectricity'[Site]",RANKX(ALLSELECTED('CORP_GHG DTbl_RenewableElectricity'[Site]),SUM([Value]),,DESC),
			SELECTEDVALUE('View by Ren.energy'[View by Ren.energy Fields])= "'CORP_GHG DTbl_RenewableElectricity'[BaySIS_Description]",RANKX(ALLSELECTED('CORP_GHG DTbl_RenewableElectricity'[BaySIS_Description]),SUM([Value]),,DESC),
			SELECTEDVALUE('View by Ren.energy'[View by Ren.energy Fields])= "'CORP_GHG DTbl_RenewableElectricity'[Enery Type]",RANKX(ALLSELECTED('CORP_GHG DTbl_RenewableElectricity'[Energy Type]),SUM([Value]),,DESC))
			VAR _bottomCategory=SWITCH(TRUE(),SELECTEDVALUE('View by Ren.energy'[View by Ren.energy Fields]) = "'CORP_GHG DTbl_RenewableElectricity'[Country]",RANKX(ALLSELECTED('CORP_GHG DTbl_RenewableElectricity'[Country]),SUM('CORP_GHG DTbl_RenewableElectricity'[Value]),,ASC),
			SELECTEDVALUE('View by Ren.energy'[View by Ren.energy Fields])= "'CORP_GHG DTbl_RenewableElectricity'[Division]",RANKX(ALLSELECTED('CORP_GHG DTbl_RenewableElectricity'[Division]),SUM([Value]),,ASC),
			SELECTEDVALUE('View by Ren.energy'[View by Ren.energy Fields])= "'CORP_GHG DTbl_RenewableElectricity'[Site]",RANKX(ALLSELECTED('CORP_GHG DTbl_RenewableElectricity'[Site]),SUM([Value]),,ASC),
			SELECTEDVALUE('View by Ren.energy'[View by Ren.energy Fields])= "'CORP_GHG DTbl_RenewableElectricity'[BaySIS_Description]",RANKX(ALLSELECTED('CORP_GHG DTbl_RenewableElectricity'[BaySIS_Description]),SUM([Value]),,ASC),
			SELECTEDVALUE('View by Ren.energy'[View by Ren.energy Fields])= "'CORP_GHG DTbl_RenewableElectricity'[Enery Type]",RANKX(ALLSELECTED('CORP_GHG DTbl_RenewableElectricity'[Energy Type]),SUM([Value]),,ASC))
			VAR _rankVisible= IF(SELECTEDVALUE('Top/Bottom Ren Energy'[Value])="Top"
			,_topCategory
			,_bottomCategory
			)
			RETURN
			IF(_rankVisible<='Ranking Option Ren Energy'[Ranking Option Ren Energy Value],SUM('CORP_GHG DTbl_RenewableElectricity'[Value]))
