table 'CORP_GHG DMV_Scope3_Target_Overall'
	lineageTag: 05b4bd61-7b2f-4f45-af04-18329c53db6a

	measure 'Aggregated Target Emission Reduction %' =
			
			DIVIDE(COALESCE(SUM([Aggregated Target Emission]), 0) - COALESCE(SUM([Aggregated Target Emission BY]), 0),COALESCE(SUM([Aggregated Target Emission BY]), 0))
		lineageTag: dde4981e-fbf5-458b-baaa-74895d7fb2a4

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Actual Emission Reduction %' =
			
			DIVIDE(SUM([Actual Emission SBT]) - SUM([Actual Emission BY]),
			SUM([Actual Emission BY]))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 999032ca-a1f7-447a-bd93-7a37f1b46dbf

		changedProperty = IsHidden

	measure 'Show Confirmed Targets' = IF(SELECTEDVALUE('Confirmed targets'[Value]) = "Show Confirmed Targets", 1, 0)
		formatString: 0
		lineageTag: b21d25cb-a90c-46b7-b7ac-d30c40731008

		changedProperty = IsHidden

	measure 'Hide Confirmed Targets' = IF(SELECTEDVALUE('Confirmed targets'[Value]) = "Hide Confirmed Targets", 1, 0)
		formatString: 0
		lineageTag: 403347ab-93f8-4ca5-9305-8ddce400c362

		changedProperty = IsHidden

	measure '_Actual Emission SBT' = SUM('CORP_GHG DMV_Scope3_Target_Overall'[CO2e_Actual])
		lineageTag: f9fdc09c-841b-453f-869c-8358e3ec5325

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Actual Emission BY' =
			
			IF (
			    NOT ISBLANK([_Actual Emission SBT]),
			    CALCULATE (
			        MAX('CORP_GHG DMV_Scope3_Target_Overall'[CO2e_Actual]),
			        FILTER (
			            ALL('CORP_GHG DMV_Scope3_Target_Overall'),
			            'CORP_GHG DMV_Scope3_Target_Overall'[Year] = 2019
			        )
			    )
			)
		lineageTag: 50284e5d-aedc-4724-b74d-5786cf3bca1a

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Actual Emission Reduction % red' =
			
			VAR ActualEmissionSBT = [_Actual Emission SBT]
			VAR ActualEmissionBY = [_Actual Emission BY]
			
			RETURN
			DIVIDE(ActualEmissionSBT - ActualEmissionBY, ActualEmissionBY)
		lineageTag: a450c840-03ae-479e-b07a-c824b9b009b2

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Aggregated Target Emission' =
			
			CALCULATE(
			    SUM('CORP_GHG DMV_Scope3_Target_Overall'[CO2e_Target_Aggregated]),
			    'CORP_GHG DMV_Scope3_Target_Overall'[SBT_relevant] = TRUE()
			)
		lineageTag: 930371f3-44a8-480d-8cbd-4cee8b9f45e8

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Aggregated Target Emission BY' =
			
			IF (
			    NOT ISBLANK([_Aggregated Target Emission]),
			    CALCULATE (
			        MAX('CORP_GHG DMV_Scope3_Target_Overall'[CO2e_Target_Aggregated]),
			        FILTER (
			            ALL('CORP_GHG DMV_Scope3_Target_Overall'),
			            'CORP_GHG DMV_Scope3_Target_Overall'[Year] = 2019 && 'CORP_GHG DMV_Scope3_Target_Overall'[SBT_relevant] = TRUE()
			        )
			    )
			)
		lineageTag: 4c6628f5-3f25-476f-9841-6b3075afe1be

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Aggregated Target Emission Reduction %' =
			
			VAR TargetEmission = COALESCE([_Aggregated Target Emission], 0)
			VAR TargetEmissionBY = COALESCE([_Aggregated Target Emission BY], 0)
			
			RETURN
			DIVIDE(TargetEmission - TargetEmissionBY, TargetEmissionBY)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4647b11a-350e-4596-a07d-2ad1ca4a31cd

		changedProperty = IsHidden

	measure '_Total Target Emission' =
			
			CALCULATE(
			    SUM('CORP_GHG DMV_Scope3_Target_Overall'[CO2e_Target_Total]),
			    'CORP_GHG DMV_Scope3_Target_Overall'[SBT_relevant] = TRUE()
			)
		lineageTag: 6a0f745b-fb92-4301-8011-8670ca4722d2

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Total Target Emission Reduction %' =
			
			/*VAR TotalTargetEmission = [_Aggregated Target Emission BY]
			VAR AggregatedTargetEmissionBY = [_Total Target Emission]
			
			RETURN
			DIVIDE(TotalTargetEmission - AggregatedTargetEmissionBY, -AggregatedTargetEmissionBY)*/
			
			
			VAR _Year = SELECTEDVALUE('CORP_GHG DMV_Scope3_Target_Overall'[Year])
			
			RETURN
			IF(
			    _Year >= 2026,
			    DIVIDE(
			        [_Total Target Emission] - [_Aggregated Target Emission BY],
			        [_Aggregated Target Emission BY]
			    ),
			    BLANK()
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 7eb31f45-f8de-40ed-895b-97c11bfc672d

		changedProperty = IsHidden

	measure '1Actual Emission' = SUM('CORP_GHG DMV_Scope3_Target_Overall'[Actual Emission SBT]) & " " &"CO2e"
