model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["hostname","httpPath","Catalogue","CORP_GHG DMV_Scope3_Target_Overall","PH_WH LTbl_ParameterChangeResults","CH_UP DMV_SKU_Type","CH_UP DMV_Scope_SKU","CH_UP DMV_Scope_Brand","CH_UP DMV_SalesData_Correction","CH_UP DMV_SalesData_Cleansed","CH_UP DMV_SalesData","CH_UP DMT_KPI","CH_UP LTbl_ParameterChangeResults","stored procedureCS_SHF DMF_Diff_VegSeeds","Stored Procedure CS_SHF DMF_YtY_Diff_Type","CS_SHF DMV_Parameter_Set","CS_SHF DMTbl_ParameterSet","CS_SHF LTbl_ParameterChangeResults","stored procedure CS_SHF DMTbl_SHF","PH_WH DTbl_AllUserAndCYPValues","PH_WH DMV_Blacklist","PH_WH DMV_Missing_Sectors","PH_WH DMV_SalesData","PH_WH DMV_SalesData_Cleansed","PH_WH DMF_SalesDataAdapted_Extract","PH_WH DMF_SalesDataBlacklist_Extract (2)","PH_WH DMF_SalesDataDistributed_Extract","PH_WH DMV_Whitelist","PH_WH DMV_SAP_Erroneous_Bookings"]

ref table 'CORP_GHG DMV_Scope3_Target_Overall'
ref table 'PH_WH LTbl_ParameterChangeResults'
ref table 'CH_UP DMV_SKU_Type'
ref table 'CH_UP DMV_Scope_SKU'
ref table 'CH_UP DMV_Scope_Brand'
ref table 'CH_UP DMV_SalesData_Correction'
ref table 'CH_UP DMV_SalesData_Cleansed'
ref table 'CH_UP DMV_SalesData'
ref table 'CH_UP DMT_KPI'
ref table 'CH_UP LTbl_ParameterChangeResults'
ref table 'stored procedureCS_SHF DMF_Diff_VegSeeds'
ref table 'Stored Procedure CS_SHF DMF_YtY_Diff_Type'
ref table 'CS_SHF DMV_Parameter_Set'
ref table 'CS_SHF DMTbl_ParameterSet'
ref table 'CS_SHF LTbl_ParameterChangeResults'
ref table 'stored procedure CS_SHF DMTbl_SHF'
ref table 'PH_WH DTbl_AllUserAndCYPValues'
ref table 'PH_WH DMV_Blacklist'
ref table 'PH_WH DMV_Missing_Sectors'
ref table 'PH_WH DMV_SalesData'
ref table 'PH_WH DMV_SalesData_Cleansed'
ref table 'PH_WH DMF_SalesDataAdapted_Extract'
ref table 'PH_WH DMF_SalesDataDistributed_Extract'
ref table 'PH_WH DMV_Whitelist'
ref table 'PH_WH DMV_SAP_Erroneous_Bookings'
