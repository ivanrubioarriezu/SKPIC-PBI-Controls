	partition 'CH_UP LTbl_ParameterChangeResults' = m
		mode: import
		source = ```
				let
				    Source = Value.NativeQuery(Databricks.Catalogs(hostname, httpPath, [Catalog=Catalogue, Database=null, EnableAutomaticProxyDiscovery="enabled"]){[Name=Catalogue,Kind="Database"]}[Data], 
				    "SELECT 
				    affected_parameter           AS Affected_Parameter,
				    affected_table               AS Affected_Table,
				    current_version              AS Current_Version,
				    diff                         AS diff,
				    info                         AS Info,
				    previous_version             AS Previous_Version,
				    parameter_dimensions        AS Parameter_Dimensions,
				    valid_from_current           AS valid_from_current,
				    valid_from_previous_version  AS valid_from_previous_version
				FROM generaldiscovery_intfc_sustainability_r.sus_skpic_ch_up_dmt_parameter_change_results_intfc_view"
				    , null, [EnableFolding=true])
				in
				    Source
				```

