	partition 'CH_UP DMV_SalesData' = m
		mode: import
		source = ```
				let
				    Source = Value.NativeQuery(Databricks.Catalogs(hostname, httpPath, [Catalog=Catalogue, Database=null, EnableAutomaticProxyDiscovery="enabled"]){[Name=Catalogue,Kind="Database"]}[Data], 
				    "SELECT
				    `0vtype`                  AS `0VTYPE`,
				    `0version`                AS `0VERSION`,
				    fiscyear                  AS FISCYEAR,
				    period                    AS PERIOD,
				    `0fiscper`                AS `0FISCPER`,
				    dctry_fd                  AS DCTRY_FD,
				    dctry_fd___t              AS DCTRY_FD___T,
				    drespo__dimkka2           AS DRESPO__DIMKKA2,
				    drespo__dimkka2___t       AS DRESPO__DIMKKA2___T,
				    drespo__dimkka6           AS DRESPO__DIMKKA6,
				    drespo__dimkka6___t       AS DRESPO__DIMKKA6___T,
				    drespo__dpc_cv            AS DRESPO__DPC_CV,
				    drespo__dpc_cv___t        AS DRESPO__DPC_CV___T,
				    drespo__dbrand            AS DRESPO__DBRAND,
				    drespo__dbrand___t        AS DRESPO__DBRAND___T,
				    `0material__dprodh1`      AS `0MATERIAL__DPRODH1`,
				    `0material__dprodh1___t`  AS `0MATERIAL__DPRODH1___T`,
				    `0material`               AS `0MATERIAL`,
				    `0material___t`           AS `0MATERIAL___T`,
				    `0loc_currcy`             AS `0LOC_CURRCY`,
				    `0base_uom`               AS `0BASE_UOM`,
				    fper_qtd_cu               AS FPER_QTD_CU,
				    last_updated              AS LAST_UPDATED
				FROM generaldiscovery_intfc_sustainability_r.sus_skpic_ch_up_dmt_salesdata_intfc_view"
				    , null, [EnableFolding=true])
				in
				    Source
				```

