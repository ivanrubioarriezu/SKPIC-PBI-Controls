	partition 'PH_WH DMF_SalesDataAdapted_Extract' = m
		mode: import
		source = ```
				let
				    Source = Value.NativeQuery(Databricks.Catalogs(hostname, httpPath, [Catalog=Catalogue, Database=null, EnableAutomaticProxyDiscovery="enabled"]){[Name=Catalogue,Kind="Database"]}[Data], 
				    "SELECT
				    type                          AS Type,
				    fiscal_year                   AS fiscal_year,
				    fiscal_period                 AS fiscal_period,
				    geographical_location         AS geographical_location,
				    material                      AS material,
				    material_description          AS Material_Description,
				    sector                        AS sector,
				    product_description           AS product_description,
				    product_category_description  AS Product_Category_Description,
				    quantity                      AS quantity,
				    quantity_adapted              AS quantity_adapted
				FROM generaldiscovery_intfc_sustainability_r.sus_skpic_ph_wh_dmt_salesdata_adapted_extract_intfc_view"
				    , null, [EnableFolding=true])
				in
				    Source
				```

