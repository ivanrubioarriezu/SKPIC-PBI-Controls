	partition 'CS_SHF DMV_Parameter_Set' = m
		mode: import
		source = ```
				let
				    Source = Value.NativeQuery(Databricks.Catalogs(hostname, httpPath, [Catalog=Catalogue, Database=null, EnableAutomaticProxyDiscovery="enabled"]){[Name=Catalogue,Kind="Database"]}[Data], 
				    "SELECT
				    year                                         AS Year,
				    fiscal_period                                AS Fiscal_Period,
				    region                                       AS Region,
				    country                                      AS Country,
				    crop_main_group                              AS Crop_Main_Group,
				    product                                      AS Product,
				    net_sales_dimension                          AS Net_Sales_Dimension,
				    net_sales_actual_ytd                         AS Net_Sales_Actual_YtD,
				    net_sales_budget_full_year                   AS Net_Sales_Budget_Full_Year,
				    net_sales_fc1_full_year                      AS Net_Sales_FC1_Full_Year,
				    net_sales_fc2_full_year                      AS Net_Sales_FC2_Full_Year,
				    net_sales_fc3_full_year                      AS Net_Sales_FC3_Full_Year,
				    average_bayer_farmer_spend_actual            AS Average_Bayer_Farmer_Spend_Actual,
				    average_bayer_farmer_spend_budget            AS Average_Bayer_Farmer_Spend_Budget,
				    average_bayer_farmer_spend_fc1               AS Average_Bayer_Farmer_Spend_FC1,
				    average_bayer_farmer_spend_fc2               AS Average_Bayer_Farmer_Spend_FC2,
				    average_bayer_farmer_spend_fc3               AS Average_Bayer_Farmer_Spend_FC3,
				    avg_farm_size_ha                             AS Avg_Farm_Size_ha,
				    sh_share                                     AS SH_Share,
				    seeding_rate_kg_ha                           AS Seeding_Rate_kg_ha,
				    number_of_seasons                            AS Number_of_Seasons,
				    sh_farmer_actual_ytd                         AS SH_Farmer_Actual_YtD,
				    number_of_unique_sh_farmers_actual_ytd       AS Number_of_Unique_SH_Farmers_Actual_YtD,
				    sh_farmer_budget_full_year                   AS SH_Farmer_Budget_Full_Year,
				    number_of_unique_sh_farmers_budget_full_year AS Number_of_Unique_SH_Farmers_Budget_Full_Year,
				    sh_farmer_fc1_full_year                      AS SH_Farmer_FC1_Full_Year,
				    number_of_unique_sh_farmers_fc1_full_year    AS Number_of_Unique_SH_Farmers_FC1_Full_Year,
				    sh_farmer_fc2_full_year                      AS SH_Farmer_FC2_Full_Year,
				    number_of_unique_sh_farmers_fc2_full_year    AS Number_of_Unique_SH_Farmers_FC2_Full_Year,
				    sh_farmer_fc3_full_year                      AS SH_Farmer_FC3_Full_Year,
				    number_of_unique_sh_farmers_fc3_full_year    AS Number_of_Unique_SH_Farmers_FC3_Full_Year
				FROM generaldiscovery_intfc_sustainability_r.sus_skpic_cs_shf_dmt_parameter_set_intfc_view"
				    , null, [EnableFolding=true])
				in
				    Source
				```

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

