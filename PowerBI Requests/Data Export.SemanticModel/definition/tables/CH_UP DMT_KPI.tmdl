table 'CH_UP DMT_KPI'
	lineageTag: 9c7564c2-1acc-42c8-8e7f-fe12dd0f77ee

	measure Pillar_SKU_Class =
			
			VAR Pillar =
			    SWITCH(
			        SELECTEDVALUE('CH_UP DMT_KPI'[Impact]),
			        "Campaign", "Partnerships",
			        "Commercial"
			    )
			VAR SKUClass =
			    SELECTEDVALUE('CH_UP DMT_KPI'[SKU_Class])
			RETURN
			    IF(
			        Pillar = "Partnerships",
			        "Partnerships",
			        Pillar & " - " & SKUClass
			    )
		lineageTag: 9bb5bf05-fb5e-4691-9992-0dcadb55d2eb

