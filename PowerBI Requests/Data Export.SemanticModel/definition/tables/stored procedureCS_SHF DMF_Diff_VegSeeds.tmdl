	partition 'stored procedureCS_SHF DMF_Diff_VegSeeds' = m
		mode: import
		source = ```
				let
				    Source = Value.NativeQuery(Databricks.Catalogs(hostname, httpPath, [Catalog=Catalogue, Database=null, EnableAutomaticProxyDiscovery="enabled"]){[Name=Catalogue,Kind="Database"]}[Data], 
				    "SELECT
				    REGION                              AS Region,
				    COUNTRY                             AS Country,
				    CROP                                AS Crop,
				    CROP_MAIN_GROUP                     AS Crop_Main_Group,
				    PRODUCT                             AS Product,
				    FISCAL_PERIOD_BASE                  AS Fiscal_Period_base,
				    VALUE_TYPE_BASE                     AS Value_Type_base,
				    VALUE_TYPE_TARGET                   AS Value_Type_trg,
				    NETSALES_EUR_BASE                   AS Netsales_EUR_base,
				    AVERAGE_BAYER_FARMER_SPEND_EUR_BASE AS Average_Bayer_Farmer_Spend_EUR_base,
				    AVG_FARM_SIZE_HA_BASE               AS Avg_Farm_Size_ha_base,
				    SH_SHARE_BASE                       AS SH_Share_base,
				    NUMBER_OF_GROWERS_BASE              AS Number_of_growers_base,
				    NUMBER_OF_FARMERS_BASE              AS Number_of_Farmers_base,
				    NUMBER_OF_UNIQUE_SH_FARMERS_BASE    AS Number_of_Unique_SH_Farmers_base,
				    SH_FARMER_BASE                      AS SH_Farmer_base,
				    FISCAL_PERIOD_TRG                   AS Fiscal_Period_trg,
				    NETSALES_EUR_TRG                    AS Netsales_EUR_trg,
				    AVERAGE_BAYER_FARMER_SPEND_EUR_TRG  AS Average_Bayer_Farmer_Spend_EUR_trg,
				    AVG_FARM_SIZE_HA_TRG                AS Avg_Farm_Size_ha_trg,
				    SH_SHARE_TRG                        AS SH_Share_trg,
				    NUMBER_OF_GROWERS_TRG               AS Number_of_growers_trg,
				    NUMBER_OF_FARMERS_TRG               AS Number_of_Farmers_trg,
				    NUMBER_OF_UNIQUE_SH_FARMERS_TRG     AS Number_of_Unique_SH_Farmers_trg,
				    SH_FARMER_TRG                       AS SH_Farmer_trg,
				    NETSALES_DIFF                       AS Netsales_Diff,
				    NETSALES_DIFF_REL                   AS Netsales_Diff_Rel,
				    AVERAGE_BAYER_FARMER_SPEND_DIFF     AS Average_Bayer_Farmer_Spend_Diff,
				    AVERAGE_BAYER_FARMER_SPEND_DIFF_REL AS Average_Bayer_Farmer_Spend_Diff_Rel,
				    NUMBER_OF_GROWERS_DIFF              AS Number_of_growers_Diff,
				    NUMBER_OF_GROWERS_DIFF_REL          AS Number_of_growers_Diff_Rel,
				    SHF_DIFF                            AS SHF_Diff,
				    SHF_DIFF_REL                        AS SHF_Diff_Rel,
				    OPTIME                              AS Optime,
				    OPSYS                               AS Opsys,
				    OPTYPE                              AS Optype,
				    DBX_OPTIME                          AS Dbx_Optime,
				    DIV_FLAG                            AS Div_Flag
				FROM generaldiscovery_sustainability_r.skpic_cs_shf_dmt_yty_diff_vegseeds_act_view"
				    , null, [EnableFolding=true])
				in
				    Source
				```

