	partition 'stored procedure CS_SHF DMTbl_SHF' = m
		mode: import
		source = ```
				let
				    Source = Value.NativeQuery(Databricks.Catalogs(hostname, httpPath, [Catalog=Catalogue, Database=null, EnableAutomaticProxyDiscovery="enabled"]){[Name=Catalogue,Kind="Database"]}[Data], 
				    "SELECT
				    fiscal_year                           AS Fiscal_Year,
				    fiscal_period                         AS Fiscal_Period,
				    sector                                AS Sector,
				    crop_main_group_description           AS Crop_Main_Group_Description,
				    geographical_location                 AS Geographical_Location,
				    country                               AS Country,
				    cluster                               AS Cluster,
				    region                                AS Region,
				
				    farmer_actual                         AS Farmer_Actual,
				    farmer_budget                         AS Farmer_Budget,
				    farmer_fc1                            AS Farmer_FC1,
				    farmer_fc2                            AS Farmer_FC2,
				    farmer_fc3                            AS Farmer_FC3,
				
				    valid_from                            AS Valid_From,
				    valid_to                              AS Valid_To,
				
				    farmer_actual_previous_not_used       AS Farmer_Actual_Previous_Not_Used,
				    farmer_actual_previous_half_year      AS Farmer_Actual_Previous_Half_Year,
				    farmer_actual_previous_full_year      AS Farmer_Actual_Previous_Full_Year,
				
				    farmer_actual_baseline_not_used       AS Farmer_Actual_Baseline_Not_Used,
				    farmer_actual_baseline_half_year      AS Farmer_Actual_Baseline_Half_Year,
				    farmer_actual_baseline_full_year      AS Farmer_Actual_Baseline_Full_Year,
				
				    farmer_budget_half_year_not_used      AS Farmer_Budget_Half_Year_Not_Used,
				    farmer_budget_full_year               AS Farmer_Budget_Full_Year,
				
				    farmer_fc1_half_year                  AS Farmer_FC1_Half_Year,
				    farmer_fc1_full_year                  AS Farmer_FC1_Full_Year,
				
				    farmer_fc2_half_year                  AS Farmer_FC2_Half_Year,
				    farmer_fc2_full_year                  AS Farmer_FC2_Full_Year,
				
				    farmer_fc3_half_year                  AS Farmer_FC3_Half_Year,
				    farmer_fc3_full_year                  AS Farmer_FC3_Full_Year,
				
				    fiscal_date                           AS Fiscal_Date,
				    fiscal_month                          AS Fiscal_Month,
				
				    indication                            AS Indication,
				    is_preliminary                        AS Is_Preliminary,
				
				    farmer_budget_next_not_used           AS Farmer_Budget_Next_Not_Used,
				    farmer_budget_next_half_year_not_used AS Farmer_Budget_Next_Half_Year_Not_Used,
				    farmer_budget_next_full_year          AS Farmer_Budget_Next_Full_Year
				
				FROM generaldiscovery_intfc_sustainability_r.sus_skpic_cs_shf_dmt_shf_intfc_view"
				    , null, [EnableFolding=true])
				in
				    Source
				```

