table Dataset
	lineageTag: 67ee7cfa-8bc2-43d6-ad6b-020997c53b8e

	column 'Dashboard Section'
		dataType: string
		lineageTag: ee5aa83a-c289-4fb7-b79b-9a091670538b
		summarizeBy: none
		sourceColumn: Dashboard Section

		annotation SummarizationSetBy = Automatic

	column Dashboard
		dataType: string
		lineageTag: e476b23c-50d9-49f5-bca9-760c0db3c63d
		summarizeBy: none
		sourceColumn: Dashboard

		annotation SummarizationSetBy = Automatic

	column 'Key terms'
		dataType: string
		lineageTag: 47097210-f76b-4f6b-9ec2-e9364126851c
