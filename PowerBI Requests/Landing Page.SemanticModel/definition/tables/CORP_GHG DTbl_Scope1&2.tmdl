	measure 'Act new measure' = ```
			
			
			
			
			/*CALCULATE (
			    SUM ( 'CORP_GHG DTbl_Scope1&2'[Value] ),
			    'CORP_GHG DTbl_Scope1&2'[Is Target Filter] = 1,
