	measure '_test Scope 1&2 % (Own Operations)' = ```
			
			VAR _labelTextFromContext =
			    // Pick the year label from current visual context and ignore blanks
			    MAXX (
			        FILTER (
			            VALUES ( 'CORP_GHG DTbl_Scope1&2'[Reporting Year Label/Filter] ),
			            NOT ISBLANK ( 'CORP_GHG DTbl_Scope1&2'[Reporting Year Label/Filter] )
			        ),
			        'CORP_GHG DTbl_Scope1&2'[Reporting Year Label/Filter]
			    )
			
			VAR _yearFromLabel =
			    VAR _v = VALUE ( _labelTextFromContext )   // e.g., "2024" -> 2024; returns BLANK() if non-numeric/blank
			    RETURN IF ( ISBLANK ( _v ), BLANK (), _v )
			
			// Fallback: when there is no single label present in context (e.g., totals or the label field not used),
			// choose the latest Year that has data and a non-blank label, under Scope 1+2 & Is Target Filter = 0.
			VAR _fallbackYearWithData =
			    MAXX (
			        FILTER (
			            ALLSELECTED ( 'CORP_GHG DTbl_Scope1&2' ),
			            'CORP_GHG DTbl_Scope1&2'[Scope] = "Scope 1+2" &&
			            'CORP_GHG DTbl_Scope1&2'[Is Target Filter] = 0 &&
			            NOT ISBLANK ( 'CORP_GHG DTbl_Scope1&2'[Reporting Year Label/Filter] ) &&
			            NOT ISBLANK ( 'CORP_GHG DTbl_Scope1&2'[Value] )
			        ),
			        'CORP_GHG DTbl_Scope1&2'[Year]
			    )
			
			VAR _targetYear =
			    COALESCE ( _yearFromLabel, _fallbackYearWithData )
			
			// Reporting (numerator) for the targetYear
			VAR _reporting =
			    IF (
			        NOT ISBLANK ( _targetYear ),
			        CALCULATE (
			            SUM ( 'CORP_GHG DTbl_Scope1&2'[Value] ),
			            REMOVEFILTERS ( 'CORP_GHG DTbl_Scope1&2' ),
			            KEEPFILTERS ( 'CORP_GHG DTbl_Scope1&2'[Scope] = "Scope 1+2" ),
			            KEEPFILTERS ( 'CORP_GHG DTbl_Scope1&2'[Is Target Filter] = 0 ),
			
			            // Guard against (Blank) labels interfering even if that field is not in the visual
			            KEEPFILTERS (
			                FILTER (
			                    ALL ( 'CORP_GHG DTbl_Scope1&2'[Reporting Year Label/Filter] ),
			                    NOT ISBLANK ( 'CORP_GHG DTbl_Scope1&2'[Reporting Year Label/Filter] )
			                )
			            ),
			
			            // Apply virtual filter: Year = _targetYear (no need for filter pane selection)
			            TREATAS ( { _targetYear }, 'CORP_GHG DTbl_Scope1&2'[Year] )
			        )
			    )
			
			// Baseline (denominator) fixed to baseline year (BY 2019) with your flag
			VAR _baseline =
			    CALCULATE (
			        SUM ( 'CORP_GHG DTbl_Scope1&2'[Value] ),
			        REMOVEFILTERS ( 'CORP_GHG DTbl_Scope1&2' ),
			        KEEPFILTERS ( 'CORP_GHG DTbl_Scope1&2'[Scope] = "Scope 1+2" ),
			        KEEPFILTERS ( 'CORP_GHG DTbl_Scope1&2'[Is Target Filter] = 0 ),
			        KEEPFILTERS ( 'CORP_GHG DTbl_Scope1&2'[Baseline Year Filter] = 1 )
			    )
			
			RETURN
			1 - DIVIDE ( _reporting, _baseline, BLANK() )
			
			```
		formatString: 0%;-0%;0%
		lineageTag: 50316b61-d244-4fbf-91ac-4b4b74cf784a

	measure Target = ```
			
			VAR _offsettingSum =
			    CALCULATE (
			        SUM ( 'CORP_GHG DTbl_Scope1&2'[Value] ),
			        KEEPFILTERS ( 'CORP_GHG DTbl_Scope1&2'[Is Target Filter] = 1 ),
			        KEEPFILTERS ( 'CORP_GHG DTbl_Scope1&2'[Scope] = "Offsetting" )
			    )
			VAR _otherTargetSum =
			    CALCULATE (
			        SUM ( 'CORP_GHG DTbl_Scope1&2'[Value] ),
			        KEEPFILTERS ( 'CORP_GHG DTbl_Scope1&2'[Is Target Filter] = 1 ),
			        KEEPFILTERS ( 'CORP_GHG DTbl_Scope1&2'[Scope] <> "Offsetting" )
			    )
			RETURN
			IF (
			    NOT ISBLANK ( _offsettingSum ),
			    - _offsettingSum,
			    IF ( NOT ISBLANK ( _otherTargetSum ), _otherTargetSum, BLANK () )
			)
			
			```
		lineageTag: e6ca40b9-29c8-4888-befd-97ad3e53def1

