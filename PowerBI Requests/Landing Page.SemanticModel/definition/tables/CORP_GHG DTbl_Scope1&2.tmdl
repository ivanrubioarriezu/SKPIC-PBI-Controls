			        SUM([Value]),
			        KEEPFILTERS ( 'CORP_GHG DTbl_Scope1&2'[Is Target Filter] = 0 ),
			        KEEPFILTERS ( 'CORP_GHG DTbl_Scope1&2'[FY (Year Filter)] = 1 ),
			        KEEPFILTERS ( 'CORP_GHG DTbl_Scope1&2'[Scope] <> "Offsetting" )
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( _offsetting ) || NOT ISBLANK ( _otherScopes ),
