			VAR BaseRows =
			    FILTER (
			        ALLSELECTED ( 'CORP_GHG DTbl_Scope1&2' ),
			        'CORP_GHG DTbl_Scope1&2'[Is Target Filter] = 0
			            && 'CORP_GHG DTbl_Scope1&2'[FY (Year Filter)] = 1
			    )
			RETURN
			    SUMX (
			        BaseRows,
			        'CORP_GHG DTbl_Scope1&2'[Value]
			            * IF ( TRIM ( 'CORP_GHG DTbl_Scope1&2'[Scope] ) = "Offsetting", -1, 1 )
			    )
			
			
			
			
			
			
			
			
			   
			
			
			```
