		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Reporting Year (Text)' =
			
			VAR _Today = TODAY()
			VAR _CurrentYear = YEAR(_Today)
			VAR _ConditionDate =
			    ( ( DAY(_Today) >= 29 && MONTH(_Today) = 1 )
			        || MONTH(_Today) > 1 )
			
			RETURN
			MAXX (
			    FILTER (
			        ALL ( 'CORP_GHG DTbl_Scope1&2' ),
			        (
			            _ConditionDate
			                && 'CORP_GHG DTbl_Scope1&2'[Year] + 1 = _CurrentYear
			                && 'CORP_GHG DTbl_Scope1&2'[Is_Target] = FALSE ()
			        )
			        ||
			        'CORP_GHG DTbl_Scope1&2'[Year] = _CurrentYear - 1
			    ),
			    FORMAT ( 'CORP_GHG DTbl_Scope1&2'[Year], "0" )
			)
		lineageTag: c5d2b898-6ffa-40c3-a20c-22a737c181ff

	measure '_Scope 1+2 Reporting Year Value' =
			
			
			VAR _ReportingYearNum =
			    VALUE ( [Reporting Year (Text)] )
			RETURN
			CALCULATE (
			    SUM ( 'CORP_GHG DTbl_Scope1&2'[Value] ),
			    FILTER (
			        ALL ( 'CORP_GHG DTbl_Scope1&2' ),
			        'CORP_GHG DTbl_Scope1&2'[Is Target Filter] = 0
			            && 'CORP_GHG DTbl_Scope1&2'[Scope] = "Scope 1+2"
			            && 'CORP_GHG DTbl_Scope1&2'[Year] = _ReportingYearNum-1
			    )
			)
		lineageTag: 1a69ce0b-3cbe-4c7b-b268-fd8c527fca84

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Scope 1&2 Reduction' =
			
			VAR _ReportingValue =
			    COALESCE (
			         ( 'CORP_GHG DTbl_Scope1&2'[_Scope 1+2 Reporting Year Value] ),
			        0
			    )
			VAR _BaselineValue =
			    COALESCE (
			     ( 'CORP_GHG DTbl_Scope1&2'[_Scope 1&2_Baseline Year 2019] ),
			        0
			    )
			RETURN
			IF (
			    _BaselineValue = 0,
			    BLANK(),
			    1 - ( _ReportingValue / _BaselineValue )
			)
		formatString: 0.00%;-0.00%;0.00%
