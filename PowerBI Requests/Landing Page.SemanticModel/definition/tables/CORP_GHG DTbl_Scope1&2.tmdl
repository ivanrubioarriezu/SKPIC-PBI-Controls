		annotation SummarizationSetBy = Automatic

	column 'Reporting Year Label/Filter' =
			
			VAR _currentYear   = YEAR ( TODAY() )
			VAR _isFebOrLater  = ( MONTH ( TODAY() ) = 2 && DAY ( TODAY() ) >= 1 ) || ( MONTH ( TODAY() ) > 2 )
			VAR _targetYear    = IF ( _isFebOrLater, _currentYear - 1, _currentYear - 2 )
			RETURN
			IF (
			    'CORP_GHG DTbl_Scope1&2'[Fiscal_Date].[Year] = _targetYear,
			    FORMAT ('CORP_GHG DTbl_Scope1&2'[Fiscal_Date].[Year], "0" ),   -- STR(...) equivalent (text output)
			    BLANK()
			)
		lineageTag: 5c74cf25-2cfc-47db-bd4b-470806d3f023
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Is Target Filter' = ```
			
			IF ( 'CORP_GHG DTbl_Scope1&2'[Is_Target], 1, 0 )
			
			
			```
		formatString: 0
		lineageTag: 8f45eb6c-bc13-44ce-9248-9fafe790d00a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'column Scope 1&2_ Reporting Year' = ```
			
			SUMX (
			    FILTER (
			        'CORP_GHG DTbl_Scope1&2',
			        'CORP_GHG DTbl_Scope1&2'[Is Target Filter] = 0
			            && 'CORP_GHG DTbl_Scope1&2'[Scope] = "Scope 1+2"
			            && 'CORP_GHG DTbl_Scope1&2'[Reporting Year Label/Filter]
			                = FORMAT ( 'CORP_GHG DTbl_Scope1&2'[Year], "0" )
			    ),
			    SUM('CORP_GHG DTbl_Scope1&2'[Value]))
			
			```
		lineageTag: f6a0b0d7-cdeb-4b00-9d2e-79491af40841
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Baseline Year Filter' = ```
			
			
			IF (
			    'CORP_GHG DTbl_Scope1&2'[Year] = 2019,
			    1,
			    0
			)
			
			
			
			
			```
		formatString: 0
		lineageTag: ef616b5a-6575-4648-900c-b0b58d3a700a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Target clm' = ```
			
			VAR _offsettingSum =
			    CALCULATE (
			        SUM ( 'CORP_GHG DTbl_Scope1&2'[Value] ),
			        KEEPFILTERS ( 'CORP_GHG DTbl_Scope1&2'[Is Target Filter] = 1 ),
			        KEEPFILTERS ( 'CORP_GHG DTbl_Scope1&2'[Scope] = "Offsetting" )
			    )
			VAR _otherTargetSum =
			    CALCULATE (
			        SUM ( 'CORP_GHG DTbl_Scope1&2'[Value] ),
			        KEEPFILTERS ( 'CORP_GHG DTbl_Scope1&2'[Is Target Filter] = 1 ),
			        KEEPFILTERS ( 'CORP_GHG DTbl_Scope1&2'[Scope] <> "Offsetting" )
			    )
			RETURN
			IF (
			    NOT ISBLANK ( _offsettingSum ),
			    - _offsettingSum,
			    IF ( NOT ISBLANK ( _otherTargetSum ), _otherTargetSum, BLANK () )
			)
			
			```
		lineageTag: 1ea9fcde-0440-4cfd-968d-ca0473ce4d3a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column ACT = ```
			
			VAR _isTarget  = 'CORP_GHG DTbl_Scope1&2'[Is Target Filter]        -- 0/1
			VAR _scope     = 'CORP_GHG DTbl_Scope1&2'[Scope]                   -- text
			VAR _fyFlag    = 'CORP_GHG DTbl_Scope1&2'[FY (Year Filter)]        -- 0/1
			VAR _value     = 'CORP_GHG DTbl_Scope1&2'[Value]                   -- numeric
			RETURN
			IF (
			    _isTarget = 0 && _fyFlag = 1,
			    IF ( _scope = "Offsetting", -_value, _value ),
			    BLANK ()
			)
			
			
			```
		lineageTag: 4c1ad046-38df-4c74-af4a-562887acaa94
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'FY (Year Filter)' = ```
			
			VAR _today        = TODAY()
			VAR _curYear      = YEAR ( _today )
			VAR _isAfterJan29 =
			    ( ( DAY ( _today ) >= 29 && MONTH ( _today ) = 1 )
			      || ( MONTH ( _today ) > 1 ) )
			
			VAR _year =
			    SELECTEDVALUE ( 'CORP_GHG DTbl_Scope1&2'[Year] )   // numeric year expected
			
			VAR _isTarget =
			    SELECTEDVALUE ( 'CORP_GHG DTbl_Scope1&2'[Is_Target] )  // Boolean expected; if 1/0, adjust below
			
			VAR _condCurrent =
			    _isAfterJan29
			        && NOT ISBLANK ( _year )
			        && ( _year + 1 = _curYear )
			        && ( NOT _isTarget )
			
			VAR _condPast =
			    NOT ISBLANK ( _year )
			        && ( _year < ( _curYear - 1 ) )
			
			RETURN
			IF ( _condCurrent || _condPast, 1, 0 )
			
			```
		formatString: 0
		lineageTag: 8076c053-e069-4384-ad27-b88de21b83e0
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

