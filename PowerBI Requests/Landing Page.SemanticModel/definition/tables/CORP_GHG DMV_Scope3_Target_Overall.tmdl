		sourceColumn: Co2e_Actual

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition 'CORP_GHG DMV_Scope3_Target_Overall' = m
		mode: import
		source = ```
				let
				    Origen = Value.NativeQuery(Databricks.Catalogs(hostname, httpPath, [Catalog=Catalogue, Database=null, EnableAutomaticProxyDiscovery="enabled"]){[Name=Catalogue,Kind="Database"]}[Data], 
				    "SELECT
				    year AS Year,
				    sbt_relevant AS SBT_Relevant,
				    co2e_target_aggregated AS Co2e_Target_Aggregated,
				    co2e_target_total AS Co2e_Target_Total,
				    co2e_actual AS Co2e_Actual
				FROM generaldiscovery_intfc_sustainability_r.sus_skpic_corp_ghg_dmt_scope3_target_overall_intfc_view"
				    , null, [EnableFolding=true])
				in
				    Origen
				```

