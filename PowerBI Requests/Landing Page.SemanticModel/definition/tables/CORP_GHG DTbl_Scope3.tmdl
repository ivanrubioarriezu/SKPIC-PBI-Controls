	column 'FY (Year Filter)' = ```
			
			VAR _todayYear  = YEAR ( TODAY() )
			VAR _todayMonth = MONTH ( TODAY() )
			VAR _todayDay   = DAY ( TODAY() )
			VAR _isFebOrLater =
			    (_todayMonth > 1) || (_todayMonth = 1 && _todayDay >= 29)
			
			VAR _year     = 'CORP_GHG DTbl_Scope3'[Year]
			VAR _isTarget = 'CORP_GHG DTbl_Scope3'[Is_Target]  -- Boolean/0-1
			
			VAR _condA = _isFebOrLater && (_year + 1 = _todayYear) && (NOT _isTarget)
			VAR _condB = _year < (_todayYear - 1)
			
			RETURN IF ( _condA || _condB, 1, BLANK() )
			
			```
		formatString: 0
		lineageTag: 8cde3866-ce6d-4a4c-8399-deeac0bc222c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'new Reporting_Year_Label' =
			
			VAR _currentYear  = YEAR ( TODAY() )
			VAR _isJanOrLater =
			    ( MONTH ( TODAY() ) = 1 && DAY ( TODAY() ) >= 29 )
			    || ( MONTH ( TODAY() ) > 1 )
			
			VAR _condYMinus1 =
			    _isJanOrLater
			    && ( 'CORP_GHG DTbl_Scope3'[Fiscal_Date].[Year] + 1 = _currentYear )
			    && ( 'CORP_GHG DTbl_Scope3'[Is_Target] = FALSE() )
			
			VAR _condYMinus1_Only =
			    'CORP_GHG DTbl_Scope3'[Fiscal_Date].[Year] = _currentYear - 1
			
			RETURN
			IF (
			    _condYMinus1 || _condYMinus1_Only,
			    FORMAT ( 'CORP_GHG DTbl_Scope3'[Fiscal_Date].[Year], "0" ),
			    BLANK()
			)
		lineageTag: 3d28571b-5977-441b-8313-cdd485e8309b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

