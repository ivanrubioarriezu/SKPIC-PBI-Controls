			    SUM('CORP_GHG DTbl_Scope3'[Is Target Filter]) = 0 && 
			    SUM('CORP_GHG DTbl_Scope3'[SBT_Relevant]) = TRUE(),
			    CALCULATE(SUM('CORP_GHG DTbl_Scope3'[CO2e])),
