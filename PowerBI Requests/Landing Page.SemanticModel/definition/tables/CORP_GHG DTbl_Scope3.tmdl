	partition 'CORP_GHG DTbl_Scope3' = m
		mode: import
		source = ```
				let
				    Source = Value.NativeQuery(Databricks.Catalogs(hostname, httpPath, [Catalog=Catalogue, Database=null, EnableAutomaticProxyDiscovery="enabled"]){[Name=Catalogue,Kind="Database"]}[Data], 
				    "SELECT
				    year AS Year,
				    co2_scope_3_category AS Co2_Scope_3_Category,
				    business_unit AS Business_Unit,
				    country AS Country,
				    vendor_country AS Vendor_Country,
				    pro_area AS Pro_Area,
				    pro_segment_key AS Pro_Segment_Key,
				    pro_segment AS Pro_Segment,
				    pro_category_key AS Pro_Category_Key,
				    pro_category AS Pro_Category,
				    pro_subcategory_key AS Pro_Subcategory_Key,
				    pro_subcategory AS Pro_Subcategory,
				    sbt_relevant AS Sbt_Relevant,
				    co2e AS Co2e,
				    co2e_baseline_year AS Co2e_Baseline_Year,
				    is_target AS Is_Target,
				    co2e_previous_year AS Co2e_Previous_Year,
				    fiscal_date AS Fiscal_Date,
				    valid_from AS Valid_From,
				    valid_to AS Valid_To,
				    is_preliminary AS Is_Preliminary
				FROM generaldiscovery_intfc_sustainability_r.sus_skpic_corp_ghg_dmt_scope3_intfc_view
				WHERE is_preliminary = FALSE"
				    , null, [EnableFolding=true])
				in
				    Source
