	measure '_Emission Reporting Year' =
			
			VAR _Year = SELECTEDVALUE('CORP_GHG DTbl_Scope3'[Year])
			VAR _YearText = FORMAT(_Year, "0")
			
			RETURN
			CALCULATE(
			    SUM('CORP_GHG DTbl_Scope3'[CO2e]),
			
			    KEEPFILTERS('CORP_GHG DTbl_Scope3'[Is Target Filter] = 0),
			    KEEPFILTERS('CORP_GHG DTbl_Scope3'[SBT_Relevant] = TRUE()),
			    KEEPFILTERS('CORP_GHG DTbl_Scope3'[Reporting Year Label/Filter] = _YearText),
			    KEEPFILTERS (
			               'CORP_GHG DTbl_Scope3'[Reporting Year Label/Filter] <> BLANK()
			) )
		lineageTag: a4b7eb00-8288-414a-b69e-9b39fcda239c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_1Emission reorting year' =
			
			VAR _ReportingYearNum =
			 VALUE ( [Reporting Year (Text) scope3] )
			RETURN
			CALCULATE (
			    SUM ( 'CORP_GHG DTbl_Scope3'[CO2e] ),
			    FILTER (
			        ALL ( 'CORP_GHG DTbl_Scope3' ),
			        'CORP_GHG DTbl_Scope3'[Is Target Filter] = 0
			            && 'CORP_GHG DTbl_Scope3'[SBT_Relevant] = TRUE()
			            && 'CORP_GHG DTbl_Scope3'[Year] = _ReportingYearNum-1
			    )
			)
			/*VAR _ReportingYearNum =
			    VALUE ( [Reporting Year (Text)] )
			RETURN
			CALCULATE (
			    SUM ( 'CORP_GHG DTbl_Scope1&2'[Value] ),
			    FILTER (
			        ALL ( 'CORP_GHG DTbl_Scope1&2' ),
			        'CORP_GHG DTbl_Scope1&2'[Is Target Filter] = 0
			            && 'CORP_GHG DTbl_Scope1&2'[Scope] = "Scope 1+2"
			            && 'CORP_GHG DTbl_Scope1&2'[Year] = _ReportingYearNum-1
			    )
			)*/
		lineageTag: 06f7e99b-2382-4e20-bbbb-e7a56620c633

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Reporting Year (Text) scope3' =
			
			VAR _Today = TODAY()
			VAR _CurrentYear = YEAR(_Today)
			VAR _ConditionDate =
			    ( ( DAY(_Today) >= 29 && MONTH(_Today) = 1 )
			        || MONTH(_Today) > 1 )
			
			RETURN
			MAXX (
			    FILTER (
			        ALL ( 'CORP_GHG DTbl_Scope3' ),
			        (
			            _ConditionDate
			                && 'CORP_GHG DTbl_Scope3'[Year] + 1 = _CurrentYear
			                && 'CORP_GHG DTbl_Scope3'[Is_Target] = FALSE ()
			        )
			        ||
			        'CORP_GHG DTbl_Scope3'[Year] = _CurrentYear-1
			    ),
			    FORMAT ( 'CORP_GHG DTbl_Scope3'[Year], "0" )
			)
		lineageTag: b974f055-03dd-479e-98b5-1f0c0be2916c

