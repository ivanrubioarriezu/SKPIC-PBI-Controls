	column 'Reporting Year Label/Filter' = ```
			
			/*VAR _currentYear   = YEAR ( TODAY() )
			VAR _isJanOrLater  = ( MONTH ( TODAY() ) = 1 && DAY ( TODAY() ) >= 29 ) || ( MONTH ( TODAY() ) > 1 )
			VAR _targetYear    = IF ( _isJanOrLater, _currentYear - 1, _currentYear - 2 )
			RETURN
			IF (
			    'CORP_GHG DTbl_Scope3'[Year] = _targetYear,
			    FORMAT ('CORP_GHG DTbl_Scope3'[Year], "0" ),   -- STR(...) equivalent (text output)
			    BLANK()
			)*/
			
			
			
			VAR _currentYear  = YEAR ( TODAY() )
			VAR _isJanOrLater = ( MONTH ( TODAY() ) = 1 && DAY ( TODAY() ) >= 29 ) || ( MONTH ( TODAY() ) > 1 )
			
			VAR _condYMinus1 =
			    _isJanOrLater
			    && ( 'CORP_GHG DTbl_Scope3'[Fiscal_Date].[Year] + 1 = _currentYear )
			    && ( 'CORP_GHG DTbl_Scope3'[Is_Target] = FALSE() || 'CORP_GHG DTbl_Scope3'[Is_Target] =FALSE() )
			
			VAR _condYMinus2 =
			    'CORP_GHG DTbl_Scope3'[Fiscal_Date].[Year] = _currentYear - 2
			
			RETURN
			IF (
			    _condYMinus1 || _condYMinus2,
			    FORMAT ( 'CORP_GHG DTbl_Scope3'[Fiscal_Date].[Year], "0" ),
			    BLANK())
			
			```
		lineageTag: ec6769a2-ed8e-4ee9-8e85-7fb3c2a10d86
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Is Target Filter' =
			
			IF ( 'CORP_GHG DTbl_Scope3'[Is_Target], 1, 0 )
