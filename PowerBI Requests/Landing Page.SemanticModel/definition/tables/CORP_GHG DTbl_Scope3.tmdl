	measure 'Emission Reporting Year' = ```
			
			
			VAR _yearText =
			    FORMAT ( SELECTEDVALUE ( 'CORP_GHG DTbl_Scope3'[Year] ), "0" )
			RETURN
			CALCULATE (
			    SUM([CO2e]),  -- use the measure directly
			
			    // [Is Target Filter] = 0
			    KEEPFILTERS ( 'CORP_GHG DTbl_Scope3'[Is Target Filter] = 0 ),
			
			    // [SBT_Relevant] = TRUE
			    KEEPFILTERS ( 'CORP_GHG DTbl_Scope3'[SBT_Relevant] = TRUE() ),
			
			    // [Reporting Year Label/Filter] = STR([Year])
			   KEEPFILTERS (
			               'CORP_GHG DTbl_Scope3'[Reporting Year Label/Filter] <> BLANK()
			               && 'CORP_GHG DTbl_Scope3'[Reporting Year Label/Filter] <> ""
			))
			
			
			/*
			VAR _yearText =
			 FORMAT ( SELECTEDVALUE ('CORP_GHG DTbl_Scope1&2'[Year] ), "0" )
			RETURN
			CALCULATE (
			   SUM( [Value]),   -- <- measure, DO NOT wrap with SUM()
			    KEEPFILTERS ( 'CORP_GHG DTbl_Scope1&2'[Scope] = "Scope 1+2" ),
			    KEEPFILTERS ( 'CORP_GHG DTbl_Scope1&2'[Reporting Year Label/Filter]=_yearText),
			    FILTER  ( 'CORP_GHG DTbl_Scope1&2', [Is Target Filter] = 0 ))
			
			    
			    VAR _yearText =
			    FORMAT( SELECTEDVALUE( 'CORP_GHG DTbl_Scope3'[Year] ), "0" )
			VAR _reporting =
			    IF (
			        NOT ISBLANK( _yearText ),
			        CALCULATE (
			            SUM ( 'CORP_GHG DTbl_Scope3'[CO2e] ),
			            REMOVEFILTERS ( 'CORP_GHG DTbl_Scope3' ),
			            KEEPFILTERS ( 'CORP_GHG DTbl_Scope3'[] = "Offsetting" ),
			            KEEPFILTERS (
			                'CORP_GHG DTbl_Scope1&2'[Reporting Year Label/Filter] <> BLANK()
			                && 'CORP_GHG DTbl_Scope1&2'[Reporting Year Label/Filter] <> ""
			            ),
			            KEEPFILTERS ( 'CORP_GHG DTbl_Scope1&2'[Reporting Year Label/Filter] = _yearText ),
			            KEEPFILTERS ( 'CORP_GHG DTbl_Scope1&2'[Is Target Filter] = 0 )
			        )
			    )*/
			
			```
		lineageTag: ceb8778a-4bb2-4a9e-99d0-cc27ca4a5a6b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Baseline Year 2019' = ```
			
			CALCULATE (
			    SUM([CO2e]),  -- your existing measure
			
			    KEEPFILTERS ( 'CORP_GHG DTbl_Scope3'[Is Target Filter] = 0 ),
			    KEEPFILTERS ( 'CORP_GHG DTbl_Scope3'[Baseline Year Filter] = 1 ),
			    KEEPFILTERS ( 'CORP_GHG DTbl_Scope3'[SBT_Relevant] = TRUE() ))
			
			```
		lineageTag: 4968dcba-2457-43de-9536-3c7379f4817e

	measure '_Up- and downstream (Scope 3) %' = ```
			
			VAR _reportingTotal=
			    CALCULATE (
			        [_1Emission reorting year],
			        // remove row grouping by Reporting Year Label so we use the visual total
			        REMOVEFILTERS ( 'CORP_GHG DTbl_Scope3'[Reporting Year Label/Filter] )
			    )
			VAR _baselineTotal =
			    CALCULATE (
			        [Baseline Year 2019],
			        REMOVEFILTERS ( 'CORP_GHG DTbl_Scope3'[Reporting Year Label/Filter] )
			    )
			RETURN
			IF (
			    _baselineTotal = 0 || ISBLANK ( _baselineTotal ),
			    BLANK (),
			    1 - DIVIDE ( _reportingTotal, _baselineTotal )
			)
			
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 2685264a-e332-40b9-9a8f-ad8d41de6c6f

	measure ACT = ```
			
			CALCULATE (
			    SUM ( 'CORP_GHG DTbl_Scope3'[CO2e] ),
			    'CORP_GHG DTbl_Scope3'[Is Target Filter] = 0,
			    'CORP_GHG DTbl_Scope3'[SBT_Relevant] = TRUE(),
			    KEEPFILTERS ('CORP_GHG DTbl_Scope3' [FY (Year Filter)] = 1 )
			)
			
			```
