		formatString: 0
		lineageTag: f6a3d1a9-531b-45bd-b48a-a52a65ac6509

	measure 'ACT Reporting Year CH' = ```
			
			
			/*VAR _labelText =
			    // If [Reporting Year Label] is a column, use SELECTEDVALUE(Column)
			    // If it's a measure, just use the measure name directly.
			    SELECTEDVALUE ( 'CH_UP DMT_Target'[Reporting Year Label] )
			VAR _yearText =
			    FORMAT ( SELECTEDVALUE ( 'CH_UP DMT_Target'[Year] ), "0" )
			    
			RETURN
			IF ( _labelText = _yearText, SUM([Actual_Year]), BLANK () )
			
			
			
			VAR _labelYear = SELECTEDVALUE ('CH_UP DMT_Target' [Reporting Year Label] )  -- measure → numeric year
			VAR _Year=  FORMAT ( SELECTEDVALUE ( 'CH_UP DMT_Target'[Year] ), "0" )
			RETURN
			IF (
			    NOT ISBLANK ( _labelYear ),
			    CALCULATE (
			        SUM ( 'CH_UP DMT_Target'[Actual_Year] ),   -- aggregate the COLUMN
			        TREATAS ( { _labelYear }, 'CH_UP DMT_Target'[Year])
			    ),
			    BLANK ()
			)
			
			
			
			VAR _labelText = SELECTEDVALUE ( 'CH_UP DMT_Target'[Reporting Year Label] )
			VAR _yearText  = FORMAT ( SELECTEDVALUE ( 'CH_UP DMT_Target'[Year] ), "0" )
			RETURN
			IF (
			    NOT ISBLANK ( _labelText ) && _labelText = _yearText,
			    SUM ( 'CH_UP DMT_Target'[Actual_Year] ),
			    BLANK ()
			)*/
			
			
			
			VAR _labelFromContext =
			    MAXX (
			        FILTER (
			            VALUES ( 'CH_UP DMT_Target'[Reporting Year Label] ),
			            NOT ISBLANK ( 'CH_UP DMT_Target'[Reporting Year Label] )
			        ),
			        'CH_UP DMT_Target'[Reporting Year Label]
			    )
			VAR _yearFromLabel =
			    VAR _v = VALUE ( _labelFromContext )  -- "2024" -> 2024; returns BLANK() for non-numeric/blank
			    RETURN IF ( ISBLANK ( _v ), BLANK (), _v )
			RETURN
			IF (
			    NOT ISBLANK ( _yearFromLabel ),
			    CALCULATE (
			        SUM ( 'CH_UP DMT_Target'[ActualYear] ),
			
			        -- Guard against (Blank) labels interfering
			        KEEPFILTERS (
			            FILTER (
			                ALL ( 'CH_UP DMT_Target'[Reporting Year Label] ),
			                NOT ISBLANK ( 'CH_UP DMT_Target'[Reporting Year Label] )
			            )
			        ),
			
			        -- Apply virtual filter: Year = parsed label
			        TREATAS ( { _yearFromLabel }, 'CH_UP DMT_Target'[Year] )
			    )
			)
			
			
			
			
			
			
			
			
			
			
			
			
			
			```
		lineageTag: be1997c7-5a7f-48e1-b440-2f9c1ef73b00

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ACT Reporting Year (By Country)' = ```
			
			VAR _labelText =
			    SELECTEDVALUE ( 'CH_UP DMT_Target'[Reporting Year Label] )   -- text like "2024"
			VAR _yearText  =
			    FORMAT ( SELECTEDVALUE ( 'CH_UP DMT_Target'[Year] ), "0" )   -- STR([Year]) equivalent
			VAR _country   =
			    SELECTEDVALUE ( 'CH_UP DMT_Target'[Country] )                -- current Country in context
			RETURN
			IF (
			    NOT ISBLANK ( _labelText )
			        && _labelText = _yearText
			        && NOT ISBLANK ( _country ),
			    CALCULATE (
			        SUM ( 'CH_UP DMT_Target'[ActualYear] ),
			        KEEPFILTERS ( 'CH_UP DMT_Target'[Country] = _country )
			    ),
			       BLANK ())
			
			```
		lineageTag: 1606c274-9373-46d4-8999-288c57d0cb23

		annotation PBI_FormatHint = {"isGeneralNumber":true}

