	column Country = ```
			
			
			VAR _geo = TRIM ( 'CH_UP DMT_Target'[GeographicalLocation] )
			RETURN
			IF (
			    _geo = "India",
			    "ACT Reach India",
			       IF (
			        _geo = "World" || _geo = "World excl. India",
			        "ACT Reach Excl. India",
			        BLANK()    // or "Other"
			    ))
			
			```
		lineageTag: 4b0047ab-6e40-47df-945c-3a8081e1161f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Reporting Year Label' =
			
			VAR _currentYear   = YEAR ( TODAY() )
			VAR _isFebOrLater  = ( MONTH ( TODAY() ) = 2 && DAY ( TODAY() ) >= 1 ) || ( MONTH ( TODAY() ) > 2 )
			VAR _targetYear    = IF ( _isFebOrLater, _currentYear - 1, _currentYear - 2 )
			RETURN
			IF (
			    'CH_UP DMT_Target'[Year] = _targetYear,
			    FORMAT ( 'CH_UP DMT_Target'[Year], "0" ),   -- STR(...) equivalent (text output)
			    BLANK()
			)
		lineageTag: 4cac46b5-86df-4816-9729-4a3e2cb340eb
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'FY (Year Filter) CH' =
			
			
			VAR _fy    = 'CH_UP DMT_Target'[Year]
			VAR _today = TODAY()
			VAR _year  = YEAR(_today)
			VAR _month = MONTH(_today)
			VAR _isFebOrLater =
			    (_month = 2 && DAY(_today) >= 1) || (_month > 2)   // Feb 1 or later
			RETURN
			IF (
			       _fy < _year - 1
			        || ( _isFebOrLater && _fy + 1 = _year ),
			    1,
			    BLANK()
			)
		formatString: 0
		lineageTag: b6a14f5c-5d6c-47b0-a6d8-e3db29d5570f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

