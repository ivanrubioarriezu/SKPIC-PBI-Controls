	column 'FY (Year Filter)' = ```
			
			/*VAR _fy= 'CS_SHF DMTbl_FarmerActual_Target_Timeline_Detail'[Fiscal_Year]
			VAR _today = TODAY()
			VAR _year  = YEAR(_today)
			VAR _month = MONTH(_today)
			VAR _isFebOrLater =
			    (_month = 2 && DAY(_today) >= 1) || (_month > 2)     // Feb 1 or later
			RETURN
			IF (
			    _fy < _year - 1
			        || ( _isFebOrLater && _fy + 1 = _year ),
			    1,
			    BLANK())*/
			
			
			VAR _fy    = 'CS_SHF DMTbl_FarmerActual_Target_Timeline_Detail'[Fiscal_Year]
			VAR _today = TODAY()
			VAR _year  = YEAR(_today)
			VAR _month = MONTH(_today)
			VAR _isFebOrLater =
			    (_month = 2 && DAY(_today) >= 1) || (_month > 2)   // Feb 1 or later
			RETURN
			IF (
			       _fy < _year - 1
			        || ( _isFebOrLater && _fy + 1 = _year ),
			    1,
			    BLANK()
			)
			
			
			
			
			
			```
		formatString: 0
		lineageTag: 35bdad46-2ab7-437c-bdb3-755bab291760
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Actual YTD' = ```
			
			/*IF (
			    SELECTEDVALUE ( 'CS_SHF DMTbl_FarmerActual_Target_Timeline_Detail'[FY (Year Filter)] ) = 1,
			    [Farmer_Actual],
			    BLANK()
			)*/
			IF (
			    [FY (Year Filter)],
