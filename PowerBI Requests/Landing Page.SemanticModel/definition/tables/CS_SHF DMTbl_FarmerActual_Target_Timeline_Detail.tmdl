	measure 'ACT Reporting Year' = ```
			
			CALCULATE (
			    SUM ( 'CS_SHF DMTbl_FarmerActual_Target_Timeline_Detail'[Farmer_Actual] ),
			    KEEPFILTERS (
			        FILTER (
			            'CS_SHF DMTbl_FarmerActual_Target_Timeline_Detail',
			            'CS_SHF DMTbl_FarmerActual_Target_Timeline_Detail'[Reporting Year Label]
			                = FORMAT ( 'CS_SHF DMTbl_FarmerActual_Target_Timeline_Detail'[Fiscal_Year], "0" )
			        )
			    )
			)
			
			```
