	column '_Reporting Year Label' = ```
			
			VAR CurrYear  = YEAR ( TODAY() )
			VAR CurrMonth = MONTH ( TODAY() )
			VAR FY = 'CS_SHF DMTbl_FarmerActual_Target_Timeline_Detail'[Fiscal_Year]    // numeric
			VAR IsMatchFebToDec = CurrMonth >= 2 && ( FY + 1 ) = CurrYear
			VAR IsMatchJanuary = CurrMonth = 1 && FY = CurrYear - 2
			RETURN
			IF (
			    IsMatchFebToDec || IsMatchJanuary,
			    FORMAT ( FY, "0" ),
			    BLANK ()
			)
			
			```
		lineageTag: 366938b4-e67b-4da8-b0a2-05bf41906d33
