	column 'Reporting Year Label' = ```
			
			VAR CurrYear  = YEAR ( TODAY() )
			VAR CurrMonth = MONTH ( TODAY() )
			VAR FY        = 'CS_SHF DMTbl_FarmerActual_Target_Timeline_Detail'[Fiscal_Year]  -- numeric column (e.g., 2019, 2020, 2021)
			RETURN
			IF (
			    -- Feb–Dec: pick FY where FY + 1 = current calendar year
			    ( CurrMonth >= 2 && FY + 1 = CurrYear )
			    ||
			    -- January: pick FY where FY = current year - 2
			    ( CurrMonth = 1 && FY = CurrYear - 2 ),
			    FORMAT ( FY, "0" ),
			    BLANK()
			)
			
			```
		lineageTag: 5334e06d-4db4-4f39-ad1b-e93a0a8a0b16
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

