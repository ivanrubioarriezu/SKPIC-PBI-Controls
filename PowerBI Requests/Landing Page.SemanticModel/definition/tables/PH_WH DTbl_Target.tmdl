	column 'FY (Year Filter)' =
			
			
			VAR _fy    = 'PH_WH DTbl_Target'[Year]
			VAR _today = TODAY()
			VAR _year  = YEAR(_today)
			VAR _month = MONTH(_today)
			VAR _isFebOrLater =
			    (_month = 2 && DAY(_today) >= 1) || (_month > 2)   // Feb 1 or later
			RETURN
			IF (
			       _fy < _year - 1
			        || ( _isFebOrLater && _fy + 1 = _year ),
			    1,
			    BLANK()
			)
		formatString: 0
		lineageTag: a9d9dd51-19ce-45cc-a123-6d31b26dd21e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

