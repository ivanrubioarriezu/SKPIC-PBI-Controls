	measure '_ACT Reporting Year' = ```
			
			/*VAR _labelText  = SELECTEDVALUE ( 'PH_WH DTbl_Target'[Reporting Year Label] )  -- e.g., "2024"
			VAR _targetYear = VALUE ( _labelText )                                         -- convert text → number
			RETURN
			IF (
			    NOT ISBLANK ( _targetYear ),
			    CALCULATE (
			        SUM([User_YtD]),                                                           -- use your existing YTD measure
			        KEEPFILTERS (
			            TREATAS ( { _targetYear }, 'PH_WH DTbl_Target'[Year] )             -- apply virtual filter: Year = target
			        )
			    ),
			    BLANK ())*/
			 
			
			
			VAR _labelTextFromAxisOrContext =
			    -- Pick the label from the current context (e.g., the bar/category) and ignore (Blank)
			    MAXX (
			        FILTER (
			            VALUES ( 'PH_WH DTbl_Target'[Reporting Year Label] ),
			            NOT ISBLANK ( 'PH_WH DTbl_Target'[Reporting Year Label] )
			        ),
			        'PH_WH DTbl_Target'[Reporting Year Label]
			    )
			
			VAR _yearFromLabel =
			    VAR _v = VALUE ( _labelTextFromAxisOrContext )  -- "2024" -> 2024; returns BLANK() if non-numeric/blank
			    RETURN IF ( ISBLANK ( _v ), BLANK (), _v )
			
			-- Fallback: when no single label is present in context (e.g., totals or no slicer),
			-- choose the latest Year that has non-blank [User_YtD] and a non-blank label.
			VAR _fallbackYearWithData =
			    MAXX (
			        FILTER (
			            ALLSELECTED ( 'PH_WH DTbl_Target' ),
			            NOT ISBLANK ( 'PH_WH DTbl_Target'[Reporting Year Label] ) &&
			            NOT ISBLANK ( [User_YtD] )
			        ),
			        'PH_WH DTbl_Target'[Year]
			    )
			
			VAR _targetYear = COALESCE ( _yearFromLabel, _fallbackYearWithData )
			
			RETURN
			IF (
			    NOT ISBLANK ( _targetYear ),
			    CALCULATE (
			        SUM([User_YtD]),  -- keep this as a MEASURE; if it's a column, use SUM('YourTable'[User_YtD])
			
			        -- Guard against (Blank) labels interfering
			        KEEPFILTERS (
			            FILTER (
			                ALL ( 'PH_WH DTbl_Target'[Reporting Year Label] ),
			                NOT ISBLANK ( 'PH_WH DTbl_Target'[Reporting Year Label] )
			            )
			        ),
			
			        -- Apply the virtual filter: Year = targetYear
			        TREATAS ( { _targetYear }, 'PH_WH DTbl_Target'[Year] )
			    ),
			       BLANK ())
			
			
			
			
			```
		lineageTag: a434bea1-aa4b-44c1-a483-a06987dcffdd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

