				    #"Changed Type" = Table.TransformColumnTypes(#"Expanded value.changeCounts",{{"count", Int64.Type}, {"value.commitId", type text}, {"value.author.name", type text}, {"value.author.email", type text}, {"value.author.date", type datetime}, {"value.committer.name", type text}, {"value.committer.email", type text}, {"value.committer.date", type datetime}, {"value.comment", type text}, {"value.changeCounts.Add", Int64.Type}, {"value.changeCounts.Edit", Int64.Type}, {"value.changeCounts.Delete", Int64.Type}, {"value.url", type text}, {"value.remoteUrl", type text}}),
				    #"Invoked Custom Function" = Table.AddColumn(#"Changed Type", "fnCommitChanges", each fnCommitChanges([value.commitId])),
				    #"Expanded fnCommitChanges" = Table.ExpandRecordColumn(#"Invoked Custom Function", "fnCommitChanges", {"changeCounts", "changes"}, {"fnCommitChanges.changeCounts", "fnCommitChanges.changes"}),
				    #"Expanded fnCommitChanges.changeCounts" = Table.ExpandRecordColumn(#"Expanded fnCommitChanges", "fnCommitChanges.changeCounts", {"Delete", "Edit", "Add"}, {"fnCommitChanges.changeCounts.Delete", "fnCommitChanges.changeCounts.Edit", "fnCommitChanges.changeCounts.Add"}),
				    #"Expanded fnCommitChanges.changes" = Table.ExpandListColumn(#"Expanded fnCommitChanges.changeCounts", "fnCommitChanges.changes"),
				    #"Expanded fnCommitChanges.changes1" = Table.ExpandRecordColumn(#"Expanded fnCommitChanges.changes", "fnCommitChanges.changes", {"item", "changeType"}, {"fnCommitChanges.changes.item", "fnCommitChanges.changes.changeType"}),
				    #"Expanded fnCommitChanges.changes.item" = Table.ExpandRecordColumn(#"Expanded fnCommitChanges.changes1", "fnCommitChanges.changes.item", {"objectId", "originalObjectId", "gitObjectType", "commitId", "path", "isFolder", "url"}, {"fnCommitChanges.changes.item.objectId", "fnCommitChanges.changes.item.originalObjectId", "fnCommitChanges.changes.item.gitObjectType", "fnCommitChanges.changes.item.commitId", "fnCommitChanges.changes.item.path", "fnCommitChanges.changes.item.isFolder", "fnCommitChanges.changes.item.url"}),
				    #"Filtered Rows" = Table.SelectRows(#"Expanded fnCommitChanges.changes.item", each Text.StartsWith([fnCommitChanges.changes.item.path], "/PowerBI Requests")),
				    #"Added Custom" = Table.AddColumn(#"Filtered Rows", "FileName", each Text.AfterDelimiter(
